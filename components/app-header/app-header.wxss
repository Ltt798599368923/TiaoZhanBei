:host {
  display: block;
}

.app-header {
  height: 112rpx;
  padding: env(safe-area-inset-top) 24rpx 0;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #c0190e;
  color: #ffffff;
}

.header-title {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 112rpx;
  letter-spacing: 0;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-action,
.header-spacer {
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
}

.header-action {
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  margin-top: -4rpx;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}
