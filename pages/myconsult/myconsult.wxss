.page {
  min-height: 100vh;
  background-color: #f6f6f6;
  padding-bottom: 20rpx;
}

.consult-list {
  padding: 20rpx;
}

.consult-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.consult-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  border-radius: 8rpx 0 0 8rpx;
}

.consult-card.pending::before {
  background: #faad14;
}

.consult-card.replied::before {
  background: #52c41a;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.card-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.status-pending {
  background: #fff7e6;
  color: #d48806;
}

.status-replied {
  background: #f6ffed;
  color: #389e0d;
}

.card-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 24rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-label {
  color: #999;
  font-size: 26rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.card-time {
  font-size: 24rpx;
  color: #bbb;
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.btn-detail {
  font-size: 24rpx;
  color: #1677ff;
  background: #f0f5ff;
  border: none;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
}

.btn-delete {
  font-size: 24rpx;
  color: #ff4d4f;
  background: #fff1f0;
  border: none;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
}

.loading-wrap {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-wrap {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #ccc;
}