.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  background: #f4f5f7;
  box-sizing: border-box;
}

.page-heading {
  padding: 4rpx 4rpx 24rpx;
}

.heading-title,
.heading-copy {
  display: block;
}

.heading-title {
  color: #202124;
  font-size: 40rpx;
  font-weight: 700;
}

.heading-copy {
  margin-top: 10rpx;
  color: #747b85;
  font-size: 26rpx;
}

.consult-section {
  margin-top: 4rpx;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 16rpx;
  color: #282c31;
  font-size: 30rpx;
  font-weight: 600;
}

.section-count {
  color: #878d96;
  font-size: 24rpx;
  font-weight: 400;
}

.consult-list {
  overflow: hidden;
  border: 1rpx solid #e1e4e8;
  border-radius: 8rpx;
  background: #ffffff;
}

.consult-card {
  background: #ffffff;
  padding: 26rpx 26rpx 26rpx 32rpx;
  border-bottom: 1rpx solid #eceef0;
  position: relative;
  box-sizing: border-box;
}

.consult-card:last-child {
  border-bottom: 0;
}

.consult-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
}

.consult-card.pending::before {
  background: #faad14;
}

.consult-card.replied::before {
  background: #52c41a;
}

.consult-card.cancelled::before {
  background: #b8bec6;
}

.consult-card.declined::before {
  background: #9299a3;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-title-wrap {
  min-width: 0;
  flex: 1;
  margin-right: 16rpx;
}

.booking-lawyer {
  display: block;
  margin-top: 8rpx;
  color: #a61d18;
  font-size: 23rpx;
}

.card-status {
  font-size: 23rpx;
  padding: 6rpx 12rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.status-pending {
  background: #fff7e6;
  color: #d48806;
}

.status-replied {
  background: #f6ffed;
  color: #389e0d;
}

.card-content {
  font-size: 26rpx;
  color: #5d646d;
  line-height: 1.7;
  margin-bottom: 22rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-label {
  color: #858b93;
  font-size: 24rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #eceef0;
}

.card-time {
  font-size: 24rpx;
  color: #9298a1;
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.btn-detail {
  margin: 0;
  min-width: 0;
  height: 56rpx;
  padding: 0 18rpx;
  line-height: 54rpx;
  font-size: 24rpx;
  color: #a61d18;
  background: #fff3f1;
  border: 1rpx solid #efc5c0;
  border-radius: 5rpx;
}

.btn-delete {
  margin: 0;
  min-width: 0;
  height: 56rpx;
  padding: 0 18rpx;
  line-height: 54rpx;
  font-size: 24rpx;
  color: #747b85;
  background: #ffffff;
  border: 1rpx solid #d9dde2;
  border-radius: 5rpx;
}

.btn-detail::after,
.btn-delete::after {
  border: 0;
}

.btn-detail,
.btn-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  text-align: center;
  box-sizing: border-box;
}

.loading-wrap {
  margin-top: 4rpx;
  border: 1rpx solid #e1e4e8;
  border-radius: 8rpx;
  background: #ffffff;
  text-align: center;
  padding: 84rpx 28rpx;
  color: #858b94;
  font-size: 27rpx;
}

.empty-wrap {
  margin-top: 4rpx;
  padding: 96rpx 40rpx;
  border: 1rpx solid #e1e4e8;
  border-radius: 8rpx;
  background: #ffffff;
  text-align: center;
}

.empty-icon {
  display: none;
}

.empty-text {
  font-size: 30rpx;
  color: #535a63;
  margin-bottom: 10rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #9298a1;
}
