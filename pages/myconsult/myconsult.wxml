<view class="page">
  <view class="page-heading">
    <text class="heading-title">我的咨询</text>
    <text class="heading-copy">查看平台咨询会话与律师预约进度</text>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">加载中...</view>

  <view wx:elif="{{consults.length > 0}}" class="consult-section">
    <view class="section-heading">
      <text>全部记录</text>
      <text class="section-count">{{consults.length}} 条</text>
    </view>
    <view class="consult-list">
    <view wx:for="{{consults}}" wx:key="id" class="consult-card {{item.statusClass}} {{item.isBooking ? 'booking-card' : ''}}">
      <view class="card-header">
        <view class="card-title-wrap">
          <text class="card-title">{{item.title}}</text>
          <text wx:if="{{item.isBooking}}" class="booking-lawyer">预约 {{item.lawyerName || '律师'}}</text>
        </view>
        <text class="card-status {{item.reply ? 'status-replied' : 'status-pending'}}">{{item.statusText}}</text>
      </view>
      <text class="card-content">
        <text class="card-label">咨询内容：</text>{{item.content || '暂无内容'}}
      </text>
      <view class="card-footer">
        <text class="card-time">{{item.displayTime}}</text>
        <view class="card-actions">
          <button class="btn-detail" data-id="{{item.id}}" bindtap="viewDetail">{{item.isBooking ? '查看进度' : '查看会话'}}</button>
          <button wx:if="{{item.canCancel}}" class="btn-delete" data-id="{{item.id}}" bindtap="deleteConsult">取消预约</button>
          <button wx:elif="{{!item.isBooking}}" class="btn-delete" data-id="{{item.id}}" bindtap="deleteConsult">删除</button>
        </view>
      </view>
    </view>
    </view>
  </view>

  <view wx:else class="empty-wrap">
    <view class="empty-text">暂无咨询记录</view>
    <view class="empty-sub">您的咨询记录会显示在这里</view>
  </view>
</view>
