<view class="page">
<view wx:if="{{false}}" style="background: linear-gradient(135deg, #f5222d, #ff4d4f); width: 100%; padding: 45rpx 30rpx; display: flex; align-items: center; color: white; font-size: 34rpx; font-weight: bold; box-sizing: border-box;">
    <view bindtap="goBack" style="width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; position: relative; left: 0rpx; top: 14rpx">←</view>
    <text style="flex: 1; text-align: center; padding-right: 60rpx; position: relative; left: 0rpx; top: 22rpx">我的咨询</text>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">加载中...</view>

  <view wx:elif="{{consults.length > 0}}" class="consult-list">
    <view wx:for="{{consults}}" wx:key="id" class="consult-card {{item.reply ? 'replied' : 'pending'}} {{item.lawyerId ? 'booking-card' : ''}}">
      <view class="card-header">
        <view class="card-title-wrap">
          <text class="card-title">{{item.title}}</text>
          <text wx:if="{{item.lawyerId}}" class="booking-lawyer">预约 {{item.lawyerName || '律师'}}</text>
        </view>
        <text class="card-status {{item.reply ? 'status-replied' : 'status-pending'}}">
          {{item.status === 'cancelled' ? '已取消' : (item.status === 'closed' ? (item.lawyerId ? '预约已结束' : '已结束') : (item.reply ? (item.lawyerId ? '已反馈' : '已回复') : (item.status === 'pending' ? (item.lawyerId ? '待确认' : '待回复') : '处理中')))}}
        </text>
      </view>
      <text class="card-content">
        <text class="card-label">咨询内容：</text>{{item.content || '暂无内容'}}
      </text>
      <view class="card-footer">
        <text class="card-time">⏱ {{item.displayTime}}</text>
        <view class="card-actions">
          <button class="btn-detail" data-id="{{item.id}}" bindtap="viewDetail">{{item.lawyerId ? '查看进度' : '查看会话'}}</button>
          <button wx:if="{{item.lawyerId && item.status !== 'closed' && item.status !== 'cancelled'}}" class="btn-delete" data-id="{{item.id}}" bindtap="deleteConsult">取消预约</button>
          <button wx:else class="btn-delete" data-id="{{item.id}}" bindtap="deleteConsult">删除</button>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty-wrap">
    <view class="empty-icon">💬</view>
    <view class="empty-text">暂无咨询记录</view>
    <view class="empty-sub">您的咨询记录会显示在这里</view>
  </view>
</view>
