<view class="container" style="background-color: #f5f5f5; min-height: 100vh; padding-bottom: 80px;">
  <!-- 顶部标题 -->
  <view style="background: linear-gradient(135deg, #f5222d, #ff4d4f); width: 100%; padding: 20px; display: flex; align-items: center; color: white; font-size: 20px; font-weight: bold; box-shadow: 0 4px 12px rgba(245, 34, 45, 0.3);">
    <text style="flex: 1; text-align: center;">我的收藏</text>
  </view>

  <!-- 统计信息 -->
  <view style="background-color: white; margin: 15px; padding: 15px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <text style="font-size: 16px; color: #333; font-weight: 500;">共收藏 <text style="color: #f5222d; font-weight: bold;">3</text> 项内容</text>
  </view>

  <!-- 收藏列表 -->
  <view style="padding: 0 15px;">
    <view bindtap="viewDetail" data-id="1" style="background-color: white; margin-bottom: 12px; border-radius: 12px; padding: 18px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: all 0.3s; display: flex; justify-content: space-between; align-items: center;">
      <view style="flex: 1; margin-right: 15px;">
        <view style="display: flex; align-items: center; margin-bottom: 8px;">
          <view style="width: 8px; height: 8px; border-radius: 50%; background-color: #f5222d; margin-right: 8px;"></view>
          <text style="font-size: 16px; font-weight: 500; color: #333;">婚姻法解读</text>
        </view>
        <text style="font-size: 13px; color: #999; line-height: 1.4;">收藏于 2026-04-20</text>
      </view>
      <view bindtap="removeFavorite" data-id="1" style="font-size: 20px; color: #f5222d; transition: all 0.3s; padding: 5px;">
        ❤
      </view>
    </view>

    <view bindtap="viewDetail" data-id="2" style="background-color: white; margin-bottom: 12px; border-radius: 12px; padding: 18px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: all 0.3s; display: flex; justify-content: space-between; align-items: center;">
      <view style="flex: 1; margin-right: 15px;">
        <view style="display: flex; align-items: center; margin-bottom: 8px;">
          <view style="width: 8px; height: 8px; border-radius: 50%; background-color: #1890ff; margin-right: 8px;"></view>
          <text style="font-size: 16px; font-weight: 500; color: #333;">劳动合同模板</text>
        </view>
        <text style="font-size: 13px; color: #999; line-height: 1.4;">收藏于 2026-04-18</text>
      </view>
      <view bindtap="removeFavorite" data-id="2" style="font-size: 20px; color: #f5222d; transition: all 0.3s; padding: 5px;">
        ❤
      </view>
    </view>

    <view bindtap="viewDetail" data-id="3" style="background-color: white; margin-bottom: 12px; border-radius: 12px; padding: 18px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); transition: all 0.3s; display: flex; justify-content: space-between; align-items: center;">
      <view style="flex: 1; margin-right: 15px;">
        <view style="display: flex; align-items: center; margin-bottom: 8px;">
          <view style="width: 8px; height: 8px; border-radius: 50%; background-color: #52c41a; margin-right: 8px;"></view>
          <text style="font-size: 16px; font-weight: 500; color: #333;">民事诉讼流程</text>
        </view>
        <text style="font-size: 13px; color: #999; line-height: 1.4;">收藏于 2026-04-15</text>
      </view>
      <view bindtap="removeFavorite" data-id="3" style="font-size: 20px; color: #f5222d; transition: all 0.3s; padding: 5px;">
        ❤
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view style="display: none; padding: 80px 20px; text-align: center; margin-top: 30px;">
    <view style="font-size: 80px; margin-bottom: 24px;">📂</view>
    <text style="font-size: 18px; color: #999; margin-bottom: 12px; display: block;">暂无收藏内容</text>
    <text style="font-size: 14px; color: #ccc; line-height: 1.5; max-width: 80%; margin: 0 auto;">您收藏的法律知识、模板和工具会显示在这里</text>
    <button style="margin-top: 30px; background-color: #f5222d; color: white; border: none; padding: 12px 24px; border-radius: 24px; font-size: 16px;">去浏览内容</button>
  </view>
</view>