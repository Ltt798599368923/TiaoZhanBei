  border-top: 1rpx solid rgba(255, 220, 100, 0.5);
  padding-top: 16rpx;
  margin-top: 8rpx;
}

/* 底部完整书名样式（替代轻触换书位置） */
.book-fulltitle {
  text-align: center;
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 20rpx;
  letter-spacing: 2rpx;
  background: rgba(0, 0, 0, 0.25);
  display: inline-block;
  width: auto;
  padding: 8rpx 24rpx;
  border-radius: 40rpx;
  backdrop-filter: blur(10rpx);
  align-self: center;
}