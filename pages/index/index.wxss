/* index.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  background-color: #f5222d;
  width: 100%;
  padding: 20px;
  text-align: center;
  color: white;
}

.quick-entry {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20px;
}

.quick-entry view {
  width: 50px;
  height: 50px;
  background-color: #f5222d;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 5px;
}

.quick-entry text {
  font-size: 12px;
}
