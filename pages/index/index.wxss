/* index.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* ===== 顶部头部区域 ===== */
.header {
  width: 100%;
  background: linear-gradient(180deg, #f5222d 0%, #d40000 100%);
  padding: 20rpx 30rpx 40rpx;
  position: relative;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-location {
  display: flex;
  align-items: center;
}

.location-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.location-text {
  color: #ffffff;
  font-size: 24rpx;
}

.header-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
}

.header-actions {
  display: flex;
  align-items: center;
}

.icon-more {
  color: #ffffff;
  font-size: 26rpx;
  margin-right: 20rpx;
}

.icon-setting {
  color: #ffffff;
  font-size: 28rpx;
}

/* 书籍容器 */
.book-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 20rpx;
}

.book {
  width: 150rpx;
  height: 200rpx;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
  position: relative;
}

.book-left {
  background-color: #c40000;
  transform: rotate(-8deg);
  margin-right: -15rpx;
  z-index: 1;
}

.book-right {
  background-color: #d40000;
  transform: rotate(3deg);
  z-index: 2;
}

.book-text {
  color: #ffd700;
  font-size: 22rpx;
  font-weight: bold;
  writing-mode: vertical-rl;
  text-orientation: upright;
  letter-spacing: 2rpx;
  text-align: center;
}

.book-spine {
  position: absolute;
  left: -10rpx;
  top: 0;
  bottom: 0;
  width: 10rpx;
  background-color: #ffd700;
  border-radius: 4rpx 0 0 4rpx;
}

/* 滚动宣传语 */
.marquee-container {
  overflow: hidden;
  white-space: nowrap;
  padding: 0 20rpx;
  text-align: center;
}

.marquee-text {
  display: inline-block;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1.6;
  transition: opacity 0.3s ease;
}

/* ===== 行动卡片 ===== */
.action-cards {
  width: 90%;
  margin: 30rpx auto 40rpx;
  display: flex;
  justify-content: space-between;
  position: relative;
  z-index: 10;
}

.action-card {
  flex: 1;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.2s;
  margin-top: 20rpx;
}

.action-card:active {
  transform: scale(0.96);
}

.action-card-consult {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  margin-right: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 77, 79, 0.35);
}

.action-card-search {
  background: linear-gradient(135deg, #ff7a45 0%, #ffa940 100%);
  margin-left: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 69, 0.35);
}

.action-card-inner {
  display: flex;
  align-items: center;
}

.action-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.action-icon {
  font-size: 40rpx;
}

.action-text-wrapper {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.action-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.action-desc {
  color: #ffffff;
  font-size: 22rpx;
  opacity: 0.85;
}

/* ===== 功能入口网格 ===== */
.feature-grid {
  width: 90%;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 20rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
}

.feature-item {
  width: 28%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 35rpx;
  transition: transform 0.2s;
}

.feature-item:active {
  transform: scale(0.92);
}

.feature-icon {
  width: 110rpx;
  height: 110rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.feature-icon text {
  font-size: 50rpx;
}

.feature-label {
  font-size: 24rpx;
  text-align: center;
  font-weight: 500;
  color: #333333;
}

/* ===== 热点咨询 ===== */
.hot-news {
  width: 90%;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.hot-news-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.hot-news-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.hot-news-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #f5222d;
}

.news-list {
  display: flex;
  flex-direction: column;
}

.news-item {
  background-color: #fef1f1;
  padding: 24rpx 22rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #f5222d;
  transition: transform 0.2s, box-shadow 0.2s;
}

.news-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(245, 34, 45, 0.15);
}

.news-item:last-child {
  margin-bottom: 0;
}

.news-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333333;
}

/* ===== 免责声明 ===== */
.disclaimer {
  width: 90%;
  margin-bottom: 40rpx;
}

.disclaimer text {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
  line-height: 1.8;
}

/* ===== 底部占位 ===== */
.bottom-spacer {
  width: 100%;
  height: 20rpx;
}
