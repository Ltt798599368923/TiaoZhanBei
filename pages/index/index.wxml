<!--index.wxml-->
<!-- 首页页面结构 -->
<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="height: 138rpx; display: flex; box-sizing: border-box">
    <view class="nav-title" style="position: relative; left: 0rpx; top: 47rpx">法律咨询</view>
  </view>
  
  <!-- 顶部红色背景区域 -->
  <view class="header" style="position: relative; left: 0rpx; top: 0rpx; height: 575rpx; display: block; box-sizing: border-box">
    <!-- 头部顶部区域 -->
    <view class="header-top">
      <!-- 页面标题 - 居中对齐 -->
      <view class="header-title">
        <text>法视界</text>
      </view>
    </view>

 <!-- 单本书籍展示 + 两行文字轮播 -->
<view class="book-container-single" style="height: 400rpx; display: flex; box-sizing: border-box; width: 693rpx">
  <view class="book-single" style="position: relative; left: 10rpx; top: 19rpx">
    <!-- 书脊效果 -->
    <view class="book-spine-single" style="position: absolute; left: 1rpx; top: -35rpx; height: 339rpx; display: block; box-sizing: border-box"></view>
    <!-- 书籍封面 -->
    <view class="book-cover-single" style="position: relative; left: 20rpx; top: -35rpx; width: 224rpx; height: 339rpx; display: flex; box-sizing: border-box">
      <!-- 第一行：中华人民共和国（小字） -->
      <text class="book-line1" style="position: relative; left: 2rpx; top: 41rpx">{{currentBook.line1}}</text>
      <!-- 第二行：刑法 / 民法典等（大字） -->
      <text class="book-line2" style="width: 158rpx; height: 106rpx; display: block; box-sizing: border-box; position: relative; left: 1rpx; top: 41rpx">{{currentBook.line2}}</text>
    </view>
    <!-- 底部显示完整书名（替代原来的轻触换书） -->
    
  </view>
</view>

    <!-- 滚动宣传语 -->
    <view class="marquee-container" style="height: 68rpx; display: block; box-sizing: border-box">
      <text class="marquee-text" style="opacity: {{sloganOpacity}}; position: relative; left: 0rpx; top: -39rpx">
        {{slogans[currentSloganIndex]}}
      </text>
    </view>
  </view>

  <!-- 在线咨询和法条检索按钮 -->
  <view class="action-cards">
    <!-- 在线咨询卡片 -->
    <view class="action-card action-card-consult" bindtap="onOnlineConsult" style="width: 306rpx; height: 150rpx; display: flex; box-sizing: border-box">
      <view class="action-card-inner">
        <view class="action-icon-wrapper">
          <text class="action-icon">📞</text>
        </view>
        <view class="action-text-wrapper">
          <text class="action-title">在线咨询</text>
          <text class="action-desc">专业律师在线解答</text>
        </view>
      </view>
    </view>
    <!-- 法条检索卡片 -->
    <view class="action-card action-card-search" bindtap="onLawSearch" style="width: 306rpx; height: 179rpx; display: flex; box-sizing: border-box">
      <view class="action-card-inner">
        <view class="action-icon-wrapper">
          <text class="action-icon">🔍</text>
        </view>
        <view class="action-text-wrapper">
          <text class="action-title">法条检索</text>
          <text class="action-desc">法条信息速查直达</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能入口网格 -->
  <view class="feature-grid">
    <!-- 律师咨询 -->
    <view class="feature-item" bindtap="onFeatureTap" data-type="lawyer">
      <view class="feature-icon">
        <image class="feature-image" src="/images/Lawyer-consultation.png" mode="aspectFit"></image>
      </view>
      <text class="feature-label">律师咨询</text>
    </view>
    <!-- 文书模板 -->
    <view class="feature-item" bindtap="onFeatureTap" data-type="document">
      <view class="feature-icon">
        <image class="feature-image" src="/images/Document-template.png" mode="aspectFit"></image>
      </view>
      <text class="feature-label">文书模板</text>
    </view>
    <!-- 法理白话 -->
    <view class="feature-item" bindtap="onFeatureTap" data-type="lawexplain">
      <view class="feature-icon">
        <image class="feature-image" src="/images/Law-language.png" mode="aspectFit"></image>
      </view>
      <text class="feature-label">法理白话</text>
    </view>
    <!-- 法治新程 -->
    <view class="feature-item" bindtap="onFeatureTap" data-type="newlaw">
      <view class="feature-icon">
        <image class="feature-image" src="/images/Law-travel.png" mode="aspectFit"></image>
      </view>
      <text class="feature-label">法治新程</text>
    </view>
    <!-- 法文阅读 -->
    <view class="feature-item" bindtap="onFeatureTap" data-type="lawread">
      <view class="feature-icon">
        <image class="feature-image" src="/images/Law-reading.png" mode="aspectFit"></image>
      </view>
      <text class="feature-label">法文阅读</text>
    </view>
    <!-- 小视讲堂 -->
    <view class="feature-item" bindtap="onFeatureTap" data-type="video">
      <view class="feature-icon">
        <image class="feature-image" src="/images/Law-lecture.png" mode="aspectFit"></image>
      </view>
      <text class="feature-label">小视讲堂</text>
    </view>
  </view>

  <!-- 热点咨询 -->
  <view class="hot-news">
    <!-- 热点咨询标题 -->
    <view class="hot-news-header">
      <text class="hot-news-icon">🔥</text>
      <text class="hot-news-title">热点咨询</text>
    </view>
    <!-- 新闻列表 -->
    <view class="news-list">
      <view class="news-item" bindtap="onNewsTap" data-index="0">
        <text class="news-text">反外国不当域外管辖条例（4月13日施行）</text>
      </view>
      <view class="news-item" bindtap="onNewsTap" data-index="1">
        <text class="news-text">"机闹"正式入刑（4月9日施行）</text>
      </view>
      <view class="news-item" bindtap="onNewsTap" data-index="2">
        <text class="news-text">全国"4·2行动"严打非法放贷（4月启动）</text>
      </view>
      <view class="news-item" bindtap="onNewsTap" data-index="3">
        <text class="news-text">AI拟人化服务新规（7月15日施行）</text>
      </view>
      <view class="news-item" bindtap="onNewsTap" data-index="4">
        <text class="news-text">贪污贿赂新解释（5月1日施行）</text>
      </view>
      <view class="news-item" bindtap="onNewsTap" data-index="5">
        <text class="news-text">信用修复管理办法（4月1日施行）</text>
      </view>
    </view>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer">
    <text>免责声明：本平台所有内容仅供学习与参考，不构成正式法律意见。具体法律问题请咨询专业律师。</text>
  </view>

  <!-- 底部占位 -->
  <view class="bottom-spacer"></view>
</view>
