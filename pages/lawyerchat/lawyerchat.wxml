<view class="container">
  <view class="consult-entry">
    <text class="entry-title">提交给{{name || '律师'}}的咨询</text>
    <text class="entry-copy">平台暂未开通即时消息。提交后，咨询会保存到“我的咨询”，由后台处理后显示真实回复。</text>
    <textarea class="entry-input" value="{{inputValue}}" placeholder="请简要说明您的法律问题" maxlength="500" bindinput="bindInput" />
    <button class="send-btn" bindtap="sendMessage">继续填写咨询</button>
  </view>
</view>
