<view class="container">
  <view class="header" style="height: 117rpx; display: flex; box-sizing: border-box">
    <view bindtap="goBack" class="back-btn">
      <text>←</text>
    </view>
    <text class="header-title">{{name}}</text>
    <view class="header-right">
      <text>⋯</text>
    </view>
  </view>

  <view class="chat-content">
    <view wx:for="{{messages}}" wx:key="{{item.id}}" class="message-item" style="flex-direction: {{item.type === 'right' ? 'row-reverse' : 'row'}}">
      <view class="avatar {{item.type === 'right' ? 'my-avatar' : 'other-avatar'}}">
        <text>{{item.type === 'right' ? '我' : name.charAt(0)}}</text>
      </view>
      <view class="message-body" style="max-width: 70%; margin-{{item.type === 'right' ? 'left' : 'right'}}: 20rpx;">
        <view class="message-bubble" style="background-color: {{item.type === 'right' ? '#C0190E' : 'white'}}">
          <text style="color: {{item.type === 'right' ? 'white' : '#333'}}">{{item.content}}</text>
        </view>
        <text class="message-time" style="text-align: {{item.type === 'right' ? 'right' : 'left'}}">{{item.time}}</text>
      </view>
    </view>
  </view>

  <view class="input-area">
    <input 
      placeholder="输入消息..." 
      class="input-box"
      bindinput="bindInput"
      value="{{inputValue}}"
    />
    <button class="send-btn" bindtap="sendMessage" style="width: 140rpx; display: flex; box-sizing: border-box; left: 0rpx; top: 0rpx">发送</button>
  </view>
</view>