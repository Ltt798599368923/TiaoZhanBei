<view class="container">
  <view class="conversation-meta">
    <view class="conversation-title-row">
      <text class="conversation-title">{{title}}</text>
      <view class="connection-badge {{connectionState}}"><view class="connection-dot"></view><text>{{connectionLabel}}</text></view>
    </view>
    <text class="conversation-status">平台回复会同步显示在这里</text>
  </view>

  <scroll-view class="message-scroll" scroll-y="true" scroll-top="{{scrollTop}}">
    <view wx:if="{{loadingMessages}}" class="state-panel">正在加载会话记录</view>
    <view wx:elif="{{loadFailed}}" class="state-panel failed-state">
      <text>会话记录加载失败</text>
      <view class="retry-load" role="button" bindtap="retryLoadMessages" hover-class="retry-load-active" hover-stay-time="70">重新加载</view>
    </view>
    <view wx:elif="{{messages.length === 0}}" class="empty-state">
      <text class="empty-title">开始咨询</text>
      <text class="empty-copy">把你的问题、相关时间和已掌握的材料描述清楚，平台顾问会在会话中回复。</text>
    </view>
    <view wx:for="{{messages}}" wx:key="id" class="chat-row {{item.isMine ? 'mine' : 'other'}}">
      <view class="chat-message">
        <text class="chat-sender">{{item.isMine ? '我' : '平台顾问'}}</text>
        <text class="chat-content">{{item.content}}</text>
        <text class="chat-time">{{item.displayTime}}</text>
      </view>
    </view>
    <view wx:if="{{sendError}}" class="send-error">{{sendError}}</view>
  </scroll-view>

  <view class="composer">
    <view class="composer-input-shell">
      <textarea class="composer-input" value="{{inputValue}}" placeholder="输入消息" maxlength="2000" auto-height="true" fixed="true" bindinput="bindInput" />
      <view class="send-button {{sending || !inputValue ? 'is-disabled' : ''}}" role="button" aria-label="发送消息" bindtap="sendMessage" hover-class="send-button-active" hover-stay-time="70"><text class="send-icon">➤</text></view>
    </view>
  </view>
</view>
