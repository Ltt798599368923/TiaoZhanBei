.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f4f5f7;
}

.conversation-meta {
  padding: 22rpx 28rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e7e9ed;
}

.conversation-title {
  display: block;
  overflow: hidden;
  color: #292d33;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conversation-status {
  display: block;
  margin-top: 8rpx;
  color: #8a9099;
  font-size: 22rpx;
}

.conversation-status.online {
  color: #237a4c;
}

.message-scroll {
  flex: 1;
  height: 0;
  padding: 26rpx 24rpx;
  box-sizing: border-box;
}

.chat-row {
  display: flex;
  margin-bottom: 24rpx;
}

.chat-row.mine {
  justify-content: flex-end;
}

.chat-message {
  display: flex;
  flex-direction: column;
  max-width: 76%;
}

.chat-row.mine .chat-message {
  align-items: flex-end;
}

.chat-sender,
.chat-time {
  color: #8c929a;
  font-size: 21rpx;
}

.chat-sender {
  margin-bottom: 7rpx;
}

.chat-time {
  margin-top: 7rpx;
}

.chat-content {
  padding: 18rpx 22rpx;
  border: 1rpx solid #e1e4e8;
  border-radius: 20rpx;
  color: #34383e;
  font-size: 27rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  background: #ffffff;
}

.chat-row.mine .chat-content {
  border-color: #bd1d17;
  color: #ffffff;
  background: #bd1d17;
}

.empty-state {
  margin-top: 80rpx;
  color: #858b94;
  font-size: 27rpx;
  text-align: center;
}

.composer {
  display: block;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e4e6e9;
  box-shadow: 0 -8rpx 24rpx rgba(32, 33, 36, 0.05);
}

.composer-input-shell {
  position: relative;
  width: 100%;
}

.composer-input {
  display: block;
  width: 100%;
  min-height: 80rpx;
  max-height: 180rpx;
  padding: 18rpx 88rpx 18rpx 22rpx;
  border: 1rpx solid #dfe2e6;
  border-radius: 22rpx;
  color: #31353b;
  background: #f3f5f7;
  font-size: 27rpx;
  line-height: 1.4;
  box-sizing: border-box;
}

.send-button {
  position: absolute;
  top: 50%;
  right: 12rpx;
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  border-radius: 50%;
  background: #bd1d17;
  color: #ffffff;
  box-sizing: border-box;
  transform: translateY(-50%);
}

.send-button-active {
  background: #9f1712;
}

.send-button.is-disabled {
  background: #e1e4e8;
  color: #aeb5bc;
}

.send-icon { display: block; font-size: 25rpx; font-weight: 700; line-height: 1; transform: translate(2rpx, -1rpx) rotate(-28deg); }
