.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f5f7fa;
}

.consult-entry {
  margin: 32rpx 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.entry-title,
.entry-copy {
  display: block;
}

.entry-title {
  color: #222222;
  font-size: 32rpx;
  font-weight: 600;
}

.entry-copy {
  margin-top: 16rpx;
  color: #666666;
  font-size: 26rpx;
  line-height: 1.65;
}

.entry-input {
  width: 100%;
  height: 240rpx;
  margin-top: 28rpx;
  padding: 20rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #222222;
  font-size: 28rpx;
}

.send-btn {
  margin-top: 24rpx;
  background-color: #C0190E;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 0 32rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
