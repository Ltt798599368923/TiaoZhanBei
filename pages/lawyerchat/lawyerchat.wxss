.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f4f5f7;
}

.conversation-meta {
  padding: 22rpx 28rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e7e9ed;
}

.conversation-title {
  display: block;
  overflow: hidden;
  color: #292d33;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conversation-status {
  display: block;
  margin-top: 8rpx;
  color: #8a9099;
  font-size: 22rpx;
}

.conversation-status.online {
  color: #237a4c;
}

.message-scroll {
  flex: 1;
  height: 0;
  padding: 26rpx 24rpx;
  box-sizing: border-box;
}

.chat-row {
  display: flex;
  margin-bottom: 24rpx;
}

.chat-row.mine {
  justify-content: flex-end;
}

.chat-message {
  display: flex;
  flex-direction: column;
  max-width: 76%;
}

.chat-row.mine .chat-message {
  align-items: flex-end;
}

.chat-sender,
.chat-time {
  color: #8c929a;
  font-size: 21rpx;
}

.chat-sender {
  margin-bottom: 7rpx;
}

.chat-time {
  margin-top: 7rpx;
}

.chat-content {
  padding: 18rpx 20rpx;
  border: 1rpx solid #e1e4e8;
  border-radius: 8rpx;
  color: #34383e;
  font-size: 27rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  background: #ffffff;
}

.chat-row.mine .chat-content {
  border-color: #bd1d17;
  color: #ffffff;
  background: #bd1d17;
}

.empty-state {
  margin-top: 80rpx;
  color: #858b94;
  font-size: 27rpx;
  text-align: center;
}

.composer {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e4e6e9;
}

.composer-input {
  flex: 1;
  min-height: 72rpx;
  max-height: 180rpx;
  padding: 16rpx;
  border: 1rpx solid #dfe2e6;
  border-radius: 6rpx;
  color: #31353b;
  font-size: 27rpx;
  line-height: 1.4;
  box-sizing: border-box;
}

.send-button {
  width: 104rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 6rpx;
  background: #bd1d17;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
}

.send-button::after {
  border: 0;
}

.send-button[disabled] {
  background: #d9dcdf;
  color: #ffffff;
}
