<view class="container">
  <view class="page-heading">
    <text class="heading-title">法理白话</text>
    <text class="heading-copy">用易懂的方式了解常见法律知识</text>
  </view>

  <!-- 文章列表区域 -->
  <view class="article-list">
    <view wx:if="{{loading}}" class="state-panel">内容加载中...</view>
    <view wx:elif="{{loadError}}" class="state-panel">{{loadError}}</view>
    <view wx:elif="{{articles.length === 0}}" class="empty-state"><view class="empty-mark">解</view><text>暂未发布普法文章</text><text class="empty-copy">通俗的法律知识会在这里持续更新</text></view>
    <block wx:else>
    <view class="article-item" wx:for="{{articles}}" wx:key="id" bindtap="onArticleTap" data-id="{{item.id}}">
      <!-- 文章内容区域 -->
      <view class="article-content">
        <text class="article-title">{{item.title}}</text>
        <text class="article-summary">{{item.summary}}</text>
      </view>
      <!-- 文章元数据区域 -->
      <view class="article-meta">
        <text class="article-read">{{item.sourceName || '普法内容'}}</text>
        <text class="article-date">{{item.publishedTime || item.createdTime}}</text>
      </view>
    </view>
    </block>
  </view>
</view>
