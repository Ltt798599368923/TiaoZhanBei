<!-- 法理白话页面结构 -->
<view class="container">
<!-- 头部区域 -->
  <view wx:if="{{false}}" class="header" style="background: linear-gradient(135deg, #f5222d, #ff4d4f); width: 100%; padding: 50rpx; box-sizing: border-box; color: white; height: 170rpx; display: block; left: 0rpx; top: 0rpx">
    <view style="display: flex; align-items: center; margin-bottom: 16rpx;">
      <view bindtap="goBack" style="width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0;">←</view>
      <text style="flex: 1; text-align: center; padding-right: 60rpx; font-size: 34rpx; font-weight: bold;">法理白话</text>
    </view>
    <text style="display: block; text-align: center; font-size: 24rpx; opacity: 0.8;">专业法律知识通俗解读</text>
  </view>

  <!-- 文章列表区域 -->
  <view class="article-list">
    <view wx:if="{{loading}}" class="empty-state">内容加载中...</view>
    <view wx:elif="{{loadError}}" class="empty-state">{{loadError}}</view>
    <view wx:elif="{{articles.length === 0}}" class="empty-state">暂无已发布的普法文章</view>
    <block wx:else>
    <view class="article-item" wx:for="{{articles}}" wx:key="id" bindtap="onArticleTap" data-id="{{item.id}}">
      <!-- 文章内容区域 -->
      <view class="article-content">
        <text class="article-title">{{item.title}}</text>
        <text class="article-summary">{{item.summary}}</text>
      </view>
      <!-- 文章元数据区域 -->
      <view class="article-meta">
        <text class="article-read">{{item.sourceName || '普法内容'}}</text>
        <text class="article-date">{{item.publishedTime || item.createdTime}}</text>
      </view>
    </view>
    </block>
  </view>
</view>
