<!-- 法理白话页面结构 -->
<view class="container">
  <!-- 头部区域 -->
  <view class="header" style="position: relative; left: -7rpx; top: 0rpx; width: 748rpx; height: 217rpx; display: block; box-sizing: border-box">
    <view class="back-btn" bindtap="goBack" style="position: absolute; left: 29rpx; top: 126rpx">←</view>
    <text class="header-title" style="position: relative; left: -29rpx; top: 61rpx">法理白话</text>
    <text class="header-subtitle" style="position: relative; left: -29rpx; top: 66rpx">专业法律知识通俗解读</text>
  </view>

  <!-- 文章列表区域 -->
  <view class="article-list">
    <!-- 文章项 - 循环渲染文章列表 -->
    <view class="article-item" wx:for="{{articles}}" wx:key="id" bindtap="onArticleTap" data-id="{{item.id}}">
      <!-- 文章内容区域 -->
      <view class="article-content">
        <text class="article-title">{{item.title}}</text>
        <text class="article-summary">{{item.summary}}</text>
      </view>
      <!-- 文章元数据区域 -->
      <view class="article-meta">
        <text class="article-read">👁 {{item.readCount}}</text>
        <text class="article-date">{{item.date}}</text>
      </view>
    </view>
  </view>
</view>
