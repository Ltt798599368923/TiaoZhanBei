.container{min-height:100vh;padding:28rpx 24rpx 48rpx;background:#f4f5f7;box-sizing:border-box}.page-heading{padding:4rpx 4rpx 24rpx}.heading-title,.heading-copy{display:block}.heading-title{color:#202124;font-size:40rpx;font-weight:700}.heading-copy{margin-top:10rpx;color:#747b85;font-size:26rpx}.article-list{overflow:hidden;border:1rpx solid #e1e4e8;border-radius:8rpx;background:#fff}.article-item{padding:24rpx;border-bottom:1rpx solid #eceef0}.article-item:last-child{border:0}.article-item:active{background:#fff7f6}.article-title,.article-summary{display:block}.article-title{color:#30343a;font-size:30rpx;font-weight:700;line-height:1.45}.article-summary{margin-top:12rpx;color:#707780;font-size:25rpx;line-height:1.65}.article-meta{display:flex;justify-content:space-between;margin-top:16rpx;color:#949aa2;font-size:22rpx}.empty-state{padding:60rpx 24rpx;color:#858b93;font-size:26rpx;text-align:center}
