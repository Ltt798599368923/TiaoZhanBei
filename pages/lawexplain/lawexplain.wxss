.container { min-height: 100vh; padding: 24rpx 24rpx 48rpx; background: #f2f4f6; box-sizing: border-box; }
.page-heading { padding: 32rpx 28rpx 38rpx; color: #ffffff; background: #272b31; border-bottom: 5rpx solid #bd1d17; border-radius: 8rpx; }.heading-title, .heading-copy { display: block; }.heading-title { color: #ffffff; font-size: 40rpx; font-weight: 700; }.heading-copy { margin-top: 10rpx; color: #c7cbd0; font-size: 25rpx; }
.article-list { overflow: hidden; margin-top: 28rpx; background: #ffffff; border: 1rpx solid #e1e4e8; border-radius: 8rpx; }.article-item { padding: 25rpx 24rpx 24rpx; border-bottom: 1rpx solid #eceef0; border-left: 5rpx solid transparent; }.article-item:last-child { border-bottom: 0; }.article-item:active { border-left-color: #bd1d17; background: #fafafa; }.article-title, .article-summary { display: block; }.article-title { color: #30343a; font-size: 30rpx; font-weight: 700; line-height: 1.45; }.article-summary { margin-top: 12rpx; color: #707780; font-size: 25rpx; line-height: 1.65; }.article-meta { display: flex; justify-content: space-between; margin-top: 16rpx; color: #949aa2; font-size: 22rpx; }
.empty-state, .state-panel { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 360rpx; padding: 40rpx; color: #535a63; font-size: 29rpx; text-align: center; box-sizing: border-box; }.empty-mark { display: flex; width: 90rpx; height: 90rpx; align-items: center; justify-content: center; margin-bottom: 24rpx; color: #a61d18; background: #fff1f0; border: 1rpx solid #efc5c0; font-size: 40rpx; font-weight: 700; }.empty-copy { margin-top: 12rpx; color: #9298a1; font-size: 24rpx; }.state-panel { min-height: 250rpx; color: #858b93; font-size: 27rpx; }
