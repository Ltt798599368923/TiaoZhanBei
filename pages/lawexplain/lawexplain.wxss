.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  background: linear-gradient(180deg, #ffa940 0%, #ffc53d 100%);
  padding: 40rpx 30rpx;
  text-align: center;
}

.header-title {
  display: block;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
}

.header-subtitle {
  display: block;
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  margin-top: 10rpx;
}

.article-list {
  padding: 20rpx;
}

.article-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
}

.article-content {
  margin-bottom: 16rpx;
}

.article-title {
  display: block;
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.article-summary {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

.article-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.article-read {
  font-size: 24rpx;
  color: #999999;
}

.article-date {
  font-size: 24rpx;
  color: #999999;
}
