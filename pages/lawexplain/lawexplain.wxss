/**
 * 法理白话页面样式
 */

/* 全局容器样式 */
.container {
  min-height: 100vh;          /* 最小高度为屏幕高度 */
  background-color: #f5f5f5;  /* 背景色为浅灰色 */
}

/* 头部区域样式 */
.header {
  background: linear-gradient(180deg, #ffa940 0%, #ffc53d 100%);  /* 渐变背景 */
  padding: 40rpx 30rpx;        /* 内边距 */
  text-align: center;          /* 文本居中 */
  position: relative;         /* 相对定位 */
  min-height: 120rpx;         /* 最小高度 */
}

/* 返回按钮 */
.back-btn {
  position: absolute;
  left: 0rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  color: #ffffff;
  cursor: pointer;
  z-index: 10;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 头部标题样式 */
.header-title {
  display: block;              /* 块级元素 */
  color: #ffffff;              /* 文字颜色为白色 */
  font-size: 40rpx;            /* 字体大小 */
  font-weight: bold;           /* 字体加粗 */
}

/* 头部副标题样式 */
.header-subtitle {
  display: block;              /* 块级元素 */
  color: rgba(255, 255, 255, 0.85);  /* 半透明白色文字 */
  font-size: 26rpx;            /* 字体大小 */
  margin-top: 10rpx;           /* 顶部margin */
}

/* 文章列表区域样式 */
.article-list {
  padding: 20rpx;              /* 内边距 */
}

/* 文章项样式 */
.article-item {
  background-color: #ffffff;    /* 背景色为白色 */
  border-radius: 16rpx;         /* 圆角 */
  padding: 28rpx 24rpx;         /* 内边距 */
  margin-bottom: 16rpx;         /* 底部margin */
  display: flex;                /* 使用flex布局 */
  flex-direction: column;       /* 垂直方向排列 */
}

/* 文章内容区域样式 */
.article-content {
  margin-bottom: 16rpx;         /* 底部margin */
}

/* 文章标题样式 */
.article-title {
  display: block;              /* 块级元素 */
  font-size: 32rpx;            /* 字体大小 */
  color: #333333;              /* 文字颜色 */
  font-weight: bold;           /* 字体加粗 */
  margin-bottom: 10rpx;         /* 底部margin */
}

/* 文章摘要样式 */
.article-summary {
  display: block;              /* 块级元素 */
  font-size: 26rpx;            /* 字体大小 */
  color: #666666;              /* 文字颜色 */
  line-height: 1.5;            /* 行高 */
}

/* 文章元数据区域样式 */
.article-meta {
  display: flex;                /* 使用flex布局 */
  justify-content: space-between;  /* 两端对齐 */
  align-items: center;          /* 垂直居中 */
}

/* 文章阅读量样式 */
.article-read {
  font-size: 24rpx;            /* 字体大小 */
  color: #999999;              /* 文字颜色 */
}

/* 文章日期样式 */
.article-date {
  font-size: 24rpx;            /* 字体大小 */
  color: #999999;              /* 文字颜色 */
}
