<view class="container" style="background-color: #f5f7fa; min-height: 100vh; padding: 0; margin: 0;">
<view wx:if="{{false}}" style="background: linear-gradient(135deg, #f5222d, #ff4d4f); width: 100%; padding: 45rpx 30rpx; display: flex; align-items: center; color: white; font-size: 34rpx; font-weight: bold; box-sizing: border-box;">
    <view bindtap="goBack" style="width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0;">
      <text style="font-size: 36rpx; position: relative; left: 45rpx; top: 24rpx">&#8592;</text>
    </view>
    <text style="flex: 1; text-align: center; padding-right: 60rpx; position: relative; left: 0rpx; top: 22rpx">个人设置</text>
  </view>

  <view style="background-color: white; padding: 20px; border-bottom: 1px solid #f0f0f0; display: flex; align-items: center; width: 100%; box-sizing: border-box;">
    <image wx:if="{{userInfo.avatar}}" src="{{userInfo.avatar}}" style="width: 60px; height: 60px; border-radius: 50%; margin-right: 15px;" mode="aspectFill" />
    <view wx:else style="width: 60px; height: 60px; border-radius: 50%; margin-right: 15px; background: #fff1f0; color: #c0190e; display: flex; align-items: center; justify-content: center; font-size: 32rpx;">{{avatarInitial}}</view>
    <view style="flex: 1;">
      <text style="font-size: 16px; font-weight: bold; color: #333; display: block;">{{userInfo.nickname || '用户'}}</text>
      <text style="font-size: 12px; color: #999;">{{userInfo.phone || '未绑定手机号'}}</text>
    </view>
    <button bindtap="editProfile" style="margin: 0; padding: 0 24rpx; height: 56rpx; line-height: 56rpx; color: #c0190e; background: #fff1f0; border-radius: 12rpx; font-size: 24rpx;">编辑</button>
  </view>

  <view wx:if="{{editingProfile}}" style="background: #ffffff; margin-top: 16rpx; padding: 28rpx 32rpx; box-sizing: border-box;">
    <text style="display: block; color: #222; font-size: 30rpx; font-weight: 600;">编辑资料</text>
    <input value="{{nickname}}" placeholder="昵称" maxlength="30" bindinput="onNicknameInput" style="margin-top: 24rpx; height: 76rpx; padding: 0 20rpx; border: 1rpx solid #d9d9d9; border-radius: 12rpx; font-size: 28rpx;" />
    <input value="{{phone}}" placeholder="手机号（可选）" type="number" maxlength="11" bindinput="onPhoneInput" style="margin-top: 16rpx; height: 76rpx; padding: 0 20rpx; border: 1rpx solid #d9d9d9; border-radius: 12rpx; font-size: 28rpx;" />
    <view style="display: flex; margin-top: 24rpx; gap: 16rpx;">
      <button bindtap="cancelEditProfile" style="flex: 1; margin: 0; color: #595959; background: #f5f5f5; border-radius: 12rpx; font-size: 28rpx;">取消</button>
      <button bindtap="saveProfile" loading="{{savingProfile}}" disabled="{{savingProfile}}" style="flex: 1; margin: 0; color: #ffffff; background: #c0190e; border-radius: 12rpx; font-size: 28rpx;">保存</button>
    </view>
  </view>

  <view style="background-color: white; margin-top: 10px;">
    <view bindtap="navigateTo" data-url="/pages/myconsult/myconsult" style="padding: 15px 20px; border-bottom: 1px solid #f0f0f0; display: flex; align-items: center;">
      <text style="font-size: 20px; margin-right: 10px;">&#x1F4AC;</text>
      <text style="flex: 1; font-size: 14px; color: #333;">我的咨询</text>
      <text style="color: #ccc;">&gt;</text>
    </view>
    <view bindtap="navigateTo" data-url="/pages/favorite/favorite" style="padding: 15px 20px; border-bottom: 1px solid #f0f0f0; display: flex; align-items: center;">
      <text style="font-size: 20px; margin-right: 10px;">&#x2B50;</text>
      <text style="flex: 1; font-size: 14px; color: #333;">我的收藏</text>
      <text style="color: #ccc;">&gt;</text>
    </view>
    <view bindtap="navigateTo" data-url="/pages/contract/contract" style="padding: 15px 20px; border-bottom: 1px solid #f0f0f0; display: flex; align-items: center;">
      <text style="font-size: 20px; margin-right: 10px;">&#x1F4C4;</text>
      <text style="flex: 1; font-size: 14px; color: #333;">合同审查记录</text>
      <text style="color: #ccc;">&gt;</text>
    </view>
    <view bindtap="navigateTo" data-url="/pages/about/about" style="padding: 15px 20px; display: flex; align-items: center;">
      <text style="font-size: 20px; margin-right: 10px;">&#x2139;</text>
      <text style="flex: 1; font-size: 14px; color: #333;">关于我们</text>
      <text style="color: #ccc;">&gt;</text>
    </view>
  </view>

  <view style="background-color: white; margin-top: 10px; padding: 15px 20px; display: flex; align-items: center;" bindtap="logout">
    <text style="font-size: 20px; margin-right: 10px;">&#x1F6AA;</text>
    <text style="flex: 1; font-size: 14px; color: #ff4d4f;">退出登录</text>
    <text style="color: #ccc;">&gt;</text>
  </view>
</view>
