<view class="page"><view class="lead"><text class="kicker">个人账户</text><text class="title">个人设置</text></view><view class="profile"><image wx:if="{{userInfo.avatar}}" src="{{userInfo.avatar}}" class="avatar" mode="aspectFill"/><view wx:else class="avatar fallback">我</view><view class="profile-copy"><text class="name">{{userInfo.nickname || '用户'}}</text><text class="phone">{{userInfo.phone || '未绑定手机号'}}</text></view><button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">换头像</button></view><view class="panel"><view class="row" bindtap="editProfile"><text>资料编辑</text><text class="action">编辑</text></view><view class="row"><text>接收系统通知</text><switch checked="{{notificationEnabled}}" color="#bd1d17" bindchange="toggleNotification"/></view><view class="row" bindtap="toggleFeedback"><text>意见反馈</text><text class="action">{{feedbackVisible ? '收起' : '填写'}}</text></view><view class="row" bindtap="clearCache"><text>清理本地缓存</text><text class="action">清理</text></view></view><view wx:if="{{editing}}" class="panel form"><input value="{{nickname}}" placeholder="昵称" bindinput="onNicknameInput"/><input value="{{phone}}" type="number" maxlength="11" placeholder="手机号（可选）" bindinput="onPhoneInput"/><view class="form-actions"><button bindtap="cancelEdit" class="secondary">取消</button><button bindtap="saveProfile" loading="{{saving}}" class="primary">保存</button></view></view><view wx:if="{{feedbackVisible}}" class="panel form"><textarea value="{{feedbackContent}}" maxlength="2000" placeholder="请描述你遇到的问题或改进建议" bindinput="onFeedbackInput"/><button bindtap="submitFeedback" class="primary">提交反馈</button><view wx:for="{{feedbacks}}" wx:key="id" class="feedback"><text>{{item.status === 'resolved' ? '已回复' : item.status === 'processing' ? '处理中' : '待处理'}} · {{item.createdTime}}</text><text>{{item.content}}</text><text wx:if="{{item.reply}}" class="reply">回复：{{item.reply}}</text></view></view><button class="logout" bindtap="logout">退出登录</button></view>
