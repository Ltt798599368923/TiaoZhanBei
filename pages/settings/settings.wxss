.page{min-height:100vh;padding:24rpx;background:#f4f5f7;box-sizing:border-box}.lead,.profile,.panel{background:#fff;border:1rpx solid #e1e4e8;border-radius:8rpx}.lead{padding:30rpx;border-left:8rpx solid #bd1d17}.kicker,.title,.name,.phone,.feedback text{display:block}.kicker,.action{color:#a61d18;font-size:23rpx}.title{margin-top:8rpx;color:#202124;font-size:38rpx;font-weight:700}.profile{display:flex;align-items:center;gap:20rpx;margin-top:24rpx;padding:24rpx}.avatar{width:88rpx;height:88rpx;border-radius:50%;background:#fff1f0}.fallback{display:flex;align-items:center;justify-content:center;color:#a61d18;font-size:32rpx}.profile-copy{flex:1;min-width:0}.name{font-size:30rpx;font-weight:700;color:#30343a}.phone{margin-top:8rpx;font-size:23rpx;color:#777e87}.avatar-button,.primary,.secondary,.logout{display:flex;align-items:center;justify-content:center;height:68rpx;padding:0;border-radius:6rpx;font-size:24rpx;line-height:1;text-align:center;box-sizing:border-box}.avatar-button,.secondary{color:#a61d18;background:#fff1f0}.panel{margin-top:20rpx;overflow:hidden}.row{display:flex;align-items:center;justify-content:space-between;min-height:96rpx;padding:0 24rpx;border-bottom:1rpx solid #eceef0;color:#30343a;font-size:28rpx}.row:last-child{border:0}.form{padding:24rpx;box-sizing:border-box}.form input,.form textarea{width:100%;margin-bottom:16rpx;padding:18rpx;border:1rpx solid #dfe2e6;border-radius:6rpx;box-sizing:border-box;font-size:27rpx}.form textarea{height:180rpx}.form-actions{display:flex;gap:16rpx}.form-actions button{flex:1}.primary{color:#fff;background:#bd1d17}.feedback{padding:20rpx 0;border-top:1rpx solid #eceef0;color:#626972;font-size:23rpx;line-height:1.6}.reply{color:#30343a}.logout{width:100%;margin-top:28rpx;color:#bd1d17;background:#fff;border:1rpx solid #d99790}
