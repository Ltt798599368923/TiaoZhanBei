<view class="container">
  <view class="page-heading">
    <text class="heading-title">小视讲堂</text>
    <text class="heading-copy">通过视频了解常见法律知识</text>
  </view>

  <view class="video-section">
    <view class="section-heading">
      <text>已发布内容</text>
      <text wx:if="{{videos.length}}" class="section-count">{{videos.length}} 条</text>
    </view>
    <view wx:if="{{loading}}" class="state-panel">内容加载中...</view>
    <view wx:elif="{{loadError}}" class="state-panel">{{loadError}}</view>
    <view wx:elif="{{videos.length === 0}}" class="empty-state"><view class="empty-mark">视</view><text>暂未发布视频内容</text><text class="empty-copy">法律知识视频会在这里持续更新</text></view>
    <view wx:else class="video-list">
      <view class="video-item" wx:for="{{videos}}" wx:key="id" bindtap="onVideoTap" data-id="{{item.id}}">
        <view class="video-mark"><text>视</text></view>
        <view class="video-info">
        <text class="video-title">{{item.title}}</text>
        <view class="video-meta">
          <text class="video-author">{{item.sourceName || '视频内容'}}</text>
          <text class="video-time">{{item.publishedTime || item.createdTime}}</text>
        </view>
        </view>
        <text class="video-action">查看</text>
      </view>
    </view>
  </view>
</view>
