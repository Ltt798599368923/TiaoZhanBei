.container {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  background: #f4f5f7;
  box-sizing: border-box;
}

.page-heading { padding: 4rpx 4rpx 24rpx; }
.heading-title, .heading-copy { display: block; }
.heading-title { color: #202124; font-size: 40rpx; font-weight: 700; }
.heading-copy { margin-top: 10rpx; color: #747b85; font-size: 26rpx; }

.video-section { margin-top: 4rpx; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; padding: 0 4rpx 16rpx; color: #282c31; font-size: 30rpx; font-weight: 600; }
.section-count { color: #878d96; font-size: 24rpx; font-weight: 400; }

.video-list {
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #e1e4e8;
  border-radius: 8rpx;
}

.video-item {
  display: flex;
  align-items: center;
  min-height: 126rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #eceef0;
  box-sizing: border-box;
}

.video-item:last-child { border-bottom: 0; }
.video-item:active { background: #fafafa; }

.video-mark {
  display: flex;
  flex: 0 0 74rpx;
  width: 74rpx;
  height: 74rpx;
  align-items: center;
  justify-content: center;
  color: #a61d18;
  background: #fff1f0;
  border: 1rpx solid #efc5c0;
  border-radius: 6rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.video-info { flex: 1; min-width: 0; margin-left: 18rpx; }
.video-title { display: block; overflow: hidden; color: #30343a; font-size: 29rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.video-meta { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-top: 10rpx; }
.video-author, .video-time { overflow: hidden; color: #858b93; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.video-time { flex: 0 0 auto; color: #9298a1; }
.video-action { margin-left: 16rpx; color: #a61d18; font-size: 25rpx; font-weight: 600; }

.empty-state {
  padding: 96rpx 28rpx;
  color: #858b94;
  background: #ffffff;
  border: 1rpx solid #e1e4e8;
  border-radius: 8rpx;
  font-size: 27rpx;
  text-align: center;
}
