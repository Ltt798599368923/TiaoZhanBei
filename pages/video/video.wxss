.container { min-height: 100vh; padding: 24rpx 24rpx 48rpx; background: #f2f4f6; box-sizing: border-box; }
.page-heading { padding: 32rpx 28rpx 38rpx; color: #ffffff; background: #272b31; border-bottom: 5rpx solid #bd1d17; border-radius: 8rpx; }.heading-title, .heading-copy { display: block; }.heading-title { color: #ffffff; font-size: 40rpx; font-weight: 700; }.heading-copy { margin-top: 10rpx; color: #c7cbd0; font-size: 25rpx; }
.video-section { margin-top: 28rpx; }.section-heading { display: flex; align-items: baseline; justify-content: space-between; padding: 0 4rpx 16rpx; color: #30343a; font-size: 29rpx; font-weight: 700; }.section-count { color: #a61d18; font-size: 23rpx; font-weight: 600; }
.video-list { overflow: hidden; background: #ffffff; border: 1rpx solid #e1e4e8; border-radius: 8rpx; }.video-item { display: flex; align-items: center; min-height: 128rpx; padding: 22rpx 24rpx; border-bottom: 1rpx solid #eceef0; box-sizing: border-box; }.video-item:last-child { border-bottom: 0; }.video-item:active { background: #fafafa; }.video-mark { display: flex; flex: 0 0 74rpx; width: 74rpx; height: 74rpx; align-items: center; justify-content: center; color: #ffffff; background: #272b31; border-left: 5rpx solid #bd1d17; font-size: 29rpx; font-weight: 600; }.video-info { flex: 1; min-width: 0; margin-left: 18rpx; }.video-title { display: block; overflow: hidden; color: #30343a; font-size: 29rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }.video-meta { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-top: 10rpx; }.video-author, .video-time { overflow: hidden; color: #858b93; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }.video-time { flex: 0 0 auto; color: #9298a1; }.video-action { margin-left: 16rpx; color: #a61d18; font-size: 25rpx; font-weight: 700; }
.empty-state, .state-panel { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 360rpx; padding: 40rpx; color: #535a63; font-size: 29rpx; text-align: center; box-sizing: border-box; }.empty-mark { display: flex; width: 90rpx; height: 90rpx; align-items: center; justify-content: center; margin-bottom: 24rpx; color: #a61d18; background: #fff1f0; border: 1rpx solid #efc5c0; font-size: 40rpx; font-weight: 700; }.empty-copy { margin-top: 12rpx; color: #9298a1; font-size: 24rpx; }.state-panel { min-height: 250rpx; color: #858b93; font-size: 27rpx; }
