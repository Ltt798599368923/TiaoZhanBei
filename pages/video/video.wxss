.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  background: linear-gradient(180deg, #9254de 0%, #b37feb 100%);
  padding: 40rpx 30rpx;
  text-align: center;
}

.header-title {
  display: block;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
}

.header-subtitle {
  display: block;
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  margin-top: 10rpx;
}

.video-list {
  padding: 20rpx;
}

.video-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.video-thumbnail {
  width: 100%;
  height: 350rpx;
  background: linear-gradient(180deg, #9254de 0%, #722ed1 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.video-play {
  font-size: 80rpx;
  color: #ffffff;
  opacity: 0.9;
}

.video-duration {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 22rpx;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
}

.video-info {
  padding: 24rpx;
}

.video-title {
  display: block;
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.video-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.video-author {
  font-size: 24rpx;
  color: #9254de;
}

.video-views {
  font-size: 24rpx;
  color: #999999;
}
