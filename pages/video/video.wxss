/**
 * 小视讲堂页面样式
 */

/* 全局容器样式 */
.container {
  min-height: 100vh;          /* 最小高度为屏幕高度 */
  background-color: #f5f5f5;  /* 背景色为浅灰色 */
}

/* 头部区域样式 */
.header {
  background: linear-gradient(180deg, #9254de 0%, #b37feb 100%);  /* 渐变背景 */
  padding: 40rpx 30rpx;        /* 内边距 */
  text-align: center;          /* 文本居中 */
}

/* 头部标题样式 */
.header-title {
  display: block;              /* 块级元素 */
  color: #ffffff;              /* 文字颜色为白色 */
  font-size: 40rpx;            /* 字体大小 */
  font-weight: bold;           /* 字体加粗 */
}

/* 头部副标题样式 */
.header-subtitle {
  display: block;              /* 块级元素 */
  color: rgba(255, 255, 255, 0.85);  /* 半透明白色文字 */
  font-size: 26rpx;            /* 字体大小 */
  margin-top: 10rpx;           /* 顶部margin */
}

/* 视频列表区域样式 */
.video-list {
  padding: 20rpx;              /* 内边距 */
}

/* 视频项样式 */
.video-item {
  background-color: #ffffff;    /* 背景色为白色 */
  border-radius: 16rpx;         /* 圆角 */
  overflow: hidden;             /* 超出部分隐藏 */
  margin-bottom: 16rpx;         /* 底部margin */
}

/* 视频缩略图样式 */
.video-thumbnail {
  width: 100%;                 /* 宽度100% */
  height: 350rpx;              /* 高度 */
  background: linear-gradient(180deg, #9254de 0%, #722ed1 100%);  /* 渐变背景 */
  display: flex;                /* 使用flex布局 */
  align-items: center;          /* 垂直居中 */
  justify-content: center;      /* 水平居中 */
  position: relative;           /* 相对定位 */
}

/* 播放按钮样式 */
.video-play {
  font-size: 80rpx;             /* 字体大小 */
  color: #ffffff;              /* 文字颜色为白色 */
  opacity: 0.9;                 /* 透明度 */
}

/* 视频时长样式 */
.video-duration {
  position: absolute;           /* 绝对定位 */
  bottom: 16rpx;                /* 距离底部 */
  right: 16rpx;                 /* 距离右侧 */
  background-color: rgba(0, 0, 0, 0.6);  /* 半透明黑色背景 */
  color: #ffffff;              /* 文字颜色为白色 */
  font-size: 22rpx;            /* 字体大小 */
  padding: 4rpx 10rpx;          /* 内边距 */
  border-radius: 4rpx;          /* 圆角 */
}

/* 视频信息样式 */
.video-info {
  padding: 24rpx;               /* 内边距 */
}

/* 视频标题样式 */
.video-title {
  display: block;              /* 块级元素 */
  font-size: 30rpx;            /* 字体大小 */
  color: #333333;              /* 文字颜色 */
  font-weight: 500;            /* 字体加粗 */
  margin-bottom: 12rpx;         /* 底部margin */
}

/* 视频元数据样式 */
.video-meta {
  display: flex;                /* 使用flex布局 */
  justify-content: space-between;  /* 两端对齐 */
  align-items: center;          /* 垂直居中 */
}

/* 视频作者样式 */
.video-author {
  font-size: 24rpx;            /* 字体大小 */
  color: #9254de;              /* 文字颜色 */
}

/* 视频观看量样式 */
.video-views {
  font-size: 24rpx;            /* 字体大小 */
  color: #999999;              /* 文字颜色 */
}
