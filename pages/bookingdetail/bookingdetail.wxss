.page { min-height: 100vh; padding: 24rpx; background: #f4f5f7; box-sizing: border-box; }.loading { padding-top: 100rpx; color: #737981; font-size: 28rpx; text-align: center; }
.summary, .lawyer-card, .section { border: 1rpx solid #e4e7eb; border-radius: 8rpx; background: #fff; }.summary { padding: 30rpx; border-left: 8rpx solid #bd1d17; }.eyebrow { display: block; color: #a61d18; font-size: 22rpx; font-weight: 600; }.title { display: block; margin-top: 10rpx; color: #202124; font-size: 36rpx; font-weight: 700; line-height: 1.35; }.status-row { display: flex; justify-content: space-between; align-items: center; margin-top: 18rpx; }.status { padding: 6rpx 14rpx; border-radius: 4rpx; color: #9e211b; background: #fff1ef; font-size: 23rpx; }.time { color: #8a9099; font-size: 23rpx; }
.lawyer-card { display: flex; align-items: center; margin-top: 20rpx; padding: 22rpx 26rpx; }.avatar-wrap { width: 78rpx; height: 78rpx; margin-right: 18rpx; overflow: hidden; border-radius: 39rpx; background: #fbe9e7; flex-shrink: 0; }.avatar { width: 100%; height: 100%; }.avatar-fallback { display: block; color: #a61d18; font-size: 33rpx; font-weight: 700; line-height: 78rpx; text-align: center; }.lawyer-name, .lawyer-meta { display: block; }.lawyer-name { color: #292d32; font-size: 29rpx; font-weight: 700; }.lawyer-meta { margin-top: 6rpx; color: #737981; font-size: 23rpx; }
.section { margin-top: 20rpx; padding: 28rpx; }.section-title { display: block; margin-bottom: 16rpx; color: #30343a; font-size: 29rpx; font-weight: 700; }.body, .contact { display: block; color: #626972; font-size: 26rpx; line-height: 1.7; }.contact { margin-top: 16rpx; color: #555d66; }
.timeline { padding-left: 6rpx; }.timeline-item { display: flex; position: relative; padding-bottom: 28rpx; }.timeline-item:last-child { padding-bottom: 0; }.timeline-item:not(:last-child)::before { position: absolute; top: 20rpx; bottom: -2rpx; left: 9rpx; width: 2rpx; background: #e1e4e8; content: ''; }.dot { width: 20rpx; height: 20rpx; margin-top: 8rpx; border-radius: 10rpx; background: #b5bac1; flex-shrink: 0; z-index: 1; }.dot.feedback { background: #bd1d17; }.update-copy { min-width: 0; margin-left: 18rpx; }.update-label, .update-content, .update-time { display: block; }.update-label { color: #34383e; font-size: 27rpx; font-weight: 600; }.update-content { margin-top: 8rpx; color: #626972; font-size: 26rpx; line-height: 1.6; }.update-time { margin-top: 8rpx; color: #969ba3; font-size: 22rpx; }.empty { color: #737981; font-size: 26rpx; }
