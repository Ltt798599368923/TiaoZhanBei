.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  background: linear-gradient(180deg, #40a9ff 0%, #69c0ff 100%);
  padding: 40rpx 30rpx;
  text-align: center;
}

.header-title {
  display: block;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
}

.header-subtitle {
  display: block;
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  margin-top: 10rpx;
}

.book-list {
  padding: 20rpx;
}

.book-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
}

.book-cover {
  width: 120rpx;
  height: 160rpx;
  background: linear-gradient(180deg, #40a9ff 0%, #1890ff 100%);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.book-cover-text {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  text-align: center;
  padding: 10rpx;
}

.book-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.book-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
}

.book-author {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
}

.book-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.book-category {
  font-size: 22rpx;
  color: #40a9ff;
  background-color: #e6f7ff;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.book-read {
  font-size: 22rpx;
  color: #999999;
}

.book-progress {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.progress-bar {
  flex: 1;
  height: 8rpx;
  background-color: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-right: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #40a9ff 0%, #1890ff 100%);
  border-radius: 4rpx;
}

.progress-text {
  font-size: 22rpx;
  color: #999999;
}
