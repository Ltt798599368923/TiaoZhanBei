.container{min-height:100vh;padding:24rpx;background:#f4f5f7;box-sizing:border-box}.book-list{overflow:hidden;border:1rpx solid #e1e4e8;border-radius:8rpx;background:#fff}.book-item{display:flex;gap:20rpx;padding:24rpx;border-bottom:1rpx solid #eceef0}.book-item:last-child{border:0}.book-item:active{background:#fff7f6}.book-cover{display:flex;align-items:center;justify-content:center;width:112rpx;height:148rpx;padding:10rpx;border-left:6rpx solid #bd1d17;border-radius:6rpx;background:#fff1f0;box-sizing:border-box}.book-cover-text{color:#a61d18;font-size:22rpx;font-weight:700;line-height:1.4;text-align:center}.book-info{display:flex;flex:1;min-width:0;flex-direction:column;justify-content:center}.book-title{color:#30343a;font-size:30rpx;font-weight:700;line-height:1.45}.book-author{margin-top:12rpx;color:#737a83;font-size:24rpx}.book-meta{margin-top:16rpx}.book-read{color:#949aa2;font-size:22rpx}.empty-state{padding:60rpx 24rpx;color:#858b93;font-size:26rpx;text-align:center}
