/**
 * 法文阅读页面样式
 */

/* 全局容器样式 */
.container {
  min-height: 100vh;          /* 最小高度为屏幕高度 */
  background-color: #f5f5f5;  /* 背景色为浅灰色 */
}

/* 头部区域样式 */
.header {
  background: linear-gradient(180deg, #DE1E1D  0%, #DE1E1D 100%);  /* 渐变背景 */
  padding: 40rpx 30rpx;        /* 内边距 */
  text-align: center;          /* 文本居中 */
  position: relative;         /* 相对定位 */
  min-height: 120rpx;         /* 最小高度 */
}

/* 返回按钮 */
.back-btn {
  position: absolute;
  left: 0rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  color: #ffffff;
  cursor: pointer;
  z-index: 10;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 头部标题样式 */
.header-title {
  display: block;              /* 块级元素 */
  color: #ffffff;              /* 文字颜色为白色 */
  font-size: 40rpx;            /* 字体大小 */
  font-weight: bold;           /* 字体加粗 */
}

/* 头部副标题样式 */
.header-subtitle {
  display: block;              /* 块级元素 */
  color: rgba(255, 255, 255, 0.85);  /* 半透明白色文字 */
  font-size: 26rpx;            /* 字体大小 */
  margin-top: 10rpx;           /* 顶部margin */
}

/* 书籍列表区域样式 */
.book-list {
  padding: 20rpx;              /* 内边距 */
}

/* 书籍项样式 */
.book-item {
  background-color: #ffffff;    /* 背景色为白色 */
  border-radius: 16rpx;         /* 圆角 */
  padding: 24rpx;               /* 内边距 */
  margin-bottom: 16rpx;         /* 底部margin */
  display: flex;                /* 使用flex布局 */
}

/* 书籍封面样式 */
.book-cover {
  width: 120rpx;               /* 宽度 */
  height: 160rpx;              /* 高度 */
  background: linear-gradient(180deg, #DE1E1D  0%, #DE1E1D  100%);  /* 渐变背景 */
  border-radius: 8rpx;          /* 圆角 */
  display: flex;                /* 使用flex布局 */
  align-items: center;          /* 垂直居中 */
  justify-content: center;      /* 水平居中 */
  margin-right: 24rpx;          /* 右侧margin */
  flex-shrink: 0;               /* 不收缩 */
}

/* 书籍封面文字样式 */
.book-cover-text {
  color: #ffffff;              /* 文字颜色为白色 */
  font-size: 22rpx;            /* 字体大小 */
  font-weight: bold;           /* 字体加粗 */
  text-align: center;          /* 文本居中 */
  padding: 10rpx;              /* 内边距 */
}

/* 书籍信息区域样式 */
.book-info {
  flex: 1;                     /* 占满剩余空间 */
  display: flex;                /* 使用flex布局 */
  flex-direction: column;       /* 垂直方向排列 */
  justify-content: space-between;  /* 两端对齐 */
}

/* 书籍标题样式 */
.book-title {
  font-size: 32rpx;            /* 字体大小 */
  color: #333333;              /* 文字颜色 */
  font-weight: bold;           /* 字体加粗 */
}

/* 书籍作者样式 */
.book-author {
  font-size: 24rpx;            /* 字体大小 */
  color: #999999;              /* 文字颜色 */
  margin-top: 6rpx;            /* 顶部margin */
}

/* 书籍元数据区域样式 */
.book-meta {
  display: flex;                /* 使用flex布局 */
  align-items: center;          /* 垂直居中 */
  margin-top: 10rpx;            /* 顶部margin */
}

/* 书籍分类样式 */
.book-category {
  font-size: 22rpx;            /* 字体大小 */
  color: #DE1E1D ;              /* 文字颜色 */
  background-color: #DE1E1D ;    /* 背景色 */
  padding: 4rpx 10rpx;          /* 内边距 */
  border-radius: 4rpx;          /* 圆角 */
  margin-right: 16rpx;          /* 右侧margin */
}

/* 书籍阅读量样式 */
.book-read {
  font-size: 22rpx;            /* 字体大小 */
  color: #999999;              /* 文字颜色 */
}

/* 书籍进度区域样式 */
.book-progress {
  display: flex;                /* 使用flex布局 */
  align-items: center;          /* 垂直居中 */
  margin-top: 12rpx;            /* 顶部margin */
}

/* 进度条容器样式 */
.progress-bar {
  flex: 1;                     /* 占满剩余空间 */
  height: 8rpx;                /* 高度 */
  background-color: #DE1E1D ;    /* 背景色 */
  border-radius: 4rpx;          /* 圆角 */
  overflow: hidden;             /* 溢出隐藏 */
  margin-right: 12rpx;          /* 右侧margin */
}

/* 进度条填充样式 */
.progress-fill {
  height: 100%;                /* 高度 */
  background: linear-gradient(90deg, #DE1E1D  0%, #DE1E1D  100%);  /* 渐变背景 */
  border-radius: 4rpx;          /* 圆角 */
}

/* 进度文本样式 */
.progress-text {
  font-size: 22rpx;            /* 字体大小 */
  color: #999999;              /* 文字颜色 */
}
