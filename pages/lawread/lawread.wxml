<!-- 法文阅读页面结构 -->
<view class="container">
<!-- 头部区域 -->
  <view wx:if="{{false}}" class="header" style="background: linear-gradient(135deg, #f5222d, #ff4d4f); width: 100%; padding: 50rpx; box-sizing: border-box; color: white; height: 170rpx; display: block; left: 0rpx; top: 0rpx">
    <view style="display: flex; align-items: center; margin-bottom: 16rpx;">
      <view bindtap="goBack" style="width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; position: relative; left: 0rpx; top: 30rpx">←</view>
      <text style="flex: 1; text-align: center; padding-right: 60rpx; font-size: 34rpx; font-weight: bold;">法文阅读</text>
    </view>
    <text style="display: block; text-align: center; font-size: 24rpx; opacity: 0.8; position: relative; left: 0rpx; top: -16rpx">法律法规在线阅读</text>
  </view>

  <!-- 书籍列表区域 -->
  <view class="book-list">
    <view wx:if="{{loading}}" class="empty-state">内容加载中...</view>
    <view wx:elif="{{loadError}}" class="empty-state">{{loadError}}</view>
    <view wx:elif="{{books.length === 0}}" class="empty-state">暂无已发布的法规阅读内容</view>
    <block wx:else>
    <view class="book-item" wx:for="{{books}}" wx:key="id" bindtap="onBookTap" data-id="{{item.id}}">
      <!-- 书籍封面 -->
      <view class="book-cover">
        <text class="book-cover-text">{{item.title}}</text>
      </view>
      <!-- 书籍信息区域 -->
      <view class="book-info">
        <text class="book-title">{{item.title}}</text>
        <text class="book-author">{{item.sourceName || '已发布内容'}}</text>
        <view class="book-meta">
          <text class="book-read">{{item.publishedTime || item.createdTime}}</text>
        </view>
      </view>
    </view>
    </block>
  </view>
</view>
