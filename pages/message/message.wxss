.container {
  display: block;
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  background: #f4f5f7;
  box-sizing: border-box;
}

.page-heading {
  padding: 4rpx 4rpx 24rpx;
}

.heading-title {
  display: block;
  color: #202124;
  font-size: 40rpx;
  font-weight: 700;
}

.heading-copy {
  display: block;
  margin-top: 10rpx;
  color: #747b85;
  font-size: 26rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 78rpx;
  padding: 0 20rpx;
  background: #ffffff;
  border: 1rpx solid #e2e5e9;
  border-radius: 7rpx;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #30343a;
  font-size: 27rpx;
}

.search-clear {
  margin-left: 16rpx;
  color: #a61d18;
  font-size: 24rpx;
}

.message-section {
  margin-top: 28rpx;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 0 4rpx 16rpx;
  color: #282c31;
  font-size: 30rpx;
  font-weight: 600;
}

.section-count {
  color: #878d96;
  font-size: 24rpx;
  font-weight: 400;
}

.message-list {
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #e7e9ed;
  border-radius: 10rpx;
}

.message-item {
  display: flex;
  align-items: center;
  min-height: 138rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #eef0f2;
  box-sizing: border-box;
}

.message-item:last-child {
  border-bottom: 0;
}

.message-item:active {
  background: #fafafa;
}

.message-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 600;
  flex: 0 0 76rpx;
}

.mark-reply {
  background: #fff0ef;
  color: #b51e18;
}

.mark-system {
  background: #eef5ff;
  color: #286bb3;
}

.message-content {
  flex: 1;
  min-width: 0;
}

.message-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.message-kind {
  color: #262a30;
  font-size: 27rpx;
  font-weight: 600;
}

.message-time {
  flex: 0 0 auto;
  color: #9298a1;
  font-size: 22rpx;
}

.message-subject,
.message-preview {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-subject {
  margin-top: 8rpx;
  color: #535a63;
  font-size: 25rpx;
}

.message-preview {
  margin-top: 6rpx;
  color: #858b94;
  font-size: 23rpx;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  white-space: normal;
}

.message-arrow {
  margin-left: 14rpx;
  color: #a2a7ae;
  font-size: 30rpx;
}

.empty-state {
  padding: 96rpx 28rpx;
  background: #ffffff;
  border: 1rpx solid #e7e9ed;
  border-radius: 10rpx;
  color: #858b94;
  font-size: 27rpx;
  text-align: center;
}
