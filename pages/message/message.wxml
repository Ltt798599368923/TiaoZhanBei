<!-- 消息中心页面结构 -->
<view class="container">
  <!-- 顶部标题 -->
  

  <!-- 搜索框 -->
  <view class="search-container" style="position: relative; left: 79rpx; top: 102rpx; width: 908rpx; display: block; box-sizing: border-box">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        placeholder="搜索联系人或消息" 
        placeholder-style="color: #999;" 
        bindinput="onSearchInput"
      />
      <text 
        wx:if="{{searchText}}" 
        class="search-clear" 
        bindtap="clearSearch"
      >✕</text>
    </view>
  </view>

  <!-- 消息列表 -->
  <view class="message-list" style="width: 699rpx; display: block; box-sizing: content-box">
    <!-- 消息分组标题 -->
    

    <!-- 消息项 - 动态渲染 -->
    <view 
      wx:for="{{filteredMessages}}" 
      wx:key="{{item.id}}"
      class="message-item"
      bindtap="goToDetail"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
      data-type="{{item.name === '系统通知' ? 'system' : 'chat'}}"
     style="position: relative; left: -12rpx; top: 90rpx">
      <!-- 头像 -->
      <view class="avatar {{item.name === '系统通知' ? 'avatar-system' : item.id === 1 ? 'avatar-blue' : 'avatar-yellow'}}">
        <text class="avatar-text">{{item.name === '系统通知' ? '📢' : item.id === 1 ? '张' : item.id === 3 ? '李' : item.name.charAt(0)}}</text>
      </view>
      
      <!-- 消息内容 -->
      <view class="message-content">
        <view class="message-header">
          <text class="message-name">{{item.name}}</text>
          <text class="message-time">{{item.time}}</text>
        </view>
        <text class="message-preview">{{item.content}}</text>
      </view>
      
      <!-- 未读标记 -->
      <view wx:if="{{item.unread}}" class="unread-badge"></view>
    </view>

    <!-- 无搜索结果提示 -->
    <view wx:if="{{filteredMessages.length === 0 && searchText}}" class="empty-state">
      未找到相关消息
    </view>
  </view>
</view>