<view class="container">
  <view class="page-heading">
    <text class="heading-title">消息</text>
    <text class="heading-copy">咨询回复与系统通知</text>
  </view>

  <view class="search-box">
    <input class="search-input" value="{{searchText}}" placeholder="搜索消息内容" bindinput="onSearchInput" />
    <text wx:if="{{searchText}}" class="search-clear" bindtap="clearSearch">清空</text>
  </view>

  <view class="message-section">
    <view class="section-heading">
      <text>全部消息</text>
      <text class="section-count">{{filteredMessages.length}} 条</text>
    </view>

    <view wx:if="{{loading}}" class="empty-state">消息加载中...</view>
    <view wx:elif="{{filteredMessages.length === 0 && searchText}}" class="empty-state">未找到相关消息</view>
    <view wx:elif="{{filteredMessages.length === 0}}" class="empty-state">暂无消息</view>
    <view wx:else class="message-list">
      <view wx:for="{{filteredMessages}}" wx:key="id" class="message-item" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="message-mark {{item.type === 'consultReply' ? 'mark-reply' : 'mark-system'}}">
          <text>{{item.type === 'consultReply' ? '答' : '通'}}</text>
        </view>
        <view class="message-content">
          <view class="message-meta">
            <text class="message-kind">{{item.name}}</text>
            <text class="message-time">{{item.time}}</text>
          </view>
          <text class="message-subject">{{item.subject}}</text>
          <text class="message-preview">{{item.content}}</text>
        </view>
        <text class="message-arrow">&gt;</text>
      </view>
    </view>
  </view>
</view>
