.container {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  background: #f4f5f7;
  box-sizing: border-box;
}

.page-heading { padding: 4rpx 4rpx 24rpx; }
.heading-title, .heading-copy, .app-name, .app-version, .section-title, .section-desc, .copyright-text { display: block; }
.heading-title { color: #202124; font-size: 40rpx; font-weight: 700; }
.heading-copy { margin-top: 10rpx; color: #747b85; font-size: 26rpx; }

.product-panel {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #e1e4e8;
  border-left: 8rpx solid #bd1d17;
  border-radius: 8rpx;
}

.product-mark {
  display: flex;
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  color: #a61d18;
  background: #fff1f0;
  border: 1rpx solid #efc5c0;
  border-radius: 50%;
  font-size: 38rpx;
  font-weight: 700;
}

.product-copy { min-width: 0; margin-left: 20rpx; }
.app-name { color: #30343a; font-size: 32rpx; font-weight: 700; }
.app-version { margin-top: 8rpx; color: #858b93; font-size: 24rpx; }

.about-content {
  margin-top: 22rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 1rpx solid #e1e4e8;
  border-radius: 8rpx;
}

.content-section { padding: 26rpx 0; border-bottom: 1rpx solid #eceef0; }
.content-section-last { border-bottom: 0; }
.section-title { color: #30343a; font-size: 29rpx; font-weight: 600; }
.section-desc { margin-top: 14rpx; color: #5d646d; font-size: 26rpx; line-height: 1.7; }
.privacy-note { color: #a61d18; font-size: 24rpx; }
.copyright { margin-top: 34rpx; text-align: center; }
.copyright-text { color: #9298a1; font-size: 23rpx; }
