<!-- about.wxml -->
<!-- 关于我们页面结构 -->
<view class="container">
  <!-- 顶部标题 -->
  <view style="background: linear-gradient(135deg, #f5222d, #ff4d4f); width: 100%; padding: 45rpx 30rpx; display: flex; align-items: center; color: white; font-size: 34rpx; font-weight: bold; box-sizing: border-box;">
    <view bindtap="goBack" style="width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0;">←</view>
    <text style="flex: 1; text-align: center; padding-right: 60rpx;">关于我们</text>
  </view>

  <!-- 内容区域 -->
  <view class="content">
    <!-- 应用图标 -->
    <view class="app-icon">
      <text class="icon">⚖️</text>
    </view>

    <!-- 应用名称 -->
    <text class="app-name">法律咨询</text>
    
    <!-- 版本号 -->
    <text class="app-version">版本 1.0.0</text>

    <!-- 关于内容 -->
    <view class="about-content" style="width: 568rpx; display: block; box-sizing: content-box">
      <view class="content-section">
        <text class="section-title">我们的使命</text>
        <text class="section-desc">为用户提供便捷、专业的法律咨询服务，让法律触手可及。</text>
      </view>

      <view class="content-section">
        <text class="section-title">服务理念</text>
        <text class="section-desc">以用户为中心，以专业为基础，以诚信为原则，为用户提供高质量的法律服务。</text>
      </view>

      <view class="content-section">
        <text class="section-title">联系我们</text>
        <text class="section-desc">客服电话：400-123-4567</text>
        <text class="section-desc">邮箱：contact@legalconsult.com</text>
        <text class="section-desc">地址：北京市朝阳区法律大厦</text>
      </view>
    </view>

    <!-- 底部版权信息 -->
    <view class="copyright">
      <text class="copyright-text">© 2026 法律咨询 版权所有</text>
    </view>
  </view>
</view>