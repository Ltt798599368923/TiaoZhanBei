<!-- about.wxml -->
<!-- 关于我们页面结构 -->
<view class="container" style="width: 742rpx; height: 187rpx; display: flex; box-sizing: border-box">
  <!-- 顶部标题 -->
  <view class="header" style="width: 759rpx; height: 176rpx; display: flex; box-sizing: border-box; left: 7rpx; top: 0rpx; position: relative">
    <view class="back-btn" bindtap="goBack" style="position: absolute; left: 29rpx; top: 110rpx">←</view>
    <text class="header-title" style="position: relative; left: 0rpx; top: 23rpx">关于我们</text>
  </view>

  <!-- 内容区域 -->
  <view class="content" style="width: 532rpx; height: 332rpx; display: flex; box-sizing: border-box">
    <!-- 应用图标 -->
    <view class="app-icon">
      <text class="icon">⚖️</text>
    </view>

    <!-- 应用名称 -->
    <text class="app-name" style="height: 35rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx">法律咨询</text>
    
    <!-- 版本号 -->
    <text class="app-version">版本 1.0.0</text>

    <!-- 关于内容 -->
    <view class="about-content" style="width: 657rpx; display: block; box-sizing: border-box">
      <view class="content-section">
        <text class="section-title">我们的使命</text>
        <text class="section-desc">为用户提供便捷、专业的法律咨询服务，让法律触手可及。</text>
      </view>

      <view class="content-section">
        <text class="section-title">服务理念</text>
        <text class="section-desc">以用户为中心，以专业为基础，以诚信为原则，为用户提供高质量的法律服务。</text>
      </view>

      <view class="content-section">
        <text class="section-title">联系我们</text>
        <text class="section-desc">客服电话：400-123-4567</text>
        <text class="section-desc">邮箱：contact@legalconsult.com</text>
        <text class="section-desc">地址：北京市朝阳区法律大厦</text>
      </view>
    </view>

    <!-- 底部版权信息 -->
    <view class="copyright">
      <text class="copyright-text">© 2026 法律咨询 版权所有</text>
    </view>
  </view>
</view>