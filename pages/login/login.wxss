.login-page { display: flex; flex-direction: column; min-height: 100vh; background: #ffffff; box-sizing: border-box; }
.top-accent { height: 10rpx; background: #d92822; }
.brand-area { display: flex; flex-direction: column; align-items: center; padding: 118rpx 48rpx 0; }
.brand-icon { display: flex; width: 116rpx; height: 116rpx; align-items: center; justify-content: center; color: #ffffff; background: #d92822; border-radius: 30rpx; font-size: 52rpx; font-weight: 700; }
.brand-name, .brand-slogan, .auth-copy, .auth-hint { display: block; }
.brand-name { margin-top: 28rpx; color: #24272c; font-size: 42rpx; font-weight: 700; }.brand-slogan { margin-top: 12rpx; color: #8a919a; font-size: 26rpx; }
.auth-area { padding: 84rpx 56rpx 0; text-align: center; }.auth-copy { color: #737a83; font-size: 25rpx; }.wechat-login-btn { width: 100%; height: 88rpx; margin-top: 34rpx; color: #ffffff; background: #d92822; border: 0; border-radius: 44rpx; font-size: 29rpx; font-weight: 600; line-height: 88rpx; }.wechat-login-btn::after { border: 0; }.wechat-login-btn[disabled] { color: rgba(255,255,255,0.85); background: #e3918e; }.auth-hint { margin-top: 24rpx; color: #a2a7ae; font-size: 22rpx; }
.footer { display: flex; flex-wrap: wrap; justify-content: center; gap: 8rpx; margin-top: auto; padding: 52rpx 24rpx 42rpx; text-align: center; }.footer-text, .footer-link { color: #9aa0a8; font-size: 23rpx; }.footer-link { color: #d92822; }
