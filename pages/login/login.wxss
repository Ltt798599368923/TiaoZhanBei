.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 96rpx 48rpx 64rpx;
  background: #f4f5f7;
  box-sizing: border-box;
}

.brand-block { padding: 26rpx 4rpx 56rpx; }
.brand-mark {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  color: #a61d18;
  background: #fff1f0;
  border: 1rpx solid #efc5c0;
  border-radius: 8rpx;
  font-size: 46rpx;
  font-weight: 700;
}

.title, .subtitle, .panel-title, .panel-copy { display: block; }
.title { margin-top: 30rpx; color: #202124; font-size: 44rpx; font-weight: 700; }
.subtitle { margin-top: 14rpx; color: #747b85; font-size: 27rpx; }

.login-panel {
  padding: 32rpx 28rpx;
  background: #ffffff;
  border: 1rpx solid #e1e4e8;
  border-left: 8rpx solid #bd1d17;
  border-radius: 8rpx;
}

.panel-title { color: #30343a; font-size: 30rpx; font-weight: 600; }
.panel-copy { margin-top: 12rpx; color: #747b85; font-size: 25rpx; line-height: 1.65; }

.wechat-login-btn {
  width: 100%;
  height: 84rpx;
  margin-top: 32rpx;
  color: #ffffff;
  background: #bd1d17;
  border: 0;
  border-radius: 6rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.wechat-login-btn::after { border: 0; }
.wechat-login-btn[disabled] { color: rgba(255, 255, 255, 0.8); background: #c9827e; }

.footer {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8rpx;
  margin-top: auto;
  padding-top: 48rpx;
  text-align: center;
}

.footer-text, .footer-link { color: #858b93; font-size: 23rpx; }
.footer-link { color: #a61d18; }
