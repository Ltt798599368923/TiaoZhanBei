.login-page { display: flex; flex-direction: column; min-height: 100vh; overflow: hidden; background: #ffffff; box-sizing: border-box; }
.brand-area { display: flex; flex-direction: column; align-items: center; min-height: 410rpx; padding: 56rpx 48rpx 58rpx; color: #ffffff; background: #d92822; border-radius: 0 0 64rpx 64rpx; box-sizing: border-box; }
.brand-icon { display: flex; width: 112rpx; height: 112rpx; align-items: center; justify-content: center; color: #d92822; background: #ffffff; border-radius: 32rpx; font-size: 52rpx; font-weight: 700; }
.brand-name, .brand-slogan, .auth-title, .auth-copy { display: block; }
.brand-name { margin-top: 26rpx; color: #ffffff; font-size: 42rpx; font-weight: 700; }.brand-slogan { margin-top: 12rpx; color: rgba(255,255,255,0.86); font-size: 26rpx; }
.auth-area { margin: 0; padding: 56rpx 48rpx 0; text-align: center; }.auth-title { color: #292d32; font-size: 34rpx; font-weight: 700; }.auth-copy { margin-top: 14rpx; color: #9298a1; font-size: 25rpx; }
.wechat-login-btn { width: 100%; height: 88rpx; margin-top: 44rpx; color: #ffffff; background: #d92822; border: 0; border-radius: 44rpx; box-shadow: 0 10rpx 20rpx rgba(217, 40, 34, 0.2); font-size: 29rpx; font-weight: 600; line-height: 88rpx; }.wechat-login-btn::after { border: 0; }.wechat-login-btn[disabled] { color: rgba(255,255,255,0.85); background: #e3918e; box-shadow: none; }
.footer { display: flex; flex-wrap: wrap; justify-content: center; gap: 8rpx; margin-top: auto; padding: 56rpx 24rpx 42rpx; text-align: center; }.footer-text, .footer-link { color: #9aa0a8; font-size: 23rpx; }.footer-link { color: #d92822; }
