.login-page { display: flex; flex-direction: column; min-height: 100vh; background: #d92822; box-sizing: border-box; }
.top-accent { height: 10rpx; background: rgba(255, 255, 255, 0.18); }
.brand-area { display: flex; flex-direction: column; align-items: center; padding: 122rpx 48rpx 0; }
.brand-icon { display: flex; width: 116rpx; height: 116rpx; align-items: center; justify-content: center; color: #d92822; background: #ffffff; border-radius: 30rpx; font-size: 52rpx; font-weight: 700; }
.brand-name, .brand-slogan, .auth-copy, .auth-hint { display: block; }.brand-name { margin-top: 28rpx; color: #ffffff; font-size: 42rpx; font-weight: 700; }.brand-slogan { margin-top: 12rpx; color: rgba(255, 255, 255, 0.82); font-size: 26rpx; }
.auth-area { padding: 88rpx 56rpx 0; text-align: center; }.auth-copy { color: rgba(255, 255, 255, 0.9); font-size: 25rpx; }.wechat-login-btn { width: 100%; height: 88rpx; margin-top: 34rpx; color: #d92822; background: #ffffff; border: 0; border-radius: 44rpx; font-size: 29rpx; font-weight: 700; line-height: 88rpx; }.wechat-login-btn::after { border: 0; }.wechat-login-btn[disabled] { color: #d67975; background: rgba(255,255,255,0.76); }.auth-hint { margin-top: 24rpx; color: rgba(255, 255, 255, 0.66); font-size: 22rpx; }
.footer { display: flex; flex-wrap: wrap; justify-content: center; gap: 8rpx; margin-top: auto; padding: 52rpx 24rpx 42rpx; text-align: center; }.footer-text, .footer-link { color: rgba(255, 255, 255, 0.7); font-size: 23rpx; }.footer-link { color: #ffffff; font-weight: 600; }
