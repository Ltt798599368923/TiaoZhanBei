.container { display: flex; flex-direction: column; min-height: 100vh; background: #f2f4f6; box-sizing: border-box; }
.login-hero { min-height: 356rpx; padding: 48rpx 48rpx 92rpx; color: #ffffff; background: #272b31; box-sizing: border-box; }
.hero-kicker { display: block; color: #e8b8b2; font-size: 20rpx; font-weight: 600; letter-spacing: 3rpx; }
.brand-line { display: flex; align-items: center; margin-top: 26rpx; }
.brand-mark { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; color: #ffffff; background: #bd1d17; font-size: 36rpx; font-weight: 700; }
.brand-rule { width: 84rpx; height: 2rpx; margin-left: 16rpx; background: #bd1d17; }
.title, .subtitle, .panel-eyebrow, .panel-title, .panel-copy { display: block; }
.title { margin-top: 30rpx; color: #ffffff; font-size: 44rpx; font-weight: 700; }
.subtitle { margin-top: 12rpx; color: #c7cbd0; font-size: 27rpx; }

.login-panel { margin: -44rpx 24rpx 0; padding: 34rpx 30rpx 30rpx; background: #ffffff; border-top: 5rpx solid #bd1d17; border-radius: 8rpx; box-shadow: 0 14rpx 32rpx rgba(30, 35, 40, 0.12); }
.panel-eyebrow { color: #a61d18; font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; }
.panel-title { margin-top: 14rpx; color: #272b31; font-size: 31rpx; font-weight: 700; }
.panel-copy { margin-top: 12rpx; color: #747b85; font-size: 25rpx; line-height: 1.7; }
.wechat-login-btn { width: 100%; height: 86rpx; margin-top: 32rpx; color: #ffffff; background: #bd1d17; border: 0; border-radius: 5rpx; font-size: 29rpx; font-weight: 600; line-height: 86rpx; }
.wechat-login-btn::after { border: 0; }
.wechat-login-btn[disabled] { color: rgba(255, 255, 255, 0.8); background: #c9827e; }
.service-note { display: flex; align-items: center; margin-top: 24rpx; color: #858b93; font-size: 22rpx; }
.note-dot { width: 8rpx; height: 8rpx; margin-right: 10rpx; background: #bd1d17; border-radius: 50%; }
.footer { display: flex; flex-wrap: wrap; justify-content: center; gap: 8rpx; margin-top: auto; padding: 48rpx 24rpx 42rpx; text-align: center; }
.footer-text, .footer-link { color: #858b93; font-size: 23rpx; }
.footer-link { color: #a61d18; }
