.login-page { display: flex; flex-direction: column; min-height: 100vh; background: #d92822; box-sizing: border-box; }
.top-accent { height: 1rpx; background: rgba(255, 255, 255, 0.18); }
.brand-area { display: flex; flex-direction: column; align-items: center; padding: 142rpx 48rpx 0; }
.brand-icon { display: flex; width: 112rpx; height: 112rpx; align-items: center; justify-content: center; color: #d92822; background: #ffffff; border-radius: 28rpx; font-size: 50rpx; font-weight: 700; }
.brand-name { display: block; margin-top: 24rpx; color: #ffffff; font-size: 36rpx; font-weight: 600; }
.auth-area { margin-top: auto; padding: 0 56rpx 42rpx; }.wechat-login-btn { width: 100%; height: 88rpx; margin: 0; color: #d92822; background: #ffffff; border: 0; border-radius: 12rpx; font-size: 30rpx; font-weight: 600; line-height: 88rpx; }.wechat-login-btn::after { border: 0; }.wechat-login-btn[disabled] { color: #d67975; background: rgba(255,255,255,0.78); }
.footer { display: flex; flex-wrap: wrap; justify-content: center; gap: 8rpx; padding: 0 24rpx calc(42rpx + env(safe-area-inset-bottom)); text-align: center; }.footer-text, .footer-link { color: rgba(255, 255, 255, 0.7); font-size: 23rpx; }.footer-link { color: #ffffff; font-weight: 500; }
