.container { display: flex; flex-direction: column; min-height: 100vh; background: #f7f8fa; box-sizing: border-box; }
.login-hero { display: flex; flex-direction: column; align-items: center; min-height: 356rpx; padding: 48rpx 48rpx 116rpx; color: #ffffff; background: #d92822; border-radius: 0 0 48rpx 48rpx; box-sizing: border-box; }
.brand-icon { display: flex; width: 102rpx; height: 102rpx; align-items: center; justify-content: center; color: #d92822; background: #ffffff; border-radius: 30rpx; box-shadow: 0 10rpx 24rpx rgba(132, 20, 17, 0.2); font-size: 46rpx; font-weight: 700; }
.title, .subtitle, .panel-title, .panel-copy, .panel-hint { display: block; }.title { margin-top: 24rpx; color: #ffffff; font-size: 42rpx; font-weight: 700; }.subtitle { margin-top: 10rpx; color: rgba(255, 255, 255, 0.82); font-size: 26rpx; }

.login-panel { margin: -64rpx 28rpx 0; padding: 34rpx 30rpx 30rpx; background: #ffffff; border-radius: 22rpx; box-shadow: 0 16rpx 38rpx rgba(48, 55, 64, 0.12); }
.welcome-row { display: flex; align-items: center; color: #747b85; font-size: 24rpx; }.welcome-mark { display: flex; width: 38rpx; height: 38rpx; align-items: center; justify-content: center; margin-right: 10rpx; color: #ffffff; background: #28b76b; border-radius: 50%; font-size: 20rpx; font-weight: 600; }
.panel-title { margin-top: 24rpx; color: #292d32; font-size: 32rpx; font-weight: 700; }.panel-copy { margin-top: 12rpx; color: #858b93; font-size: 25rpx; line-height: 1.65; }
.wechat-login-btn { width: 100%; height: 88rpx; margin-top: 34rpx; color: #ffffff; background: #d92822; border: 0; border-radius: 44rpx; font-size: 29rpx; font-weight: 600; line-height: 88rpx; }.wechat-login-btn::after { border: 0; }.wechat-login-btn[disabled] { color: rgba(255,255,255,0.85); background: #e3918e; }
.panel-hint { margin-top: 22rpx; color: #a0a5ad; font-size: 22rpx; text-align: center; }
.footer { display: flex; flex-wrap: wrap; justify-content: center; gap: 8rpx; margin-top: auto; padding: 52rpx 24rpx 40rpx; text-align: center; }.footer-text, .footer-link { color: #9aa0a8; font-size: 23rpx; }.footer-link { color: #d92822; }
