.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #f5222d 0%, #ff4d4f 100%);
  padding: 0 40rpx;
}

.logo-container {
  margin-bottom: 80rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background-color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.title-container {
  text-align: center;
  margin-bottom: 100rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.4;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
}

.button-container {
  width: 100%;
  margin-bottom: 80rpx;
}

.wechat-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 90rpx;
  background-color: white;
  border-radius: 45rpx;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.wechat-login-btn:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.2);
}

.wechat-login-btn:active {
  transform: translateY(0);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.wechat-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.wechat-login-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1AAD19;
}

.footer {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8rpx;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.footer-link {
  font-size: 24rpx;
  color: white;
  text-decoration: underline;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .title {
    font-size: 44rpx;
  }
  
  .subtitle {
    font-size: 26rpx;
  }
  
  .wechat-login-text {
    font-size: 30rpx;
  }
}

@media (min-width: 768px) {
  .container {
    max-width: 450px;
    margin: 0 auto;
  }
}