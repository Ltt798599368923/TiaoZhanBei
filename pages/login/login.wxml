

<view class="container">
  <!-- 品牌Logo -->
  <view class="logo-container">
    <view class="logo">
      <text style="font-size: 60rpx;">⚖️</text>
    </view>
  </view>
  
  <!-- 标题 -->
  <view class="title-container">
    <text class="title">法律咨询平台</text>
    <text class="subtitle">专业法律服务，守护您的权益</text>
  </view>
  
  <!-- 登录按钮 -->
  <view class="button-container">
    <button class="wechat-login-btn" bindtap="wechatLogin">
      <image class="wechat-icon" src="https://res.wx.qq.com/open/res/ee4b253c23570358c78ab9a3a74f3332.png"></image>
      <text class="wechat-login-text">微信一键登录</text>
    </button>
  </view>
  
  <!-- 底部说明 -->
  <view class="footer">
    <text class="footer-text">登录即表示同意</text>
    <text class="footer-link" bindtap="showAgreement">《用户协议》</text>
    <text class="footer-text">和</text>
    <text class="footer-link" bindtap="showPrivacy">《隐私政策》</text>
  </view>
</view>