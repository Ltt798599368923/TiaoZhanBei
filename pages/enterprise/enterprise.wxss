.page { min-height: 100vh; padding: 24rpx 24rpx 56rpx; background: #f4f5f7; box-sizing: border-box; }
.page-lead { padding: 32rpx; border-left: 8rpx solid #bd1d17; border-radius: 8rpx; background: #fff; }.lead-kicker { display: block; color: #a61d18; font-size: 22rpx; font-weight: 600; }.lead-title { display: block; margin-top: 10rpx; color: #202124; font-size: 38rpx; font-weight: 700; line-height: 1.35; }.lead-copy { display: block; margin-top: 14rpx; color: #6b7078; font-size: 26rpx; line-height: 1.7; }
.section { margin-top: 28rpx; }.section-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 0 4rpx 16rpx; }.section-title { color: #292d32; font-size: 31rpx; font-weight: 700; }.section-note { color: #818891; font-size: 23rpx; }
.service-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }.service-card { min-height: 188rpx; padding: 24rpx; border: 1rpx solid #e1e4e8; border-radius: 8rpx; background: #fff; box-sizing: border-box; }.service-card:active { background: #fff7f6; border-color: #e9b6b0; }.service-name, .service-desc, .service-action { display: block; }.service-name { color: #2b2f35; font-size: 29rpx; font-weight: 700; }.service-desc { margin-top: 10rpx; color: #6d747d; font-size: 23rpx; line-height: 1.55; }.service-action { margin-top: 16rpx; color: #a61d18; font-size: 23rpx; font-weight: 600; }
.plans { white-space: nowrap; }.plans-track { display: flex; gap: 16rpx; padding-right: 16rpx; }.plan-card { position: relative; display: flex; flex-direction: column; width: 520rpx; min-height: 404rpx; padding: 28rpx; border: 1rpx solid #e1e4e8; border-radius: 8rpx; background: #fff; white-space: normal; box-sizing: border-box; }.plan-card.recommended { border-color: #d8928b; background: #fffaf9; }.recommended-label { position: absolute; top: 0; right: 24rpx; padding: 6rpx 14rpx; color: #fff; background: #a61d18; font-size: 21rpx; }.plan-name { color: #2b2f35; font-size: 31rpx; font-weight: 700; }.plan-price { display: block; margin-top: 10rpx; color: #a61d18; font-size: 27rpx; font-weight: 600; }.feature-list { flex: 1; margin-top: 20rpx; }.feature-item { display: block; margin-bottom: 10rpx; color: #626972; font-size: 24rpx; line-height: 1.5; }.feature-item::before { margin-right: 10rpx; color: #a61d18; content: '•'; }.plan-button, .primary-button, .text-button { height: 70rpx; border-radius: 6rpx; font-size: 25rpx; line-height: 70rpx; }.plan-button, .primary-button { color: #fff; background: #bd1d17; }.plan-button::after, .primary-button::after, .text-button::after { border: 0; }.text-button { color: #a61d18; background: #fff; border: 1rpx solid #d99790; }
.contact-strip { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 32rpx; padding: 28rpx; border: 1rpx solid #e1e4e8; border-radius: 8rpx; background: #fff; }.contact-title, .contact-copy { display: block; }.contact-title { color: #30343a; font-size: 28rpx; font-weight: 700; }.contact-copy { margin-top: 8rpx; color: #737981; font-size: 23rpx; line-height: 1.5; }.contact-actions { display: flex; flex-direction: column; gap: 12rpx; flex-shrink: 0; }.contact-actions button { min-width: 154rpx; padding: 0 14rpx; }

.plan-button, .primary-button, .text-button { display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1; text-align: center; box-sizing: border-box; }
.contact-actions button { display: flex; align-items: center; justify-content: center; line-height: 1; text-align: center; box-sizing: border-box; }
