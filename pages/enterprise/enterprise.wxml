<view class="page">
  <view class="page-lead">
    <text class="lead-kicker">企业法律服务</text>
    <text class="lead-title">围绕企业经营场景提交真实需求</text>
    <text class="lead-copy">选择服务方向后提交咨询，平台会根据需求、联系方式和律师档期安排后续服务。</text>
  </view>

  <view class="section">
    <view class="section-heading"><text class="section-title">服务方向</text><text class="section-note">按实际需求提交</text></view>
    <view class="service-grid">
      <view wx:for="{{services}}" wx:key="type" class="service-card" bindtap="selectService" data-type="{{item.type}}">
        <text class="service-name">{{item.name}}</text>
        <text class="service-desc">{{item.description}}</text>
        <text class="service-action">提交需求</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-heading"><text class="section-title">服务方案</text><text class="section-note">按需沟通报价</text></view>
    <scroll-view class="plans" scroll-x="true" enable-flex="true" show-scrollbar="false">
      <view class="plans-track">
        <view wx:for="{{plans}}" wx:key="plan" class="plan-card {{item.plan === 'standard' ? 'recommended' : ''}}">
          <text wx:if="{{item.plan === 'standard'}}" class="recommended-label">推荐</text>
          <text class="plan-name">{{item.name}}</text>
          <text class="plan-price">{{item.price}}</text>
          <view class="feature-list"><text wx:for="{{item.features}}" wx:for-item="feature" wx:key="*this" class="feature-item">{{feature}}</text></view>
          <button class="plan-button" bindtap="selectPlan" data-plan="{{item.plan}}">提交方案咨询</button>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="contact-strip">
    <view><text class="contact-title">已有明确的服务需求？</text><text class="contact-copy">可直接提交企业咨询，或选择律师预约。</text></view>
    <view class="contact-actions"><button class="text-button" bindtap="contactUs">提交需求</button><button class="primary-button" bindtap="contactAdviser">选择律师</button></view>
  </view>
</view>
