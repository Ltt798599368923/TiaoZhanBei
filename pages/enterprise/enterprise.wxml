<!--enterprise.wxml-->
<view class="container">
  <!-- 顶部标题 -->
  <view style="background-color: #f5222d; width: 100%; padding: 15px; display: flex; align-items: center; color: white; font-size: 18px; font-weight: bold;">
    <view bindtap="goBack" style="margin-right: 15px; font-size: 20px;">←</view>
    <text>企业法律服务</text>
  </view>

  <!-- 服务介绍 -->
  <view style="padding: 20px; background-color: white; margin: 10px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <view style="text-align: center; margin-bottom: 20px;">
      <view style="font-size: 48px; margin-bottom: 15px;">💼</view>
      <text style="font-size: 20px; font-weight: bold; color: #333;">企业法律服务</text>
    </view>
    <view style="font-size: 14px; line-height: 1.6; color: #666; margin-bottom: 20px;">
      <text>我们为企业提供全方位的法律服务，包括企业设立、合同管理、知识产权保护、劳动人事等方面的专业法律支持。</text>
    </view>
  </view>

  <!-- 服务内容 -->
  <view style="padding: 20px; background-color: white; margin: 10px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <text style="font-size: 16px; font-weight: bold; margin-bottom: 15px; display: block;">服务内容</text>

    <view bindtap="selectService" data-type="setup" style="display: flex; align-items: center; padding: 15px; border-bottom: 1px solid #f0f0f0;">
      <view style="width: 50px; height: 50px; background-color: #f5f5f5; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
        <text style="font-size: 24px;">🏢</text>
      </view>
      <view style="flex: 1;">
        <text style="font-size: 16px; font-weight: 500; margin-bottom: 5px; display: block;">企业设立</text>
        <text style="font-size: 12px; color: #666;">公司注册、股权结构设计</text>
      </view>
      <text style="font-size: 16px; color: #999;">→</text>
    </view>

    <view bindtap="selectService" data-type="contract" style="display: flex; align-items: center; padding: 15px; border-bottom: 1px solid #f0f0f0;">
      <view style="width: 50px; height: 50px; background-color: #f5f5f5; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
        <text style="font-size: 24px;">📝</text>
      </view>
      <view style="flex: 1;">
        <text style="font-size: 16px; font-weight: 500; margin-bottom: 5px; display: block;">合同管理</text>
        <text style="font-size: 12px; color: #666;">合同起草、审查、管理</text>
      </view>
      <text style="font-size: 16px; color: #999;">→</text>
    </view>

    <view bindtap="selectService" data-type="ip" style="display: flex; align-items: center; padding: 15px; border-bottom: 1px solid #f0f0f0;">
      <view style="width: 50px; height: 50px; background-color: #f5f5f5; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
        <text style="font-size: 24px;">🔒</text>
      </view>
      <view style="flex: 1;">
        <text style="font-size: 16px; font-weight: 500; margin-bottom: 5px; display: block;">知识产权</text>
        <text style="font-size: 12px; color: #666;">商标、专利、著作权保护</text>
      </view>
      <text style="font-size: 16px; color: #999;">→</text>
    </view>

    <view bindtap="selectService" data-type="labor" style="display: flex; align-items: center; padding: 15px; border-bottom: 1px solid #f0f0f0;">
      <view style="width: 50px; height: 50px; background-color: #f5f5f5; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
        <text style="font-size: 24px;">👥</text>
      </view>
      <view style="flex: 1;">
        <text style="font-size: 16px; font-weight: 500; margin-bottom: 5px; display: block;">劳动人事</text>
        <text style="font-size: 12px; color: #666;">劳动合同、社保、工伤处理</text>
      </view>
      <text style="font-size: 16px; color: #999;">→</text>
    </view>
  </view>

  <!-- 服务方案 -->
  <view style="padding: 20px; background-color: white; margin: 10px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <text style="font-size: 16px; font-weight: bold; margin-bottom: 15px; display: block;">服务方案</text>

    <view bindtap="selectPlan" data-plan="basic" style="padding: 15px; border: 1px solid #e8e8e8; border-radius: 8px; margin-bottom: 15px;">
      <text style="font-size: 16px; font-weight: 500; margin-bottom: 10px; display: block;">基础服务</text>
      <text style="font-size: 14px; color: #f5222d; font-weight: bold; margin-bottom: 10px; display: block;">¥2999/年</text>
      <text style="font-size: 12px; color: #666; line-height: 1.5; margin-bottom: 10px; display: block;">
        • 企业法律咨询\n• 合同审查（5份/年）\n• 法律文书起草（3份/年）
      </text>
      <button style="background-color: #f5222d; color: white; border: none; padding: 8px 20px; border-radius: 16px; font-size: 14px;">选择方案</button>
    </view>

    <view bindtap="selectPlan" data-plan="standard" style="padding: 15px; border: 2px solid #f5222d; border-radius: 8px; margin-bottom: 15px; background-color: #fff5f5;">
      <text style="font-size: 16px; font-weight: 500; margin-bottom: 10px; display: block;">标准服务</text>
      <text style="font-size: 14px; color: #f5222d; font-weight: bold; margin-bottom: 10px; display: block;">¥5999/年</text>
      <text style="font-size: 12px; color: #666; line-height: 1.5; margin-bottom: 10px; display: block;">
        • 企业法律咨询\n• 合同审查（10份/年）\n• 法律文书起草（6份/年）\n• 劳动人事咨询\n• 知识产权咨询
      </text>
      <button style="background-color: #f5222d; color: white; border: none; padding: 8px 20px; border-radius: 16px; font-size: 14px;">选择方案</button>
    </view>

    <view bindtap="selectPlan" data-plan="premium" style="padding: 15px; border: 1px solid #e8e8e8; border-radius: 8px; margin-bottom: 15px;">
      <text style="font-size: 16px; font-weight: 500; margin-bottom: 10px; display: block;">高级服务</text>
      <text style="font-size: 14px; color: #f5222d; font-weight: bold; margin-bottom: 10px; display: block;">¥9999/年</text>
      <text style="font-size: 12px; color: #666; line-height: 1.5; margin-bottom: 10px; display: block;">
        • 企业法律咨询\n• 合同审查（不限）\n• 法律文书起草（不限）\n• 劳动人事咨询\n• 知识产权咨询\n• 企业法律风险评估
      </text>
      <button style="background-color: #f5222d; color: white; border: none; padding: 8px 20px; border-radius: 16px; font-size: 14px;">选择方案</button>
    </view>
  </view>

  <!-- 联系我们 -->
  <view style="padding: 20px; background-color: white; margin: 10px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <text style="font-size: 16px; font-weight: bold; margin-bottom: 15px; display: block;">联系我们</text>
    <view style="display: flex; align-items: center; margin-bottom: 15px;">
      <view style="width: 40px; height: 40px; background-color: #f5f5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
        <text style="font-size: 16px;">📞</text>
      </view>
      <text style="font-size: 14px; color: #666;">400-123-4567</text>
    </view>
    <view style="display: flex; align-items: center; margin-bottom: 15px;">
      <view style="width: 40px; height: 40px; background-color: #f5f5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
        <text style="font-size: 16px;">📧</text>
      </view>
      <text style="font-size: 14px; color: #666;">service@falv.com</text>
    </view>
    <button bindtap="contactUs" style="background-color: #f5222d; color: white; border: none; padding: 10px; border-radius: 8px; font-size: 16px; width: 100%;">立即咨询</button>
  </view>
</view>