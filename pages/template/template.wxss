.template-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  background: #f4f5f7;
  box-sizing: border-box;
}

.page-heading {
  padding: 4rpx 4rpx 24rpx;
}

.heading-title,
.heading-copy {
  display: block;
}

.heading-title {
  color: #202124;
  font-size: 40rpx;
  font-weight: 700;
}

.heading-copy {
  margin-top: 10rpx;
  color: #747b85;
  font-size: 26rpx;
}

.template-section {
  margin: 0 0 22rpx;
  background: #ffffff;
  border: 1rpx solid #e1e4e8;
  border-radius: 8rpx;
  overflow: hidden;
}

.section-header {
  height: 88rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eceef0;
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
}

.all-link, .template-count, .template-meta, .template-description {
  font-size: 24rpx;
  font-weight: 400;
  color: #888888;
}

.all-link, .template-action {
  color: #c0190e;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  padding: 24rpx;
}

.category-item {
  min-height: 136rpx;
  background: #f8f9fa;
  border: 1rpx solid #e5e7ea;
  border-radius: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #333333;
}

.category-active {
  border-color: #bd1d17;
  background: #fff3f1;
  color: #a61d18;
}

.category-icon {
  font-size: 36rpx;
}

.template-item {
  min-height: 144rpx;
  padding: 22rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eceef0;
}

.template-item:last-child {
  border-bottom: 0;
}

.template-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.template-title {
  color: #30343a;
  font-size: 30rpx;
  font-weight: 500;
}

.template-description {
  max-width: 500rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.template-action {
  flex: 0 0 auto;
  padding-left: 18rpx;
  border-left: 1rpx solid #e2e4e7;
  font-size: 25rpx;
  font-weight: 600;
}

.template-tools {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
}

.favorite-action {
  margin-right: 18rpx;
  color: #747b85;
  font-size: 24rpx;
}

.empty-state {
  padding: 64rpx 28rpx;
  color: #888888;
  text-align: center;
  font-size: 28rpx;
}
