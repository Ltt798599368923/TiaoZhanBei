<view class="template-page">
  <view class="page-heading">
    <text class="heading-kicker">DOCUMENT LIBRARY</text>
    <text class="heading-title">文书模板</text>
    <text class="heading-copy">按类型查找、收藏和使用常用法律文书</text>
  </view>

  <view class="template-section">
    <view class="section-header">
      <text>按文书类型查找</text>
    </view>
    <view class="category-grid">
      <view wx:for="{{categories}}" wx:key="id" class="category-item {{selectedCategory === item.id ? 'category-active' : ''}}" bindtap="selectCategory" data-category="{{item.id}}">
        <view class="category-mark"><text>{{item.mark}}</text></view>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="filter-section">
    <text class="filter-label">业务领域</text>
    <scroll-view class="filter-scroll" scroll-x="true" enable-flex="true">
      <view class="filter-row">
        <view wx:for="{{practiceAreas}}" wx:key="id" class="filter-chip {{selectedPracticeArea === item.id ? 'filter-active' : ''}}" bindtap="selectPracticeArea" data-practice-area="{{item.id}}">{{item.name}}</view>
      </view>
    </scroll-view>
    <text class="filter-label material-label">资料形态</text>
    <view class="material-row">
      <view wx:for="{{materialTypes}}" wx:key="id" class="material-chip {{selectedMaterialType === item.id ? 'filter-active' : ''}}" bindtap="selectMaterialType" data-material-type="{{item.id}}">{{item.name}}</view>
    </view>
  </view>

  <view class="template-section">
    <view class="section-header">
      <text>文书列表</text>
      <text class="template-count">{{templates.length}} 项</text>
    </view>
    <view wx:if="{{loading}}" class="empty-state">加载中...</view>
    <view wx:elif="{{templates.length === 0}}" class="empty-state">暂无可用模板</view>
    <block wx:else>
      <view wx:for="{{templates}}" wx:key="id" class="template-item" bindtap="viewTemplateDetail" data-id="{{item.id}}">
        <view class="template-copy">
          <text class="template-title">{{item.title}}</text>
          <text class="template-description">{{item.description || item.practiceAreaLabel}}</text>
          <view class="template-tags">
            <text>{{item.categoryLabel}}</text>
            <text>{{item.practiceAreaLabel}}</text>
            <text>{{item.materialTypeLabel}}</text>
          </view>
          <text class="template-meta">{{item.readingLabel}} · 使用 {{item.downloadCount || 0}} 次</text>
        </view>
        <view class="template-tools">
          <text catchtap="addFavorite" data-id="{{item.id}}" data-title="{{item.title}}" data-description="{{item.description || item.practiceAreaLabel}}" class="favorite-action">收藏</text>
          <view class="template-action"><text>></text></view>
        </view>
      </view>
    </block>
  </view>
</view>
