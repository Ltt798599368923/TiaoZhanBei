<view class="template-page">
  <app-header title="文书模板" back="{{true}}" />
  <view wx:if="{{false}}" class="template-header">
    <view class="back-button" bindtap="goBack">←</view>
    <text>文书模板</text>
  </view>

  <view class="template-section">
    <view class="section-header">
      <text>模板分类</text>
      <text class="all-link" bindtap="viewAllTemplates">全部</text>
    </view>
    <view class="category-grid">
      <view wx:for="{{categories}}" wx:key="id" class="category-item {{selectedCategory === item.id ? 'category-active' : ''}}" bindtap="selectCategory" data-category="{{item.id}}">
        <text class="category-icon">{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="template-section">
    <view class="section-header">
      <text>{{selectedCategory ? '分类模板' : '全部模板'}}</text>
      <text class="template-count">{{templates.length}} 项</text>
    </view>
    <view wx:if="{{loading}}" class="empty-state">加载中...</view>
    <view wx:elif="{{templates.length === 0}}" class="empty-state">暂无可用模板</view>
    <block wx:else>
      <view wx:for="{{templates}}" wx:key="id" class="template-item" bindtap="viewTemplateDetail" data-id="{{item.id}}">
        <view class="template-copy">
          <text class="template-title">{{item.title}}</text>
          <text class="template-description">{{item.description || item.category}}</text>
          <text class="template-meta">使用 {{item.downloadCount || 0}} 次</text>
        </view>
        <view style="display: flex; align-items: center;">
          <text catchtap="addFavorite" data-id="{{item.id}}" data-title="{{item.title}}" data-description="{{item.description || item.category}}" style="color: #888; font-size: 24rpx; margin-right: 20rpx;">收藏</text>
          <text class="template-action">使用</text>
        </view>
      </view>
    </block>
  </view>
</view>
