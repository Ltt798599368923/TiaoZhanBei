<!-- lawsearch.wxml -->
<view class="container">
  <view class="search-stage">
    <text class="stage-kicker">LEGAL REFERENCE</text>
    <text class="heading-title">法条检索</text>
    <text class="heading-copy">输入关键词，获取检索建议与官方核验渠道</text>
  </view>

  <view class="search-header">
    <view class="search-bar">
      <input 
        class="search-input" 
        placeholder="请输入法条关键词" 
        placeholder-class="placeholder-text"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
      <text class="clear-btn" wx:if="{{searchKeyword}}" bindtap="onClearSearch">清空</text>
    </view>
    <text class="search-btn" bindtap="onSearch">检索</text>
  </view>

  <view class="hot-search" wx:if="{{!searchKeyword && !searchResults.length}}">
    <view class="panel-heading">
      <text class="panel-title">常用关键词</text>
    </view>
    <view class="hot-search-tags">
      <text 
        class="hot-tag" 
        wx:for="{{hotKeywords}}" 
        wx:key="index"
        bindtap="onHotKeywordTap"
        data-keyword="{{item}}"
      >
        {{item}}
      </text>
    </view>
  </view>

  <view class="search-results" wx:if="{{searchResults.length}}">
    <view class="panel-heading">
      <text class="panel-title">检索结果</text>
      <text class="panel-count">{{searchResults.length}} 条</text>
    </view>
    <view class="result-list">
      <view 
        class="result-item" 
        wx:for="{{searchResults}}" 
        wx:key="id"
        bindtap="onResultTap"
        data-result="{{item}}"
      >
        <view class="result-title">
          <text class="law-name">{{item.lawName}}</text>
          <text class="article-number" wx:if="{{item.article}}">第 {{item.article}} 条</text>
        </view>
        <view class="result-content">
          <text>{{item.content}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{aiAdvice}}" class="ai-advice">
    <text class="advice-title">AI 检索建议</text>
    <text class="advice-copy">{{aiAdvice}}</text>
    <text class="advice-note">该内容不构成法条、法律意见或法律效力判断，请以下列官方渠道为准。</text>
  </view>

  <view wx:if="{{officialSources.length}}" class="source-panel">
    <text class="source-title">官方核验渠道</text>
    <view wx:for="{{officialSources}}" wx:key="url" class="source-row" bindtap="copyOfficialSource" data-url="{{item.url}}"><view><text class="source-name">{{item.name}}</text><text class="source-desc">{{item.description}}</text></view><text class="source-action">复制地址</text></view>
  </view>

  <view class="state-panel" wx:if="{{searching}}">
    <text class="empty-text">正在检索相关法条...</text>
  </view>

  <view class="empty-state" wx:if="{{hasSearched && !searching && !searchResults.length && !aiAdvice}}">
    <view class="empty-mark">法</view>
    <text class="empty-text">未找到相关法条</text>
    <text class="empty-hint">请尝试其他关键词</text>
  </view>
</view>
