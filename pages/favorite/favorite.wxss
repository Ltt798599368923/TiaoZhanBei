.page { min-height: 100vh; padding: 24rpx 24rpx 56rpx; background: #f4f5f7; box-sizing: border-box; }
.page-lead { padding: 32rpx; border-left: 8rpx solid #bd1d17; border-radius: 8rpx; background: #fff; }
.lead-kicker, .lead-title, .lead-copy, .favorite-title, .favorite-desc, .favorite-time, .open-label, .remove-label, .empty-title, .empty-copy { display: block; }
.lead-kicker { color: #a61d18; font-size: 22rpx; font-weight: 600; }
.lead-title { margin-top: 10rpx; color: #202124; font-size: 38rpx; font-weight: 700; line-height: 1.35; }
.lead-copy { margin-top: 14rpx; color: #6b7078; font-size: 26rpx; line-height: 1.7; }
.favorite-list { margin-top: 28rpx; overflow: hidden; border: 1rpx solid #e1e4e8; border-radius: 8rpx; background: #fff; }
.favorite-item { display: flex; align-items: center; gap: 20rpx; min-height: 152rpx; padding: 22rpx 24rpx; border-bottom: 1rpx solid #eceef0; box-sizing: border-box; }
.favorite-item:last-child { border-bottom: 0; }
.favorite-item:active { background: #fff7f6; }
.favorite-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 76rpx; width: 76rpx; height: 76rpx; color: #a61d18; border-radius: 8rpx; background: #fff1f0; font-size: 22rpx; font-weight: 700; }
.favorite-copy { min-width: 0; flex: 1; }
.favorite-title { overflow: hidden; color: #30343a; font-size: 29rpx; font-weight: 700; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.favorite-desc { margin-top: 8rpx; overflow: hidden; color: #737981; font-size: 23rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.favorite-time { margin-top: 8rpx; color: #969ca4; font-size: 21rpx; }
.favorite-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; flex: 0 0 auto; }
.open-label { color: #a61d18; font-size: 24rpx; font-weight: 600; }
.remove-label { color: #8b9199; font-size: 22rpx; }
.state-panel { margin-top: 28rpx; padding: 64rpx 28rpx; border: 1rpx solid #e1e4e8; border-radius: 8rpx; color: #777e87; background: #fff; font-size: 27rpx; text-align: center; }
.empty-panel { margin-top: 28rpx; }
.empty-title { color: #34383e; font-size: 30rpx; font-weight: 700; }
.empty-copy { margin-top: 14rpx; color: #7c838c; font-size: 25rpx; line-height: 1.6; }
