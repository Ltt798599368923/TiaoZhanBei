<!-- favorite.wxml -->
<view class="container">
<view wx:if="{{false}}" style="background: linear-gradient(135deg, #f5222d, #ff4d4f); width: 100%; padding: 45rpx 30rpx; display: flex; align-items: center; color: white; font-size: 34rpx; font-weight: bold; box-sizing: border-box;">
    <view bindtap="goBack" style="width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0;">←</view>
    <text style="flex: 1; text-align: center; padding-right: 60rpx;">我的收藏</text>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">加载中...</view>

  <view wx:elif="{{favoriteList.length > 0}}" class="fav-list">
    <view wx:for="{{favoriteList}}" wx:key="id" class="fav-card">
      <view class="fav-icon">{{item.icon || '📌'}}</view>
      <view class="fav-info">
        <text class="fav-title">{{item.title}}</text>
        <text class="fav-desc">{{item.description || '暂无描述'}}</text>
      </view>
      <view class="fav-remove" data-id="{{item.id}}" bindtap="removeFavorite">取消</view>
    </view>
  </view>

  <view wx:else class="empty">
    <view class="empty-icon">🌟</view>
    <text class="empty-text">还没有收藏内容</text>
    <text class="empty-hint">浏览内容时点击收藏按钮即可添加</text>
  </view>
</view>
