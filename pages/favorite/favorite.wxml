<view class="page">
  <view class="page-lead">
    <text class="lead-kicker">我的内容</text>
    <text class="lead-title">我的收藏</text>
    <text class="lead-copy">收藏的文书模板可在这里再次查看、复制或下载。</text>
  </view>

  <view wx:if="{{loading}}" class="state-panel">加载中...</view>

  <view wx:elif="{{favoriteList.length}}" class="favorite-list">
    <view wx:for="{{favoriteList}}" wx:key="id" class="favorite-item" bindtap="viewFavorite" data-contenttype="{{item.contentType}}" data-contentid="{{item.contentId}}">
      <view class="favorite-icon"><text>{{item.icon || '文书'}}</text></view>
      <view class="favorite-copy">
        <text class="favorite-title">{{item.title}}</text>
        <text class="favorite-desc">{{item.description || '暂无说明'}}</text>
        <text class="favorite-time">收藏于 {{item.time}}</text>
      </view>
      <view class="favorite-actions">
        <text class="open-label">查看</text>
        <text catchtap="removeFavorite" data-id="{{item.id}}" class="remove-label">取消</text>
      </view>
    </view>
  </view>

  <view wx:else class="state-panel empty-panel">
    <text class="empty-title">还没有收藏内容</text>
    <text class="empty-copy">浏览文书模板时，点击“收藏”即可在此处保留。</text>
  </view>
</view>
