/* consult.wxss */
/* 在线咨询页面样式 */

/* 容器样式 */
.container {
  min-height: 100vh;          /* 最小高度为屏幕高度 */
  background-color: #f5f5f5;  /* 背景色为浅灰色 */
}

/* 头部样式 */
.header {
  background: linear-gradient(135deg, #DE1E1D 0%, #C41918 100%);  /* 红色渐变背景 */
  padding: 40rpx 30rpx;        /* 内边距，增加顶部和底部内边距 */
  display: flex;              /* 使用flex布局 */
  align-items: center;        /* 垂直居中 */
  position: relative;         /* 相对定位 */
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);  /* 阴影 */
  min-height: 120rpx;         /* 最小高度 */
}

/* 返回按钮 */
.back-btn {
  position: absolute;
  left: 0rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  color: #ffffff;
  cursor: pointer;
  z-index: 10;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 头部标题 */
.header-title {
  font-size: 36rpx;           /* 字体大小 */
  color: #ffffff;             /* 白色文本 */
  font-weight: bold;          /* 加粗 */
  text-align: center;         /* 文本居中 */
  width: 100%;                /* 宽度100% */
  padding-left: 0rpx;         /* 左侧内边距 */
  margin-left: 0rpx;          /* 左侧外边距 */
  position: relative;
  z-index: 5;
}

/* 服务介绍 */
.service-intro {
  background-color: white;    /* 白色背景 */
  margin: 10rpx;              /* 外边距 */
  padding: 30rpx;              /* 内边距 */
  border-radius: 16rpx;       /* 圆角 */
  text-align: center;         /* 文本居中 */
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);  /* 阴影 */
}

/* 介绍图标 */
.intro-icon {
  font-size: 80rpx;           /* 字体大小 */
  margin-bottom: 20rpx;       /* 底部间距 */
}

/* 介绍标题 */
.intro-title {
  font-size: 32rpx;           /* 字体大小 */
  font-weight: bold;          /* 加粗 */
  color: #333333;             /* 深灰色文本 */
  margin-bottom: 15rpx;       /* 底部间距 */
  display: block;             /* 块级元素 */
}

/* 介绍描述 */
.intro-desc {
  font-size: 28rpx;           /* 字体大小 */
  color: #666666;             /* 中灰色文本 */
  line-height: 1.5;           /* 行高 */
}

/* 咨询类型选择 */
.consult-types {
  display: flex;              /* 使用flex布局 */
  background-color: #ffffff;  /* 白色背景 */
  padding: 20rpx;              /* 内边距 */
  overflow-x: auto;           /* 水平滚动 */
  white-space: nowrap;        /* 不换行 */
  margin: 10rpx;              /* 外边距 */
  border-radius: 12rpx;       /* 圆角 */
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);  /* 阴影 */
}

/* 类型项 */
.type-item {
  padding: 12rpx 28rpx;       /* 内边距 */
  font-size: 26rpx;           /* 字体大小 */
  color: #666666;             /* 中灰色文本 */
  margin-right: 16rpx;        /* 右侧间距 */
  border-radius: 30rpx;       /* 圆角 */
  background-color: #f5f5f5;  /* 浅灰色背景 */
  transition: all 0.3s ease;  /* 过渡动画 */
}

/* 类型项悬停效果 */
.type-item:hover {
  background-color: #f0f0f0;  /* 浅灰色背景 */
  transform: translateY(-2rpx);  /* 向上移动 */
}

/* 类型项激活状态 */
.type-item.active {
  background: linear-gradient(135deg, #DE1E1D 0%, #C41918 100%);  /* 红色渐变背景 */
  color: #ffffff;             /* 白色文本 */
  box-shadow: 0 2px 8px rgba(222,30,29,0.3);  /* 红色阴影 */
}

/* 咨询表单 */
.consult-form {
  background-color: white;    /* 白色背景 */
  margin: 10rpx;              /* 外边距 */
  padding: 30rpx;              /* 内边距 */
  border-radius: 16rpx;       /* 圆角 */
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);  /* 阴影 */
}

/* 表单项 */
.form-item {
  margin-bottom: 24rpx;        /* 底部间距 */
}

/* 表单标签 */
.form-label {
  font-size: 28rpx;           /* 字体大小 */
  color: #333333;             /* 深灰色文本 */
  font-weight: 500;           /* 中等加粗 */
  margin-bottom: 12rpx;       /* 底部间距 */
  display: block;             /* 块级元素 */
}

/* 表单文本域 */
.form-textarea {
  width: 100%;                /* 宽度100% */
  height: 200rpx;             /* 高度 */
  border: 1px solid #e8e8e8;  /* 边框 */
  border-radius: 12rpx;       /* 圆角 */
  padding: 20rpx;              /* 内边距 */
  font-size: 26rpx;           /* 字体大小 */
  color: #333333;             /* 深灰色文本 */
  resize: none;               /* 禁止调整大小 */
  background-color: #f9f9f9;  /* 浅灰色背景 */
}

/* 表单输入框 */
.form-input {
  width: 100%;                /* 宽度100% */
  height: 80rpx;              /* 高度 */
  border: 1px solid #e8e8e8;  /* 边框 */
  border-radius: 12rpx;       /* 圆角 */
  padding: 0 20rpx;            /* 内边距 */
  font-size: 26rpx;           /* 字体大小 */
  color: #333333;             /* 深灰色文本 */
  background-color: #f9f9f9;  /* 浅灰色背景 */
}

/* 表单选择器 */
.form-picker {
  width: 100%;                /* 宽度100% */
  height: 80rpx;              /* 高度 */
  border: 1px solid #e8e8e8;  /* 边框 */
  border-radius: 12rpx;       /* 圆角 */
  padding: 0 20rpx;            /* 内边距 */
  font-size: 26rpx;           /* 字体大小 */
  color: #666666;             /* 中灰色文本 */
  background-color: #f9f9f9;  /* 浅灰色背景 */
  display: flex;              /* 使用flex布局 */
  align-items: center;        /* 垂直居中 */
  justify-content: space-between;  /* 两端对齐 */
}

/* 选择器视图 */
.picker-view {
  flex: 1;                    /* 占满剩余空间 */
}

/* 提交按钮 */
.submit-btn {
  width: 100%;                /* 宽度100% */
  height: 90rpx;              /* 高度 */
  background: linear-gradient(135deg, #DE1E1D 0%, #C41918 100%);  /* 红色渐变背景 */
  color: #ffffff;             /* 白色文本 */
  font-size: 32rpx;           /* 字体大小 */
  font-weight: bold;          /* 加粗 */
  border-radius: 16rpx;       /* 圆角 */
  border: none;               /* 无边框 */
  margin-top: 20rpx;           /* 顶部间距 */
  box-shadow: 0 4px 12px rgba(222,30,29,0.3);  /* 红色阴影 */
  transition: all 0.3s ease;  /* 过渡动画 */
}

/* 提交按钮悬停效果 */
.submit-btn:hover {
  transform: translateY(-2rpx);  /* 向上移动 */
  box-shadow: 0 6px 16px rgba(222,30,29,0.4);  /* 阴影变大 */
}

/* 常见问题 */
.faq-section {
  background-color: white;    /* 白色背景 */
  margin: 10rpx;              /* 外边距 */
  padding: 30rpx;              /* 内边距 */
  border-radius: 16rpx;       /* 圆角 */
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);  /* 阴影 */
}

/* 常见问题标题 */
.faq-title {
  font-size: 32rpx;           /* 字体大小 */
  font-weight: bold;          /* 加粗 */
  color: #333333;             /* 深灰色文本 */
  margin-bottom: 20rpx;       /* 底部间距 */
  display: block;             /* 块级元素 */
}

/* 常见问题列表 */
.faq-list {
  space-y: 16rpx;             /* 间距 */
}

/* 常见问题项 */
.faq-item {
  margin-bottom: 20rpx;        /* 底部间距 */
  padding-bottom: 20rpx;       /* 底部内边距 */
  border-bottom: 1px solid #f0f0f0;  /* 底部边框 */
}

/* 常见问题项最后一个 */
.faq-item:last-child {
  border-bottom: none;        /* 无边框 */
  margin-bottom: 0;           /* 无底部间距 */
  padding-bottom: 0;          /* 无底部内边距 */
}

/* 问题文本 */
.faq-question {
  font-size: 26rpx;           /* 字体大小 */
  font-weight: 500;           /* 中等加粗 */
  color: #333333;             /* 深灰色文本 */
  margin-bottom: 12rpx;       /* 底部间距 */
  display: block;             /* 块级元素 */
}

/* 答案文本 */
.faq-answer {
  font-size: 24rpx;           /* 字体大小 */
  color: #666666;             /* 中灰色文本 */
  line-height: 1.5;           /* 行高 */
  display: block;             /* 块级元素 */
}

/* 底部提示 */
.bottom-tip {
  padding: 16rpx;             /* 内边距 */
  text-align: center;         /* 文本居中 */
  margin: 5rpx;               /* 外边距 */
}

/* 提示文本 */
.tip-text {
  font-size: 22rpx;           /* 字体大小 */
  color: #999999;             /* 灰色文本 */
}
