.container {
  display: block;
  min-height: 100vh;
  padding: 28rpx 24rpx 56rpx;
  background: #f4f5f7;
  box-sizing: border-box;
}

.page-lead {
  width: 100%;
  padding: 32rpx;
  background: #ffffff;
  border-left: 8rpx solid #c0190e;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.lead-kicker {
  display: block;
  color: #a61d18;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.lead-title {
  display: block;
  margin-top: 10rpx;
  color: #202124;
  font-size: 38rpx;
  font-weight: 700;
}

.lead-copy {
  display: block;
  margin-top: 14rpx;
  color: #6b7078;
  font-size: 27rpx;
  line-height: 1.7;
}

.context-card {
  width: 100%;
  margin-top: 20rpx;
  padding: 4rpx 28rpx;
  background: #fff7f6;
  border: 1rpx solid #f4d5d1;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.context-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 62rpx;
  border-bottom: 1rpx solid #f5dedb;
}

.context-row:last-child {
  border-bottom: 0;
}

.context-label {
  color: #82625e;
  font-size: 25rpx;
}

.context-value {
  color: #9e211b;
  font-size: 27rpx;
  font-weight: 600;
}

.consult-form {
  width: 100%;
  margin-top: 28rpx;
  padding: 32rpx 28rpx 28rpx;
  background: #ffffff;
  border: 1rpx solid #e7e9ed;
  border-radius: 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(32, 33, 36, 0.05);
  box-sizing: border-box;
}

.form-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.form-title {
  color: #25282d;
  font-size: 32rpx;
  font-weight: 700;
}

.form-note {
  color: #8a9099;
  font-size: 22rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.form-label {
  display: block;
  color: #363a40;
  font-size: 27rpx;
  font-weight: 600;
}

.required-mark {
  margin-left: 6rpx;
  color: #bd1d17;
  font-size: 28rpx;
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.type-item {
  width: calc((100% - 24rpx) / 3);
  min-width: 0;
  padding: 13rpx 16rpx;
  border: 1rpx solid #e1e4e8;
  border-radius: 6rpx;
  color: #5f6670;
  font-size: 24rpx;
  line-height: 1.25;
  text-align: center;
  background: #ffffff;
  box-sizing: border-box;
}

.type-item.active {
  border-color: #bd1d17;
  background: #fff4f3;
  color: #ad1d17;
  font-weight: 600;
}

.form-input,
.form-textarea {
  width: 100%;
  border: 1rpx solid #dfe2e6;
  border-radius: 6rpx;
  color: #2d3137;
  background: #ffffff;
  box-sizing: border-box;
}

.form-input {
  height: 84rpx;
  padding: 0 20rpx;
  font-size: 27rpx;
  line-height: 84rpx;
}

.form-textarea {
  height: 208rpx;
  padding: 18rpx 20rpx;
  font-size: 27rpx;
  line-height: 1.55;
}

.submit-btn {
  width: 100%;
  height: 84rpx;
  margin-top: 4rpx;
  border: 0;
  border-radius: 6rpx;
  background: #bd1d17;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.submit-btn::after {
  border: 0;
}

.submit-btn:active {
  background: #9f1712;
}
