.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  background: linear-gradient(180deg, #f5222d 0%, #d40000 100%);
  padding: 40rpx 30rpx;
  text-align: center;
}

.header-title {
  display: block;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
}

.header-subtitle {
  display: block;
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  margin-top: 10rpx;
}

.filter-bar {
  display: flex;
  background-color: #ffffff;
  padding: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.filter-item {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666666;
  margin-right: 16rpx;
  border-radius: 30rpx;
  background-color: #f5f5f5;
}

.filter-item.active {
  background-color: #f5222d;
  color: #ffffff;
}

.lawyer-list {
  padding: 20rpx;
}

.lawyer-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.lawyer-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f5222d 0%, #ff7875 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.lawyer-avatar text {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
}

.lawyer-info {
  flex: 1;
}

.lawyer-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.lawyer-name {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-right: 12rpx;
}

.lawyer-title {
  font-size: 24rpx;
  color: #f5222d;
}

.lawyer-specialty {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 8rpx;
}

.lawyer-stats {
  display: flex;
  align-items: center;
}

.lawyer-rating {
  font-size: 24rpx;
  color: #ffa940;
  margin-right: 16rpx;
}

.lawyer-cases {
  font-size: 24rpx;
  color: #999999;
}

.lawyer-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.action-btn {
  padding: 16rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  text-align: center;
}

.action-btn.call {
  background-color: #f5222d;
  color: #ffffff;
}

.action-btn.chat {
  background-color: #fff1f0;
  color: #f5222d;
}