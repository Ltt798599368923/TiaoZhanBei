<view class="container">
  <view class="page-lead">
    <text class="lead-kicker">法律咨询</text>
    <text class="lead-title">描述您的法律问题</text>
    <text class="lead-copy">信息提交后，将由工作人员或您选择的律师跟进处理。</text>
  </view>

  <view wx:if="{{lawyerName || serviceName}}" class="context-card">
    <view wx:if="{{lawyerName}}" class="context-row">
      <text class="context-label">服务律师</text>
      <text class="context-value">{{lawyerName}}</text>
    </view>
    <view wx:if="{{serviceName}}" class="context-row">
      <text class="context-label">服务意向</text>
      <text class="context-value">{{serviceName}}</text>
    </view>
  </view>

  <view class="consult-form">
    <view class="form-heading">
      <text class="form-title">咨询信息</text>
      <text class="form-note">带 * 的项目为必填项</text>
    </view>

    <view class="form-item">
      <view class="label-row"><text class="form-label">咨询领域</text><text class="required-mark">*</text></view>
      <view class="type-grid">
        <view wx:for="{{consultTypes}}" wx:key="*this" class="type-item {{consultTypeIndex === index ? 'active' : ''}}" bindtap="chooseConsultType" data-index="{{index}}">{{item}}</view>
      </view>
    </view>

    <view class="form-item">
      <view class="label-row"><text class="form-label">咨询标题</text><text class="required-mark">*</text></view>
      <input class="form-input" placeholder="用一句话概括您的问题" maxlength="50" bindinput="onTitleInput" />
    </view>

    <view class="form-item">
      <view class="label-row"><text class="form-label">咨询内容</text><text class="required-mark">*</text></view>
      <textarea class="form-textarea" value="{{content}}" placeholder="请说明事件经过、您的疑问以及希望获得的帮助" maxlength="500" bindinput="onContentInput" />
    </view>

    <view class="form-item">
      <text class="form-label">联系方式</text>
      <input class="form-input" placeholder="手机号，便于后续联系" type="number" maxlength="11" bindinput="onPhoneInput" />
    </view>

    <button class="submit-btn" bindtap="submitConsult" loading="{{submitting}}" disabled="{{submitting}}">提交咨询</button>
  </view>
</view>
