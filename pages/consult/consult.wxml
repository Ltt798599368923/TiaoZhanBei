<!--consult.wxml-->
<!-- 在线咨询页面结构 -->
<view class="container" style="width: 746rpx; display: flex; box-sizing: border-box">
  <!-- 顶部标题 -->
  <view class="header" style="position: relative; left: -5rpx; top: 0rpx; width: 759rpx; height: 163rpx; display: flex; box-sizing: border-box">
    <view class="back-btn" bindtap="goBack" style="position: absolute; left: 48rpx; top: 124rpx">←</view>
    <text class="header-title" style="position: relative; left: -29rpx; top: 44rpx">在线咨询</text>
  </view>

  <!-- 服务介绍 -->
  <view class="service-intro">
    <view class="intro-icon">💬</view>
    <text class="intro-title">即时在线咨询</text>
    <text class="intro-desc">24小时在线律师为您提供即时法律咨询，快速解答您的法律疑问</text>
  </view>

  <!-- 咨询类型选择 -->
  <view class="consult-types">
    <view class="type-item active">法律问题</view>
    <view class="type-item">合同审查</view>
    <view class="type-item">文书指导</view>
    <view class="type-item">其他咨询</view>
  </view>

  <!-- 在线咨询表单 -->
  <view class="consult-form" style="width: 638rpx; display: block; box-sizing: border-box; height: 685rpx">
    <view class="form-item">
      <text class="form-label">咨询内容</text>
      <textarea class="form-textarea" placeholder="请详细描述您的法律问题，以便律师更好地为您解答..." maxlength="500" style="width: 454rpx; height: 161rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx"></textarea>
    </view>
    
    <view class="form-item">
      <text class="form-label">联系方式</text>
      <input class="form-input" placeholder="请留下您的手机号，方便律师联系您" type="number" style="width: 454rpx; height: 81rpx; display: block; box-sizing: border-box"></input>
    </view>
    
    <view class="form-item">
      <text class="form-label">咨询类型</text>
      <picker class="form-picker" range="['民事纠纷', '刑事辩护', '经济纠纷', '婚姻家庭', '房产纠纷', '知识产权', '其他']" style="width: 454rpx; height: 87rpx; display: flex; box-sizing: border-box">
        <view class="picker-view">请选择咨询类型</view>
      </picker>
    </view>
    
    <button class="submit-btn">提交咨询</button>
  </view>

  <!-- 常见问题 -->
  <view class="faq-section">
    <text class="faq-title">常见问题</text>
    <view class="faq-list">
      <view class="faq-item">
        <text class="faq-question">如何选择适合的律师？</text>
        <text class="faq-answer">根据您的案件类型，选择有相关经验的律师，查看律师的专业领域和成功案例。</text>
      </view>
      <view class="faq-item">
        <text class="faq-question">咨询费用如何计算？</text>
        <text class="faq-answer">首次在线咨询免费，后续咨询根据律师的收费标准而定，具体可与律师协商。</text>
      </view>
      <view class="faq-item">
        <text class="faq-question">咨询回复时间？</text>
        <text class="faq-answer">一般情况下，律师会在24小时内回复您的咨询，紧急情况可选择电话咨询。</text>
      </view>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="bottom-tip">
    <text class="tip-text">专业律师团队 · 24小时在线服务</text>
  </view>
</view>