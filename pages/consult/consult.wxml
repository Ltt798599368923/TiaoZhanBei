<!--consult.wxml-->
<!-- 在线咨询页面结构 -->
<view class="container">
  <app-header title="在线咨询" back="{{true}}" />
  <!-- 顶部标题 -->
  <view wx:if="{{false}}" style="background: linear-gradient(135deg, #f5222d, #ff4d4f); width: 100%; padding: 45rpx 30rpx; display: flex; align-items: center; color: white; font-size: 34rpx; font-weight: bold; box-sizing: border-box;">
    <view bindtap="goBack" style="width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; position: relative; left: 0rpx; top: 30rpx">←</view>
    <text style="flex: 1; text-align: center; padding-right: 60rpx; position: relative; left: -30rpx; top: 29rpx">在线咨询</text>
  </view>

  <!-- 服务介绍 -->
  <view class="service-intro">
    <view class="intro-icon">💬</view>
    <text class="intro-title">即时在线咨询</text>
    <text class="intro-desc">24小时在线律师为您提供即时法律咨询，快速解答您的法律疑问</text>
  </view>

  <!-- 咨询类型选择 -->
  <view class="consult-types">
    <view class="type-item active">法律问题</view>
    <view class="type-item">合同审查</view>
    <view class="type-item">文书指导</view>
    <view class="type-item">其他咨询</view>
  </view>

  <!-- 在线咨询表单 -->
  <view class="consult-form">
    <view class="form-item">
      <text class="form-label">咨询标题</text>
      <input class="form-input" placeholder="请输入咨询标题" maxlength="50" bindinput="onTitleInput"></input>
    </view>

    <view class="form-item">
      <text class="form-label">咨询内容</text>
      <textarea class="form-textarea" placeholder="请详细描述您的法律问题，以便律师更好地为您解答..." maxlength="500" bindinput="onContentInput" style="position: relative; left: -22rpx; top: 0rpx"></textarea>
    </view>
    
    <view class="form-item">
      <text class="form-label">联系方式</text>
      <input class="form-input" placeholder="请留下您的手机号，方便律师联系您" type="number" bindinput="onPhoneInput" style="width: 585rpx; display: block; box-sizing: border-box"></input>
    </view>
    
    <view class="form-item">
      <text class="form-label">咨询类型</text>
      <picker class="form-picker" range="{{consultTypes}}" value="{{consultTypeIndex}}" bindchange="onTypeChange" style="width: 607rpx; display: flex; box-sizing: border-box">
        <view class="picker-view">{{consultTypes[consultTypeIndex] || '请选择咨询类型'}}</view>
      </picker>
    </view>
    
    <button class="submit-btn" bindtap="submitConsult" loading="{{submitting}}" disabled="{{submitting}}">提交咨询</button>
  </view>

  <!-- 常见问题 -->
  <view class="faq-section">
    <text class="faq-title">常见问题</text>
    <view class="faq-list">
      <view class="faq-item">
        <text class="faq-question">如何选择适合的律师？</text>
        <text class="faq-answer">根据您的案件类型，选择有相关经验的律师，查看律师的专业领域和成功案例。</text>
      </view>
      <view class="faq-item">
        <text class="faq-question">咨询费用如何计算？</text>
        <text class="faq-answer">首次在线咨询免费，后续咨询根据律师的收费标准而定，具体可与律师协商。</text>
      </view>
      <view class="faq-item">
        <text class="faq-question">咨询回复时间？</text>
        <text class="faq-answer">一般情况下，律师会在24小时内回复您的咨询，紧急情况可选择电话咨询。</text>
      </view>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="bottom-tip">
    <text class="tip-text">专业律师团队 · 24小时在线服务</text>
  </view>
</view>
