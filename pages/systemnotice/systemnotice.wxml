<view class="container">
  <view class="page-heading">
    <text class="heading-title">系统通知</text>
    <text class="heading-copy">查看服务处理和平台消息</text>
  </view>

  <view wx:if="{{loading}}" class="state-panel">加载中...</view>
  <view wx:elif="{{notice}}" class="notice-panel">
    <text class="notice-title">{{notice.title}}</text>
    <text class="notice-time">{{notice.createdTime}}</text>
    <view class="notice-divider"></view>
    <text class="notice-content">{{notice.content}}</text>
  </view>
  <view wx:else class="state-panel">通知不存在或已删除</view>
</view>
