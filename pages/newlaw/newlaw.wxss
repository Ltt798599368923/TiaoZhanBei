.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  background: linear-gradient(180deg, #73d13d 0%, #95de64 100%);
  padding: 40rpx 30rpx;
  text-align: center;
}

.header-title {
  display: block;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: bold;
}

.header-subtitle {
  display: block;
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  margin-top: 10rpx;
}

.law-list {
  padding: 20rpx;
}

.law-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
}

.law-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.law-title {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  font-weight: bold;
  line-height: 1.4;
}

.law-effect {
  font-size: 22rpx;
  color: #73d13d;
  background-color: #f6ffed;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 16rpx;
  white-space: nowrap;
}

.law-summary {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.law-footer {
  display: flex;
  justify-content: flex-end;
}

.law-date {
  font-size: 24rpx;
  color: #999999;
}
