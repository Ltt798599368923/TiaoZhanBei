/**
 * 法治新程页面样式
 */

/* 全局容器样式 */
.container {
  min-height: 100vh;          /* 最小高度为屏幕高度 */
  background-color: #f5f5f5;  /* 背景色为浅灰色 */
}

/* 头部区域样式 */
.header {
  background: linear-gradient(180deg, #73d13d 0%, #95de64 100%);  /* 渐变背景 */
  padding: 40rpx 30rpx;        /* 内边距 */
  text-align: center;          /* 文本居中 */
}

/* 头部标题样式 */
.header-title {
  display: block;              /* 块级元素 */
  color: #ffffff;              /* 文字颜色为白色 */
  font-size: 40rpx;            /* 字体大小 */
  font-weight: bold;           /* 字体加粗 */
}

/* 头部副标题样式 */
.header-subtitle {
  display: block;              /* 块级元素 */
  color: rgba(255, 255, 255, 0.85);  /* 半透明白色文字 */
  font-size: 26rpx;            /* 字体大小 */
  margin-top: 10rpx;           /* 顶部margin */
}

/* 法律法规列表区域样式 */
.law-list {
  padding: 20rpx;              /* 内边距 */
}

/* 法律项样式 */
.law-item {
  background-color: #ffffff;    /* 背景色为白色 */
  border-radius: 16rpx;         /* 圆角 */
  padding: 28rpx 24rpx;         /* 内边距 */
  margin-bottom: 16rpx;         /* 底部margin */
}

/* 法律头部信息样式 */
.law-header {
  display: flex;                /* 使用flex布局 */
  justify-content: space-between;  /* 两端对齐 */
  align-items: flex-start;      /* 顶部对齐 */
  margin-bottom: 12rpx;         /* 底部margin */
}

/* 法律标题样式 */
.law-title {
  flex: 1;                     /* 占满剩余空间 */
  font-size: 30rpx;            /* 字体大小 */
  color: #333333;              /* 文字颜色 */
  font-weight: bold;           /* 字体加粗 */
  line-height: 1.4;            /* 行高 */
}

/* 法律生效状态样式 */
.law-effect {
  font-size: 22rpx;            /* 字体大小 */
  color: #73d13d;              /* 文字颜色 */
  background-color: #f6ffed;    /* 背景色 */
  padding: 4rpx 12rpx;          /* 内边距 */
  border-radius: 6rpx;          /* 圆角 */
  margin-left: 16rpx;          /* 左侧margin */
  white-space: nowrap;          /* 不换行 */
}

/* 法律摘要样式 */
.law-summary {
  display: block;              /* 块级元素 */
  font-size: 26rpx;            /* 字体大小 */
  color: #666666;              /* 文字颜色 */
  line-height: 1.5;            /* 行高 */
  margin-bottom: 12rpx;         /* 底部margin */
}

/* 法律底部信息样式 */
.law-footer {
  display: flex;                /* 使用flex布局 */
  justify-content: flex-end;    /* 右对齐 */
}

/* 法律日期样式 */
.law-date {
  font-size: 24rpx;            /* 字体大小 */
  color: #999999;              /* 文字颜色 */
}
