.container{min-height:100vh;padding:24rpx;background:#f4f5f7;box-sizing:border-box}.law-list{overflow:hidden;border:1rpx solid #e1e4e8;border-radius:8rpx;background:#fff}.law-item{padding:24rpx;border-bottom:1rpx solid #eceef0}.law-item:last-child{border:0}.law-item:active{background:#fff7f6}.law-header,.law-footer{display:flex;justify-content:space-between;gap:16rpx}.law-title{flex:1;color:#30343a;font-size:29rpx;font-weight:700;line-height:1.45}.law-effect{flex-shrink:0;color:#a61d18;font-size:22rpx}.law-summary{display:block;margin-top:12rpx;color:#707780;font-size:25rpx;line-height:1.65}.law-footer{margin-top:14rpx}.law-date{color:#949aa2;font-size:22rpx}.empty-state{padding:60rpx 24rpx;color:#858b93;font-size:26rpx;text-align:center}
