<view class="container">
  <view class="page-heading">
    <text class="heading-title">法治新程</text>
    <text class="heading-copy">关注已发布的法律法规动态</text>
  </view>

  <!-- 法律法规列表区域 -->
  <view class="law-list">
    <view wx:if="{{loading}}" class="state-panel">内容加载中...</view>
    <view wx:elif="{{loadError}}" class="state-panel">{{loadError}}</view>
    <view wx:elif="{{laws.length === 0}}" class="empty-state"><view class="empty-mark">法</view><text>暂未发布法规动态</text><text class="empty-copy">新发布的法律法规会在这里展示</text></view>
    <block wx:else>
    <view class="law-item" wx:for="{{laws}}" wx:key="id" bindtap="onLawTap" data-id="{{item.id}}">
      <!-- 法律头部信息 -->
      <view class="law-header">
        <text class="law-title">{{item.title}}</text>
        <text class="law-effect">{{item.sourceName || '已发布'}}</text>
      </view>
      <!-- 法律摘要 -->
      <text class="law-summary">{{item.summary}}</text>
      <!-- 法律底部信息 -->
      <view class="law-footer">
        <text class="law-date">发布日期：{{item.publishedTime || item.createdTime}}</text>
      </view>
    </view>
    </block>
  </view>
</view>
