<!-- 法治新程页面结构 -->
<view class="container">
  <!-- 头部区域 -->
  <view class="header" style="background: linear-gradient(135deg, #f5222d, #ff4d4f); width: 100%; padding: 50rpx; box-sizing: border-box; color: white; height: 175rpx; display: block; left: 0rpx; top: 0rpx">
    <view style="display: flex; align-items: center; margin-bottom: 16rpx;">
      <view bindtap="goBack" style="width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; position: relative; left: 0rpx; top: 30rpx">←</view>
      <text style="flex: 1; text-align: center; padding-right: 60rpx; font-size: 34rpx; font-weight: bold; position: relative; left: 0rpx; top: 9rpx">法治新程</text>
    </view>
    <text style="display: block; text-align: center; font-size: 24rpx; opacity: 0.8;">最新法律法规动态</text>
  </view>

  <!-- 法律法规列表区域 -->
  <view class="law-list">
    <!-- 法律项 - 循环渲染法律法规列表 -->
    <view class="law-item" wx:for="{{laws}}" wx:key="id" bindtap="onLawTap" data-id="{{item.id}}">
      <!-- 法律头部信息 -->
      <view class="law-header">
        <text class="law-title">{{item.title}}</text>
        <text class="law-effect">{{item.effect}}</text>
      </view>
      <!-- 法律摘要 -->
      <text class="law-summary">{{item.summary}}</text>
      <!-- 法律底部信息 -->
      <view class="law-footer">
        <text class="law-date">发布日期：{{item.date}}</text>
      </view>
    </view>
  </view>
</view>
