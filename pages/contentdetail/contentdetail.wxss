.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 56rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}

.article-head {
  padding: 16rpx 8rpx 28rpx;
}

.type-label {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  color: #b51d1b;
  background: #fff0ef;
  border-radius: 22rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.title {
  display: block;
  margin-top: 20rpx;
  color: #202124;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.42;
}

.meta {
  display: flex;
  gap: 22rpx;
  margin-top: 18rpx;
  color: #8b9199;
  font-size: 24rpx;
  line-height: 1.5;
}

.cover {
  display: block;
  width: 100%;
  max-height: 520rpx;
  margin: 0 0 26rpx;
  border-radius: 10rpx;
  background: #e9e9e9;
}

.summary {
  margin-bottom: 26rpx;
  padding: 24rpx;
  color: #5d6269;
  background: #ffffff;
  border-left: 6rpx solid #df302b;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.75;
  box-sizing: border-box;
}

.body {
  padding: 30rpx 28rpx;
  color: #30343a;
  background: #ffffff;
  border-radius: 10rpx;
  font-size: 31rpx;
  line-height: 1.9;
  white-space: pre-wrap;
  box-sizing: border-box;
}

.video-wrap {
  overflow: hidden;
  margin: 0 0 26rpx;
  border-radius: 10rpx;
  background: #1d1d1d;
}

.video {
  display: block;
  width: 100%;
}

.resource-panel {
  margin-top: 26rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.resource-title {
  display: block;
  margin-bottom: 18rpx;
  color: #25282d;
  font-size: 30rpx;
  font-weight: 700;
}

.resource-button {
  display: flex;
  width: 100%;
  min-height: 92rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  border: 0;
  border-radius: 10rpx;
  font-size: 28rpx;
  line-height: 1.2;
  text-align: left;
  box-sizing: border-box;
}

.resource-button::after,
.retry-button::after {
  border: 0;
}

.resource-button + .resource-button {
  margin-top: 16rpx;
}

.resource-button.primary {
  color: #ffffff;
  background: #d92320;
}

.resource-button.secondary {
  color: #b51d1b;
  background: #fff4f3;
}

.button-name {
  flex: 0 0 auto;
  font-weight: 600;
}

.button-tip {
  overflow: hidden;
  margin-left: 22rpx;
  color: inherit;
  font-size: 24rpx;
  opacity: 0.72;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-content,
.state-panel {
  display: flex;
  min-height: 260rpx;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  color: #7a818a;
  background: #ffffff;
  border-radius: 10rpx;
  font-size: 28rpx;
  text-align: center;
  box-sizing: border-box;
}

.state-panel {
  min-height: 360rpx;
  flex-direction: column;
}

.error-panel {
  color: #8b5050;
}

.retry-button {
  display: flex;
  min-width: 190rpx;
  min-height: 74rpx;
  align-items: center;
  justify-content: center;
  margin-top: 26rpx;
  color: #ffffff;
  background: #d92320;
  border-radius: 38rpx;
  font-size: 27rpx;
  line-height: 1;
}
