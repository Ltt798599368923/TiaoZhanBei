/**
 * 律师咨询与预约页面样式
 */

/* 全局容器样式 */
.container {
  display: flex;                /* 使用flex布局 */
  flex-direction: column;       /* 垂直方向排列 */
  align-items: center;          /* 水平居中 */
  min-height: 100vh;            /* 最小高度为屏幕高度 */
  background-color: #f5f5f5;    /* 背景色为浅灰色 */
}

/* 服务项样式 */
.service-item {
  transition: all 0.3s ease;    /* 过渡动画效果 */
}

/* 服务项点击效果 */
.service-item:active {
  transform: scale(0.98);       /* 点击时缩小 */
  opacity: 0.9;                 /* 点击时半透明 */
}