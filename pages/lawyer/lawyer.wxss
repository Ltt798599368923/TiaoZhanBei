.container {
  display: block;
  min-height: 100vh;
  padding: 28rpx 24rpx 56rpx;
  background: #f4f5f7;
  box-sizing: border-box;
}

.lawyer-intro {
  width: 100%;
  padding: 32rpx;
  background: #ffffff;
  border-left: 8rpx solid #c0190e;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.intro-kicker {
  display: block;
  color: #a61d18;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.intro-title {
  display: block;
  margin-top: 10rpx;
  color: #202124;
  font-size: 38rpx;
  font-weight: 700;
}

.intro-copy {
  display: block;
  margin-top: 14rpx;
  color: #6b7078;
  font-size: 27rpx;
  line-height: 1.7;
}

.lawyer-list {
  width: 100%;
  margin-top: 28rpx;
  box-sizing: border-box;
}

.list-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 16rpx;
  color: #272a2f;
  font-size: 30rpx;
  font-weight: 600;
}

.list-count {
  color: #818791;
  font-size: 24rpx;
  font-weight: 400;
}

.lawyer-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #e8eaed;
  border-radius: 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(32, 33, 36, 0.05);
}

.lawyer-main {
  display: flex;
  min-width: 0;
}

.lawyer-avatar {
  width: 112rpx;
  height: 112rpx;
  margin-right: 22rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #fcebea;
  color: #a61d18;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 112rpx;
  font-size: 38rpx;
  font-weight: 600;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.lawyer-copy {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.lawyer-name {
  color: #202124;
  font-size: 33rpx;
  font-weight: 700;
}

.availability {
  padding: 3rpx 10rpx;
  border-radius: 4rpx;
  background: #edf7f1;
  color: #237a4c;
  font-size: 21rpx;
}

.lawyer-firm {
  display: block;
  margin-top: 9rpx;
  color: #626871;
  font-size: 25rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.specialty-row {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 14rpx;
}

.specialty-label {
  flex: 0 0 auto;
  margin-right: 8rpx;
  color: #858b95;
  font-size: 23rpx;
}

.lawyer-specialties {
  min-width: 0;
  color: #4f555e;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.reserve-button {
  width: 100%;
  height: 76rpx;
  margin: 26rpx 0 0;
  border-radius: 6rpx;
  background: #bd1d17;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.reserve-button::after {
  border: 0;
}

.reserve-button:active {
  background: #9f1712;
}

.empty-state {
  margin-top: 12rpx;
  padding: 92rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid #e8eaed;
  border-radius: 10rpx;
  color: #7b818b;
  font-size: 27rpx;
  text-align: center;
}
