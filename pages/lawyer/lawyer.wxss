/**
 * 律师咨询与预约页面样式
 */

/* 全局容器样式 */
.container {
  display: flex;                /* 使用flex布局 */
  flex-direction: column;       /* 垂直方向排列 */
  align-items: center;          /* 水平居中 */
  min-height: 100vh;            /* 最小高度为屏幕高度 */
  background-color: #f5f5f5;    /* 背景色为浅灰色 */
}

/* 服务项样式 */
.service-item {
  transition: all 0.3s ease;    /* 过渡动画效果 */
}

/* 服务项点击效果 */
.service-item:active {
  transform: scale(0.98);       /* 点击时缩小 */
  opacity: 0.9;                 /* 点击时半透明 */
}

.lawyer-intro,
.lawyer-list {
  margin: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.lawyer-intro {
  border-left: 8rpx solid #c0190e;
}

.intro-title,
.lawyer-name {
  display: block;
  color: #222222;
  font-size: 32rpx;
  font-weight: 600;
}

.intro-copy,
.lawyer-firm,
.lawyer-specialties {
  display: block;
  margin-top: 12rpx;
  color: #666666;
  font-size: 26rpx;
  line-height: 1.6;
}

.lawyer-card {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.lawyer-card:last-child {
  border-bottom: 0;
}

.lawyer-avatar {
  width: 88rpx;
  height: 88rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #fff1f0;
  color: #c0190e;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 88rpx;
}

.lawyer-avatar image {
  width: 100%;
  height: 100%;
}

.lawyer-copy {
  flex: 1;
  min-width: 0;
}

.lawyer-specialties {
  color: #8c8c8c;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.reserve-button {
  margin: 0 0 0 16rpx;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 12rpx;
  background: #c0190e;
  color: #ffffff;
  font-size: 26rpx;
}
