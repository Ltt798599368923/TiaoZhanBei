<!-- 律师咨询与预约页面结构 -->
<view class="container">
  <!-- 顶部标题区域 -->
  <view style="background-color: #DE1E1D; width: 100%; padding: 15px; display: flex; align-items: center; color: white; font-size: 18px; font-weight: bold; height: 180rpx; box-sizing: border-box">
    <view bindtap="goBack" style="margin-right: 15px; font-size: 20px; position: relative; left: 29rpx; top: 29rpx">←</view>
    <text style="position: relative; left: 189rpx; top: 27rpx">律师预约</text>
  </view>

  <!-- 服务介绍区域 -->
  <view style="padding: 20px; background-color: white; margin: 10px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); height: 623rpx; display: block; box-sizing: border-box">
    <view style="text-align: center; margin-bottom: 20px;">
      <view style="font-size: 48px; margin-bottom: 15px; position: relative; left: 0rpx; top: -48rpx">👨‍⚖️</view>
      <text style="font-size: 20px; font-weight: bold; color: #333; position: relative; left: 0rpx; top: -58rpx">专业律师预约服务</text>
    </view>
    <view style="font-size: 14px; line-height: 1.6; color: #666; margin-bottom: 20px;">
      <text style="position: relative; left: 0rpx; top: -92rpx">我们提供专业的律师面对面咨询服务，为您提供个性化的法律解决方案。通过预约，您可以与专业律师进行深度沟通，获得针对性的法律建议。</text>
    </view>
    <view style="display: flex; justify-content: space-around; margin-bottom: 20px; position: relative; left: 0rpx; top: -100rpx">
      <view style="text-align: center;">
        <view style="font-size: 24px; margin-bottom: 5px;">📅</view>
        <text style="font-size: 12px; color: #666;">预约咨询</text>
      </view>
      <view style="text-align: center;">
        <view style="font-size: 24px; margin-bottom: 5px;">🏢</view>
        <text style="font-size: 12px; color: #666;">线下会面</text>
      </view>
      <view style="text-align: center;">
        <view style="font-size: 24px; margin-bottom: 5px;">📋</view>
        <text style="font-size: 12px; color: #666;">定制方案</text>
      </view>
    </view>
  </view>

  <!-- 律师列表区域 -->
  <view style="padding: 20px; background-color: white; margin: 10px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <text style="font-size: 16px; font-weight: bold; margin-bottom: 15px; display: block;">推荐律师</text>
    
    <!-- 律师项 - 张律师 -->
    <view style="border-bottom: 1px solid #f0f0f0; padding: 15px 0;">
      <view style="display: flex; align-items: center; margin-bottom: 10px;">
        <view style="width: 60px; height: 60px; border-radius: 50%; background-color: #f5f5f5; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
          <text style="font-size: 24px;">👨‍⚖️</text>
        </view>
        <view style="flex: 1;">
          <text style="font-size: 16px; font-weight: bold; margin-bottom: 5px; display: block;">张律师</text>
          <text style="font-size: 12px; color: #666; margin-bottom: 5px; display: block;">擅长领域：民事纠纷、合同纠纷</text>
          <view style="display: flex; align-items: center;">
            <text style="font-size: 12px; color: #ff7a45; margin-right: 5px;">⭐⭐⭐⭐⭐</text>
            <text style="font-size: 12px; color: #999;">5.0分</text>
          </view>
        </view>
      </view>
      <view style="display: flex; justify-content: space-between;">
        <text style="font-size: 12px; color: #999;">咨询费：¥300/小时</text>
        <button bindtap="reserveLawyer" data-id="1" style="background-color: #DE1E1D; color: white; border: none; padding: 8px 20px; border-radius: 16px; font-size: 14px;">立即预约</button>
      </view>
    </view>
    
    <!-- 律师项 - 李律师 -->
    <view style="border-bottom: 1px solid #f0f0f0; padding: 15px 0;">
      <view style="display: flex; align-items: center; margin-bottom: 10px;">
        <view style="width: 60px; height: 60px; border-radius: 50%; background-color: #f5f5f5; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
          <text style="font-size: 24px;">👩‍⚖️</text>
        </view>
        <view style="flex: 1;">
          <text style="font-size: 16px; font-weight: bold; margin-bottom: 5px; display: block;">李律师</text>
          <text style="font-size: 12px; color: #666; margin-bottom: 5px; display: block;">擅长领域：刑事辩护、知识产权</text>
          <view style="display: flex; align-items: center;">
            <text style="font-size: 12px; color: #ff7a45; margin-right: 5px;">⭐⭐⭐⭐</text>
            <text style="font-size: 12px; color: #999;">4.8分</text>
          </view>
        </view>
      </view>
      <view style="display: flex; justify-content: space-between;">
        <text style="font-size: 12px; color: #999;">咨询费：¥400/小时</text>
        <button bindtap="reserveLawyer" data-id="2" style="background-color: #DE1E1D; color: white; border: none; padding: 8px 20px; border-radius: 16px; font-size: 14px;">立即预约</button>
      </view>
    </view>
    
    <!-- 律师项 - 王律师 -->
    <view style="padding: 15px 0;">
      <view style="display: flex; align-items: center; margin-bottom: 10px;">
        <view style="width: 60px; height: 60px; border-radius: 50%; background-color: #f5f5f5; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
          <text style="font-size: 24px;">👨‍⚖️</text>
        </view>
        <view style="flex: 1;">
          <text style="font-size: 16px; font-weight: bold; margin-bottom: 5px; display: block;">王律师</text>
          <text style="font-size: 12px; color: #666; margin-bottom: 5px; display: block;">擅长领域：婚姻家庭、房产纠纷</text>
          <view style="display: flex; align-items: center;">
            <text style="font-size: 12px; color: #ff7a45; margin-right: 5px;">⭐⭐⭐⭐⭐</text>
            <text style="font-size: 12px; color: #999;">4.9分</text>
          </view>
        </view>
      </view>
      <view style="display: flex; justify-content: space-between;">
        <text style="font-size: 12px; color: #999;">咨询费：¥350/小时</text>
        <button bindtap="reserveLawyer" data-id="3" style="background-color: #DE1E1D; color: white; border: none; padding: 8px 20px; border-radius: 16px; font-size: 14px;">立即预约</button>
      </view>
    </view>
  </view>

  <!-- 预约流程 -->
  <view style="padding: 20px; background-color: white; margin: 10px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); width: 646rpx; display: block; box-sizing: border-box">
    <text style="font-size: 16px; font-weight: bold; margin-bottom: 15px; display: block;">预约流程</text>
    <view style="display: flex; justify-content: space-between; align-items: center;">
      <view style="text-align: center; flex: 1;">
        <view style="width: 30px; height: 30px; border-radius: 50%; background-color: #DE1E1D; color: white; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;">1</view>
        <text style="font-size: 12px; color: #333;">选择律师</text>
      </view>
      <view style="width: 20px; height: 1px; background-color: #e8e8e8;"></view>
      <view style="text-align: center; flex: 1;">
        <view style="width: 30px; height: 30px; border-radius: 50%; background-color: #DE1E1D; color: white; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;">2</view>
        <text style="font-size: 12px; color: #333;">提交预约</text>
      </view>
      <view style="width: 20px; height: 1px; background-color: #e8e8e8;"></view>
      <view style="text-align: center; flex: 1;">
        <view style="width: 30px; height: 30px; border-radius: 50%; background-color: #DE1E1D; color: white; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;">3</view>
        <text style="font-size: 12px; color: #333;">确认时间</text>
      </view>
      <view style="width: 20px; height: 1px; background-color: #e8e8e8;"></view>
      <view style="text-align: center; width: 109rpx; height: 172rpx; display: block; box-sizing: border-box">
        <view style="width: 30px; height: 30px; border-radius: 50%; background-color: #DE1E1D; color: white; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;">4</view>
        <text style="font-size: 12px; color: #333;">面对面咨询</text>
      </view>
    </view>
  </view>
</view>