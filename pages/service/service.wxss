/**
 * 服务中心页面样式
 */

/* 全局容器样式 */
.container {
  display: flex;                /* 使用flex布局 */
  flex-direction: column;       /* 垂直方向排列 */
  align-items: center;          /* 水平居中 */
  justify-content: flex-start;  /* 垂直顶部对齐 */
  min-height: 100vh;            /* 最小高度为屏幕高度 */
  background-color: #f5f5f5;    /* 背景色为浅灰色 */
}

/* 服务项样式 */
.service-item {
  background-color: #f5222d;     /* 背景色为红色 */
  color: white;                 /* 文字颜色为白色 */
  padding: 20px;                /* 内边距 */
  border-radius: 10px;          /* 圆角 */
  margin-bottom: 15px;          /* 底部margin */
  text-align: center;           /* 文本居中 */
  font-size: 16px;              /* 字体大小 */
  width: 100%;                  /* 宽度100% */
}