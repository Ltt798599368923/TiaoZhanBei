.page{min-height:100vh;padding:24rpx;background:#f4f5f7;box-sizing:border-box}.service-name,.service-desc{display:block}.service-list{overflow:hidden;border:1rpx solid #e1e4e8;border-radius:8rpx;background:#fff}.service-row{display:flex;align-items:center;gap:20rpx;min-height:132rpx;padding:20rpx 24rpx;border-bottom:1rpx solid #eceef0;box-sizing:border-box}.service-row:last-child{border:0}.service-row:active{background:#fff7f6}.service-icon{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;border-radius:8rpx;background:#fff1f0;font-size:30rpx;flex-shrink:0}.service-copy{min-width:0;flex:1}.service-name{color:#30343a;font-size:29rpx;font-weight:700}.service-desc{margin-top:8rpx;overflow:hidden;color:#747b84;font-size:23rpx;line-height:1.45;text-overflow:ellipsis;white-space:nowrap}.arrow{color:#a61d18;font-size:30rpx}
