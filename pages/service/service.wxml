<!-- 服务中心页面结构 -->
<view class="container">
  <app-header title="服务中心" />
  <!-- 顶部标题区域 -->
  <view wx:if="{{false}}" style="background: linear-gradient(135deg, #f5222d, #ff4d4f); width: 100%; padding: 45rpx 30rpx; display: flex; align-items: center; justify-content: center; color: white; font-size: 34rpx; font-weight: bold; box-sizing: border-box;">
    服务中心
  </view>

  <!-- 服务列表区域 -->
  <view style="width: 75%; margin-top: 20px; margin-bottom: 20px; display: flex; flex-direction: column; align-items: center;">
    <!-- 律师咨询与预约服务项 -->
    <view class="service-item" bindtap="handleServiceTap" data-id="1" style="background: linear-gradient(135deg, #f5222d 0%, #ff4d4f 100%); color: white; padding: 25px; border-radius: 20px; margin-bottom: 15px; text-align: center; font-size: 16px; font-weight: 600; width: 100%; max-width: 320px; box-shadow: 0 6px 18px rgba(245,34,45,0.4); transition: all 0.3s ease; position: relative; overflow: hidden;">
      <view style="position: absolute; top: 10px; right: 10px; font-size: 40px; opacity: 0.1;">👨‍⚖️</view>
      <view style="font-size: 30px; margin-bottom: 10px; position: relative; z-index: 1;">👨‍⚖️</view>
      <text style="position: relative; z-index: 1;">律师咨询与预约</text>
      <view style="font-size: 12px; opacity: 0.9; margin-top: 8px; position: relative; z-index: 1;">专业律师在线解答，一键预约</view>
    </view>
    
    <!-- 官方服务入口服务项 -->
    <view class="service-item" bindtap="handleServiceTap" data-id="2" style="background: linear-gradient(135deg, #faad14 0%, #ffd666 100%); color: white; padding: 25px; border-radius: 20px; margin-bottom: 15px; text-align: center; font-size: 16px; font-weight: 600; width: 100%; max-width: 320px; box-shadow: 0 6px 18px rgba(250,173,20,0.4); transition: all 0.3s ease; position: relative; overflow: hidden;">
      <view style="position: absolute; top: 10px; right: 10px; font-size: 40px; opacity: 0.1;">🏛️</view>
      <view style="font-size: 30px; margin-bottom: 10px; position: relative; z-index: 1;">🏛️</view>
      <text style="position: relative; z-index: 1;">官方服务入口</text>
      <view style="font-size: 12px; opacity: 0.9; margin-top: 8px; position: relative; z-index: 1;">政府法律服务官方通道</view>
    </view>
    
    <!-- 法律文书代写服务项 -->
    <view class="service-item" bindtap="handleServiceTap" data-id="3" style="background: linear-gradient(135deg, #ff7a45 0%, #ffa940 100%); color: white; padding: 25px; border-radius: 20px; margin-bottom: 15px; text-align: center; font-size: 16px; font-weight: 600; width: 100%; max-width: 320px; box-shadow: 0 6px 18px rgba(255,122,69,0.4); transition: all 0.3s ease; position: relative; overflow: hidden;">
      <view style="position: absolute; top: 10px; right: 10px; font-size: 40px; opacity: 0.1;">📄</view>
      <view style="font-size: 30px; margin-bottom: 10px; position: relative; z-index: 1;">📄</view>
      <text style="position: relative; z-index: 1;">法律文书代写</text>
      <view style="font-size: 12px; opacity: 0.9; margin-top: 8px; position: relative; z-index: 1;">专业律师帮您起草各类法律文书</view>
    </view>
    
    <!-- 合同审查服务服务项 -->
    <view class="service-item" bindtap="handleServiceTap" data-id="4" style="background: linear-gradient(135deg, #faad14 0%, #ffd666 100%); color: white; padding: 25px; border-radius: 20px; margin-bottom: 15px; text-align: center; font-size: 16px; font-weight: 600; width: 100%; max-width: 320px; box-shadow: 0 6px 18px rgba(250,173,20,0.4); transition: all 0.3s ease; position: relative; overflow: hidden;">
      <view style="position: absolute; top: 10px; right: 10px; font-size: 40px; opacity: 0.1;">🔍</view>
      <view style="font-size: 30px; margin-bottom: 10px; position: relative; z-index: 1;">🔍</view>
      <text style="position: relative; z-index: 1;">合同审查服务</text>
      <view style="font-size: 12px; opacity: 0.9; margin-top: 8px; position: relative; z-index: 1;">专业律师审查合同，规避法律风险</view>
    </view>
    
    <!-- 企业法律服务服务项 -->
    <view class="service-item" bindtap="handleServiceTap" data-id="5" style="background: linear-gradient(135deg, #f5222d 0%, #ff4d4f 100%); color: white; padding: 25px; border-radius: 20px; margin-bottom: 15px; text-align: center; font-size: 16px; font-weight: 600; width: 100%; max-width: 320px; box-shadow: 0 6px 18px rgba(245,34,45,0.4); transition: all 0.3s ease; position: relative; overflow: hidden;">
      <view style="position: absolute; top: 10px; right: 10px; font-size: 40px; opacity: 0.1;">💼</view>
      <view style="font-size: 30px; margin-bottom: 10px; position: relative; z-index: 1;">💼</view>
      <text style="position: relative; z-index: 1;">企业法律服务</text>
      <view style="font-size: 12px; opacity: 0.9; margin-top: 8px; position: relative; z-index: 1;">为企业提供全方位法律服务</view>
    </view>
  </view>
</view>
