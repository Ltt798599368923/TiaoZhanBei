<!--document.wxml-->
<!-- 文书模板页面结构 -->
<view class="container" style="background-color: #F5F4F0; min-height: 100vh; padding-bottom: 100rpx;">
  <!-- 顶部 Header -->
  <view style="background: linear-gradient(135deg, #f5222d, #ff4d4f); width: 100%; padding: 50rpx; box-sizing: border-box; text-align: center; color: white;">
    <view style="display: flex; align-items: center; margin-bottom: 20rpx;">
      <view bindtap="goBack" style="width: 60rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; position: relative; left: 0rpx; top: 22rpx">←</view>
      <text style="flex: 1; text-align: center; padding-right: 60rpx; font-size: 34rpx; font-weight: bold; position: relative; left: 0rpx; top: 22rpx">法律文书代写</text>
    </view>
    <text style="font-size: 24rpx; opacity: 0.9;">律师专业代写 · 合法合规 · 高效保密</text>
    <!-- 搜索框 -->
    <view style="width: 100%; padding: 0 20rpx; margin-top: 20rpx;">
      <view style="background-color: rgba(255,255,255,0.2); border-radius: 30px; padding: 12px 16px; display: flex; align-items: center;">
        <text style="font-size: 16px; color: rgba(255,255,255,0.8); margin-right: 8px;">🔍</text>
        <text style="font-size: 14px; color: rgba(255,255,255,0.8); flex: 1;">搜索文书模板…</text>
      </view>
    </view>
  </view>

  <!-- 文书类型区块 -->
  <view style="padding: 20rpx 10rpx; margin-bottom: 15rpx;">
    <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15rpx; padding: 0 10rpx;">
      <text style="font-size: 32rpx; font-weight: bold; color: #1a1a1a;">文书类型</text>
      <view bindtap="viewAllTemplates" style="display: flex; align-items: center; font-size: 24rpx; color: #C0190E;">
        <text>全部模板</text>
        <text style="margin-left: 8rpx;">〉</text>
      </view>
    </view>
    <view style="display: flex; flex-wrap: wrap; gap: 15rpx; padding: 0 10rpx;">
      <view bindtap="selectCategory" data-id="{{item.id}}" wx:for="{{categories}}" wx:key="id" style="background-color: white; border-radius: 14px; padding: 20rpx; border: 0.5px solid #f0f0f0; display: flex; flex-direction: column; align-items: center; justify-content: center; width: calc(33.33% - 10rpx); box-sizing: border-box">
        <view style="width: 50rpx; height: 50rpx; background-color: #FFF0EF; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 10rpx;">
          <text style="font-size: 24rpx; color: #C0190E;">{{item.icon || '📄'}}</text>
        </view>
        <text style="font-size: 24rpx; color: #1a1a1a; margin-bottom: 6rpx;">{{item.name}}</text>
        <text style="font-size: 28rpx; font-weight: bold; color: #C0190E; margin-bottom: 2rpx;">{{item.count}}</text>
        <text style="font-size: 20rpx; color: #999;">可用模板</text>
      </view>
    </view>
  </view>

  <!-- 热门推荐区块 -->
  <view style="padding: 0 10rpx; margin-bottom: 20rpx;">
    <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15rpx; padding: 0 10rpx;">
      <view style="display: flex; align-items: center;">
        <view style="width: 10rpx; height: 10rpx; background-color: #FF9500; border-radius: 50%; margin-right: 10rpx;"></view>
        <text style="font-size: 32rpx; font-weight: bold; color: #1a1a1a;">热门推荐</text>
      </view>
      <view bindtap="viewMoreDocuments" style="display: flex; align-items: center; font-size: 24rpx; color: #1a1a1a;">
        <text>更多</text>
        <text style="margin-left: 8rpx;">〉</text>
      </view>
    </view>
    <view style="display: flex; flex-direction: column; gap: 12rpx; padding: 0 10rpx;">
      <view bindtap="onDocumentTap" data-id="{{item.id}}" wx:for="{{documents}}" wx:key="id" wx:if="{{index < 3}}" style="background-color: white; border-radius: 14px; padding: 20rpx; border: 0.5px solid #f0f0f0; display: flex; align-items: center; justify-content: space-between;">
        <view style="width: 50rpx; height: 50rpx; background-color: #FFF0EF; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; margin-right: 15rpx;">
          <text style="font-size: 24rpx; color: #C0190E;">📄</text>
        </view>
        <view style="flex: 1; margin-right: 15rpx;">
          <text style="font-size: 28rpx; font-weight: bold; color: #1a1a1a; margin-bottom: 6rpx; display: block;">{{item.title}}</text>
          <view style="display: flex; align-items: center; gap: 10rpx;">
            <view style="background-color: #C0190E; color: white; padding: 4rpx 10rpx; border-radius: 12rpx; font-size: 20rpx;">{{item.category}}</view>
            <text style="font-size: 24rpx; color: #999; display: flex; align-items: center;">
              <text style="margin-right: 4rpx;">👀</text>
              {{item.download}}次
            </text>
          </view>
        </view>
        <view bindtap="useDocument" data-id="{{item.id}}" style="background-color: #1a1a1a; color: white; padding: 8rpx 20rpx; border-radius: 30rpx; font-size: 24rpx; font-weight: 500;">
          立即使用
        </view>
      </view>
    </view>
  </view>
</view>
