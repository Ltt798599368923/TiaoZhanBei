.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  background: linear-gradient(135deg, #ff7a45 0%, #ffa940 100%);
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.header-title {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
  text-align: center;
  width: 100%;
}

.service-intro {
  background-color: white;
  margin: 10rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.intro-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.intro-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 15rpx;
  display: block;
}

.intro-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
}

.category-section {
  background-color: white;
  margin: 10rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  display: block;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.category-item {
  width: 23%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  margin-bottom: 15rpx;
  transition: all 0.3s ease;
}

.category-item:hover {
  background-color: #ff7a45;
  color: white;
  transform: translateY(-2rpx);
  box-shadow: 0 4px 12px rgba(255,122,69,0.3);
}

.category-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.category-name {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 5rpx;
  text-align: center;
}

.category-item:hover .category-name {
  color: white;
}

.category-count {
  font-size: 20rpx;
  color: #999999;
}

.category-item:hover .category-count {
  color: rgba(255,255,255,0.8);
}

.doc-section {
  background-color: white;
  margin: 10rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.doc-list {
  margin-top: 10rpx;
}

.doc-item {
  background-color: #f9f9f9;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.3s ease;
}

.doc-item:hover {
  background-color: #f0f0f0;
  transform: translateX(5rpx);
}

.doc-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.doc-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.doc-category {
  font-size: 24rpx;
  color: #999999;
}

.doc-action {
  display: flex;
  align-items: center;
}

.doc-download {
  font-size: 24rpx;
  color: #ff7a45;
  font-weight: 500;
}

.bottom-tip {
  padding: 20rpx;
  text-align: center;
  margin: 10rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999999;
}
