<view class="page">
  <view class="page-lead">
    <text class="lead-kicker">权威法律资源</text>
    <text class="lead-title">官方服务入口</text>
    <text class="lead-copy">以下链接均为官方公开渠道。点击后会复制官网地址，可在浏览器中打开办理或查询。</text>
  </view>

  <view class="section">
    <view class="section-heading">
      <text class="section-title">常用服务</text>
      <text class="section-note">复制官网地址</text>
    </view>
    <view class="service-grid">
      <view wx:for="{{services}}" wx:key="type" class="service-card" bindtap="copyLink" data-url="{{item.url}}">
        <text class="service-icon">{{item.icon}}</text>
        <text class="service-name">{{item.name}}</text>
        <text class="service-desc">{{item.description}}</text>
        <text class="service-action">复制地址</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-heading">
      <text class="section-title">官方网站</text>
      <text class="section-note">权威公开渠道</text>
    </view>
    <view class="website-list">
      <view wx:for="{{websites}}" wx:key="url" class="website-row" bindtap="copyLink" data-url="{{item.url}}">
        <view class="website-copy">
          <text class="website-name">{{item.name}}</text>
          <text class="website-desc">{{item.description}}</text>
        </view>
        <text class="copy-mark">复制</text>
      </view>
    </view>
  </view>

  <text class="footer-note">第三方官网的页面内容与服务规则以其官方发布为准。</text>
</view>
