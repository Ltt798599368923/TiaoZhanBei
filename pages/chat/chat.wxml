<view class="container">
  <scroll-view class="message-scroll" scroll-y="true" scroll-with-animation="true" scroll-into-view="{{scrollIntoView}}" style="bottom: {{inputBarHeight + keyboardHeight}}px;">
    <view wx:if="{{messages.length === 0}}" class="empty-state">
      <image class="empty-mascot" src="../../images/4b38120f3c97795437a1e773c126ed3e.jpg" mode="aspectFill" />
      <text class="empty-title">你好，我是法视界 AI 助手</text>
      <text class="empty-copy">可以帮你梳理法律问题、了解基本处理路径。涉及重大权益时，建议咨询专业律师。</text>
      <view class="quick-question-list">
        <view wx:for="{{quickQuestions}}" wx:key="*this" class="quick-question" role="button" data-question="{{item}}" bindtap="onQuickQuestion" hover-class="quick-question-active" hover-stay-time="70">
          <text>{{item}}</text>
          <text class="quick-question-arrow">›</text>
        </view>
      </view>
    </view>

    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="message-item {{item.type === 'right' ? 'message-right' : 'message-left'}}">
      <image wx:if="{{item.type === 'left'}}" class="avatar avatar-ai" src="../../images/4b38120f3c97795437a1e773c126ed3e.jpg" mode="aspectFill" />
      <view class="message-copy">
        <view class="message-bubble {{item.type === 'right' ? 'bubble-user' : 'bubble-ai'}}">
          <text class="message-text">{{item.content}}</text>
        </view>
        <text class="message-time">{{item.time}}</text>
      </view>
      <view wx:if="{{item.type === 'right'}}" class="avatar avatar-user">我</view>
    </view>

    <view wx:if="{{isLoading}}" class="message-item message-left thinking-row">
      <image class="avatar avatar-ai" src="../../images/4b38120f3c97795437a1e773c126ed3e.jpg" mode="aspectFill" />
      <view class="thinking-bubble"><text>正在整理回复</text><text class="thinking-dots">...</text></view>
    </view>
  </scroll-view>

  <view id="chat-input-bar" class="input-bar" style="bottom: {{keyboardHeight}}px;">
    <view class="input-row">
      <view class="input-shell">
        <input
          class="message-input"
          placeholder="输入法律问题"
          confirm-type="send"
          bindconfirm="sendMessage"
          bindinput="bindInput"
          bindfocus="onInputFocus"
          bindblur="onInputBlur"
          bindkeyboardheightchange="onKeyboardHeightChange"
          adjust-position="false"
          cursor-spacing="16"
          value="{{inputValue}}"
        />
        <view class="send-button {{isLoading || !inputValue ? 'is-disabled' : ''}}" role="button" aria-label="发送消息" bindtap="sendMessage" hover-class="send-button-active" hover-stay-time="70"><text class="send-icon">➤</text></view>
      </view>
    </view>
  </view>
</view>
