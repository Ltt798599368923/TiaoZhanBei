<view class="container">
  <scroll-view class="message-scroll" scroll-y="true" scroll-with-animation="true" scroll-into-view="{{scrollIntoView}}" style="bottom: {{inputBarHeight + keyboardHeight}}px;">
    <view wx:if="{{messages.length === 0}}" class="empty-state">
      <text class="empty-title">向 AI 法律助手提问</text>
      <text class="empty-copy">输入法律问题后，AI 将基于已配置的在线服务回复。回答仅供一般法律信息参考。</text>
    </view>

    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="message-item {{item.type === 'right' ? 'message-right' : 'message-left'}}">
      <view wx:if="{{item.type === 'left'}}" class="avatar avatar-ai">AI</view>
      <view class="message-copy">
        <view class="message-bubble {{item.type === 'right' ? 'bubble-user' : 'bubble-ai'}}">
          <text class="message-text">{{item.content}}</text>
        </view>
        <text class="message-time">{{item.time}}</text>
      </view>
      <view wx:if="{{item.type === 'right'}}" class="avatar avatar-user">我</view>
    </view>
  </scroll-view>

  <view id="chat-input-bar" class="input-bar" style="bottom: {{keyboardHeight}}px;">
    <view class="input-row">
      <input
        class="message-input"
        placeholder="输入法律问题"
        confirm-type="send"
        bindconfirm="sendMessage"
        bindinput="bindInput"
        bindfocus="onInputFocus"
        bindblur="onInputBlur"
        bindkeyboardheightchange="onKeyboardHeightChange"
        adjust-position="false"
        cursor-spacing="16"
        value="{{inputValue}}"
      />
      <button class="send-button" loading="{{isLoading}}" disabled="{{isLoading || !inputValue}}" bindtap="sendMessage">发送</button>
    </view>
  </view>
</view>
