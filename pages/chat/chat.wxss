.container { position: relative; min-height: 100vh; overflow: hidden; background: #f4f5f7; }
.message-scroll { position: absolute; top: 0; right: 0; left: 0; padding: 24rpx; box-sizing: border-box; }

.empty-state { margin-top: 8rpx; padding: 44rpx 32rpx; background: #ffffff; border: 1rpx solid #e1e4e8; border-left: 8rpx solid #bd1d17; border-radius: 8rpx; }
.empty-title, .empty-copy, .message-text, .message-time { display: block; }
.empty-title { color: #30343a; font-size: 30rpx; font-weight: 600; }
.empty-copy { margin-top: 14rpx; color: #747b85; font-size: 26rpx; line-height: 1.7; }

.message-item { display: flex; align-items: flex-start; margin-bottom: 24rpx; }
.message-right { justify-content: flex-end; }
.avatar { display: flex; flex: 0 0 72rpx; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; border-radius: 50%; font-size: 24rpx; font-weight: 700; }
.avatar-ai { margin-right: 16rpx; color: #a61d18; background: #fff1f0; border: 1rpx solid #efc5c0; }
.avatar-user { margin-left: 16rpx; color: #ffffff; background: #535a63; }
.message-copy { max-width: 72%; min-width: 0; }
.message-bubble { padding: 18rpx 20rpx; border: 1rpx solid #e1e4e8; border-radius: 8rpx; }
.bubble-ai { color: #30343a; background: #ffffff; }
.bubble-user { color: #ffffff; background: #bd1d17; border-color: #bd1d17; }
.message-text { color: inherit; font-size: 28rpx; line-height: 1.65; white-space: pre-wrap; word-break: break-all; }
.message-time { margin: 8rpx 6rpx 0; color: #9298a1; font-size: 22rpx; }
.message-right .message-time { text-align: right; }

.input-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 1000; padding: 18rpx 20rpx calc(18rpx + env(safe-area-inset-bottom)); background: #ffffff; border-top: 1rpx solid #e1e4e8; box-sizing: border-box; }
.input-row { display: flex; align-items: center; }
.message-input { flex: 1; min-width: 0; height: 70rpx; padding: 0 18rpx; color: #30343a; background: #f6f7f8; border: 1rpx solid #e1e4e8; border-radius: 6rpx; font-size: 27rpx; box-sizing: border-box; }
.send-button { flex: 0 0 auto; width: 112rpx; height: 70rpx; margin-left: 14rpx; color: #ffffff; background: #bd1d17; border: 0; border-radius: 6rpx; font-size: 27rpx; font-weight: 600; line-height: 70rpx; }
.send-button::after { border: 0; }
.send-button[disabled] { color: rgba(255, 255, 255, 0.8); background: #c9827e; }
