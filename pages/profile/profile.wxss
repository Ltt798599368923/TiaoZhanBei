.page{min-height:100vh;padding:24rpx;background:#f4f5f7;box-sizing:border-box}.profile-head{padding:38rpx 28rpx;background:#fff;border-left:8rpx solid #bd1d17;border-radius:8rpx}.avatar{width:104rpx;height:104rpx;border-radius:50%;background:#fff1f0}.avatar-fallback{display:flex;align-items:center;justify-content:center;color:#a61d18;font-size:38rpx}.name,.status,.summary-label,.summary-value{display:block}.name{margin-top:18rpx;color:#202124;font-size:38rpx;font-weight:700}.status{margin-top:8rpx;color:#737981;font-size:24rpx}.summary,.menu{margin-top:22rpx;border:1rpx solid #e1e4e8;border-radius:8rpx;background:#fff}.summary{display:flex;gap:24rpx;padding:24rpx}.summary>view{flex:1;min-width:0}.summary-label{color:#858b93;font-size:23rpx}.summary-value{margin-top:10rpx;overflow:hidden;color:#30343a;font-size:27rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}.accent{color:#a61d18}.menu-row{display:flex;align-items:center;justify-content:space-between;height:96rpx;padding:0 24rpx;border-bottom:1rpx solid #eceef0;color:#30343a;font-size:28rpx}.menu-row:last-child{border:0}.menu-row text:last-child{color:#969ca4}.logout{width:100%;height:76rpx;margin-top:28rpx;color:#bd1d17;background:#fff;border:1rpx solid #d99790;border-radius:6rpx;font-size:27rpx;line-height:76rpx}
