.page { min-height: 100vh; padding: 24rpx 24rpx 48rpx; background: #f2f4f6; box-sizing: border-box; }
.profile-stage { padding: 28rpx; color: #ffffff; background: #272b31; border-bottom: 5rpx solid #bd1d17; border-radius: 8rpx; }
.stage-kicker { display: block; color: #e8b8b2; font-size: 20rpx; font-weight: 600; letter-spacing: 3rpx; }
.identity-row { display: flex; align-items: center; margin-top: 22rpx; }
.avatar { flex: 0 0 98rpx; width: 98rpx; height: 98rpx; border: 3rpx solid rgba(255, 255, 255, 0.28); border-radius: 50%; background: #fff1f0; }
.avatar-fallback { display: flex; align-items: center; justify-content: center; color: #a61d18; font-size: 38rpx; }
.identity-copy { min-width: 0; margin-left: 20rpx; }.name, .status, .strip-label, .strip-value, .menu-title, .menu-copy { display: block; }
.name { overflow: hidden; color: #ffffff; font-size: 37rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.status { margin-top: 9rpx; color: #c7cbd0; font-size: 24rpx; }

.service-strip { display: flex; align-items: stretch; margin: 18rpx 0 30rpx; padding: 22rpx 20rpx; background: #ffffff; border: 1rpx solid #e1e4e8; border-radius: 8rpx; }
.service-item { flex: 1; min-width: 0; }.strip-rule { width: 1rpx; margin: 0 18rpx; background: #e9ecef; }
.strip-label { color: #858b93; font-size: 22rpx; }.strip-value { margin-top: 10rpx; overflow: hidden; color: #30343a; font-size: 27rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.hotline { color: #a61d18; }

.menu-heading { padding: 0 4rpx 14rpx; color: #30343a; font-size: 29rpx; font-weight: 700; }
.menu { overflow: hidden; background: #ffffff; border: 1rpx solid #e1e4e8; border-radius: 8rpx; }
.menu-row { display: flex; align-items: center; justify-content: space-between; min-height: 106rpx; padding: 18rpx 22rpx; border-bottom: 1rpx solid #eceef0; box-sizing: border-box; }.menu-row:last-child { border-bottom: 0; }.menu-row:active { background: #fafafa; }
.menu-title { color: #30343a; font-size: 28rpx; font-weight: 600; }.menu-copy { margin-top: 6rpx; color: #858b93; font-size: 22rpx; }.menu-arrow { color: #a61d18; font-size: 40rpx; font-weight: 300; }
.logout { display: flex; width: 100%; height: 78rpx; align-items: center; justify-content: center; margin-top: 28rpx; padding: 0; color: #a61d18; background: transparent; border: 1rpx solid #d99790; border-radius: 5rpx; font-size: 27rpx; font-weight: 600; line-height: 1; text-align: center; box-sizing: border-box; }.logout::after { border: 0; }
