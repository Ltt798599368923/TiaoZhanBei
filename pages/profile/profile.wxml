<!-- 个人中心页面结构 -->
<view class="container">
<!-- 顶部用户信息区域 -->
  <view style="background-color: #fff1f0; width: 100%; padding: 32rpx 20px; text-align: center; color: #333; border-bottom: 1rpx solid #ffd6d2;">
    <view style="width: 80px; height: 80px; border-radius: 50%; border: 3px solid #c0190e; margin: 0 auto 10px; background-color: white; display: flex; align-items: center; justify-content: center; overflow: hidden;">
      <image wx:if="{{userInfo.avatar}}" src="{{userInfo.avatar}}" mode="aspectFill" style="width: 100%; height: 100%;" />
      <text wx:else style="font-size: 40px;">👤</text>
    </view>
    <text style="font-size: 18px; font-weight: bold; margin-bottom: 5px; display: block;">{{userInfo.nickname || '用户'}}</text>
    <text style="font-size: 14px; color: #8c6d6a;">普通用户</text>
  </view>

  <!-- 个人信息列表区域 -->
  <view style="width: 90%; margin-top: -20px; background-color: white; border-radius: 10px; padding: 15px; margin-bottom: 15px;">
    <view style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #f0f0f0;">
      <text style="font-size: 14px;">手机号码</text>
      <text style="font-size: 14px; color: #999999;">{{userInfo.phone || '未绑定'}}</text>
    </view>
    <view style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #f0f0f0;">
      <text style="font-size: 14px;">账号状态</text>
      <text style="font-size: 14px; color: #52c41a;">已登录</text>
    </view>
    <view style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0;">
      <text style="font-size: 14px;">法律服务热线</text>
      <text style="font-size: 14px; color: #999999;">12348</text>
    </view>
  </view>

  <!-- 操作按钮区域 -->
  <view style="width: 90%; background-color: white; border-radius: 10px; padding: 15px; margin-bottom: 15px;">
    <view bindtap="goToSettings" style="padding: 10px 0; border-bottom: 1px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center;">
      <text style="font-size: 14px;">个人设置</text>
      <text style="font-size: 14px; color: #999;">→</text>
    </view>
    <view bindtap="goToFavorites" style="padding: 10px 0; border-bottom: 1px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center;">
      <text style="font-size: 14px;">我的收藏</text>
      <text style="font-size: 14px; color: #999;">→</text>
    </view>
    <view bindtap="goToMyConsult" style="padding: 10px 0; border-bottom: 1px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center;">
      <text style="font-size: 14px;">我的咨询</text>
      <text style="font-size: 14px; color: #999;">→</text>
    </view>

    <view bindtap="goToAbout" style="padding: 10px 0; border-bottom: 1px solid #f0f0f0; display: flex; justify-content: space-between; align-items: center;">
      <text style="font-size: 14px;">关于我们</text>
      <text style="font-size: 14px; color: #999;">→</text>
    </view>
    <view bindtap="logout" style="padding: 10px 0; display: flex; justify-content: space-between; align-items: center;">
      <text style="font-size: 14px; color: #f5222d;">退出登录</text>
    </view>
  </view>
</view>
