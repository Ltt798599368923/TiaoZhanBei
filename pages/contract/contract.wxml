<view class="page"><view class="lead"><text class="kicker">合同风险审查</text><text class="title">提交合同审核</text><text class="copy">上传合同后由平台审核，处理结果会同步到合同记录和消息中心。</text></view><view class="section"><text class="section-title">合同类型</text><view class="type-grid"><view wx:for="{{contractTypes}}" wx:key="type" class="type {{selectedType === item.type ? 'selected' : ''}}" bindtap="selectContractType" data-type="{{item.type}}"><text class="type-name">{{item.name}}</text><text class="type-desc">{{item.description}}</text></view></view></view><view class="section form"><text class="section-title">合同信息</text><input value="{{title}}" bindinput="onTitleInput" placeholder="填写合同标题" class="input"/><view class="upload" bindtap="uploadContract"><text class="upload-title">{{fileName || '选择合同文件或拍照上传'}}</text><text class="upload-copy">支持 PDF、DOC、DOCX、TXT、JPG、PNG</text></view><button class="primary" bindtap="submitReview" loading="{{submitting}}" disabled="{{submitting}}">提交审核</button></view><view class="section records"><view class="records-head"><text class="section-title">合同记录</text><text>{{contracts.length}} 条</text></view><view wx:if="{{loadingContracts}}" class="state">加载中...</view><view wx:elif="{{contracts.length === 0}}" class="state">暂无合同记录</view><view wx:else><view wx:for="{{contracts}}" wx:key="id" class="record"><view class="record-main" bindtap="viewContract" data-id="{{item.id}}"><text class="record-title">{{item.title}}</text><text class="record-meta">{{item.fileName || '未命名文件'}} · {{item.time}}</text></view><view class="record-side"><text class="status {{item.status}}">{{item.status === 'pending' ? '待审核' : item.status === 'processing' ? '审核中' : item.status === 'rejected' ? '需补充' : '已处理'}}</text><text class="delete" bindtap="deleteContract" data-id="{{item.id}}">删除</text></view></view></view></view></view>
