<!--contract.wxml-->
<view class="container">
  <!-- 顶部标题 -->
  <view style="background-color: #f5222d; width: 100%; padding: 15px; display: flex; align-items: center; color: white; font-size: 18px; font-weight: bold;">
    <view bindtap="goBack" style="margin-right: 15px; font-size: 20px;">←</view>
    <text>合同审查服务</text>
  </view>

  <!-- 服务介绍 -->
  <view style="padding: 20px; background-color: white; margin: 10px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <view style="text-align: center; margin-bottom: 20px;">
      <view style="font-size: 48px; margin-bottom: 15px;">🔍</view>
      <text style="font-size: 20px; font-weight: bold; color: #333;">专业合同审查服务</text>
    </view>
    <view style="font-size: 14px; line-height: 1.6; color: #666; margin-bottom: 20px;">
      <text>我们提供专业的合同审查服务，由经验丰富的律师为您审查各类合同，识别潜在法律风险，确保您的权益得到充分保障。</text>
    </view>
  </view>

  <!-- 审查流程 -->
  <view style="padding: 20px; background-color: white; margin: 10px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <text style="font-size: 16px; font-weight: bold; margin-bottom: 15px; display: block;">审查流程</text>
    <view style="display: flex; justify-content: space-around; text-align: center;">
      <view style="flex: 1;">
        <view style="width: 40px; height: 40px; background-color: #f5222d; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;">
          <text style="font-size: 16px; font-weight: bold;">1</text>
        </view>
        <text style="font-size: 12px; color: #666;">上传合同</text>
      </view>
      <view style="flex: 1;">
        <view style="width: 40px; height: 40px; background-color: #f5222d; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;">
          <text style="font-size: 16px; font-weight: bold;">2</text>
        </view>
        <text style="font-size: 12px; color: #666;">律师审查</text>
      </view>
      <view style="flex: 1;">
        <view style="width: 40px; height: 40px; background-color: #f5222d; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;">
          <text style="font-size: 16px; font-weight: bold;">3</text>
        </view>
        <text style="font-size: 12px; color: #666;">出具报告</text>
      </view>
      <view style="flex: 1;">
        <view style="width: 40px; height: 40px; background-color: #f5222d; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px;">
          <text style="font-size: 16px; font-weight: bold;">4</text>
        </view>
        <text style="font-size: 12px; color: #666;">修改建议</text>
      </view>
    </view>
  </view>

  <!-- 合同类型 -->
  <view style="padding: 20px; background-color: white; margin: 10px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <text style="font-size: 16px; font-weight: bold; margin-bottom: 15px; display: block;">合同类型</text>

    <view bindtap="selectContractType" data-type="employment" style="display: flex; align-items: center; padding: 15px; border-bottom: 1px solid #f0f0f0;">
      <view style="width: 50px; height: 50px; background-color: #f5f5f5; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
        <text style="font-size: 24px;">👔</text>
      </view>
      <view style="flex: 1;">
        <text style="font-size: 16px; font-weight: 500; margin-bottom: 5px; display: block;">劳动合同</text>
        <text style="font-size: 12px; color: #666;">employment contracts</text>
      </view>
      <text style="font-size: 16px; color: #999;">→</text>
    </view>

    <view bindtap="selectContractType" data-type="business" style="display: flex; align-items: center; padding: 15px; border-bottom: 1px solid #f0f0f0;">
      <view style="width: 50px; height: 50px; background-color: #f5f5f5; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
        <text style="font-size: 24px;">💼</text>
      </view>
      <view style="flex: 1;">
        <text style="font-size: 16px; font-weight: 500; margin-bottom: 5px; display: block;">商务合同</text>
        <text style="font-size: 12px; color: #666;">business contracts</text>
      </view>
      <text style="font-size: 16px; color: #999;">→</text>
    </view>

    <view bindtap="selectContractType" data-type="realestate" style="display: flex; align-items: center; padding: 15px; border-bottom: 1px solid #f0f0f0;">
      <view style="width: 50px; height: 50px; background-color: #f5f5f5; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
        <text style="font-size: 24px;">🏠</text>
      </view>
      <view style="flex: 1;">
        <text style="font-size: 16px; font-weight: 500; margin-bottom: 5px; display: block;">房地产合同</text>
        <text style="font-size: 12px; color: #666;">real estate contracts</text>
      </view>
      <text style="font-size: 16px; color: #999;">→</text>
    </view>
  </view>

  <!-- 上传合同 -->
  <view style="padding: 20px; background-color: white; margin: 10px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <text style="font-size: 16px; font-weight: bold; margin-bottom: 15px; display: block;">上传合同</text>
    <view bindtap="uploadContract" style="width: 100%; height: 200px; border: 2px dashed #e8e8e8; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 20px;">
      <view style="font-size: 48px; margin-bottom: 10px;">📁</view>
      <text style="font-size: 14px; color: #999; margin-bottom: 5px;">点击上传合同文件</text>
      <text style="font-size: 12px; color: #999;">支持 PDF、Word 等格式</text>
    </view>
    <view style="margin-bottom: 15px;">
      <text style="font-size: 14px; color: #666; margin-bottom: 5px; display: block;">合同描述</text>
      <textarea placeholder="请简要描述合同内容和您的关注点..." style="width: 100%; height: 100px; border: 1px solid #e8e8e8; border-radius: 8px; padding: 10px; font-size: 14px;"></textarea>
    </view>
    <view style="margin-bottom: 15px;">
      <text style="font-size: 14px; color: #666; margin-bottom: 5px; display: block;">联系方式</text>
      <input placeholder="请留下您的手机号" style="width: 100%; height: 40px; border: 1px solid #e8e8e8; border-radius: 8px; padding: 0 10px; font-size: 14px;"></input>
    </view>
    <button bindtap="submitReview" style="background-color: #f5222d; color: white; border: none; padding: 10px; border-radius: 8px; font-size: 16px; width: 100%;">提交审查</button>
  </view>
</view>