.page{min-height:100vh;padding:24rpx;background:#f4f5f7;box-sizing:border-box}.lead,.section{background:#fff;border:1rpx solid #e1e4e8;border-radius:8rpx}.lead{padding:32rpx;border-left:8rpx solid #bd1d17}.kicker,.title,.copy,.section-title,.type-name,.type-desc,.upload-title,.upload-copy,.record-title,.record-meta{display:block}.kicker{color:#a61d18;font-size:22rpx;font-weight:600}.title{margin-top:10rpx;color:#202124;font-size:38rpx;font-weight:700}.copy{margin-top:14rpx;color:#6b7078;font-size:26rpx;line-height:1.7}.section{margin-top:22rpx;padding:26rpx}.section-title{color:#30343a;font-size:30rpx;font-weight:700}.type-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:18rpx}.type{min-height:116rpx;padding:16rpx;border:1rpx solid #e1e4e8;border-radius:6rpx;background:#fff;box-sizing:border-box}.type.selected{border-color:#bd1d17;background:#fff7f6}.type-name{color:#30343a;font-size:26rpx;font-weight:700}.selected .type-name{color:#a61d18}.type-desc{margin-top:8rpx;color:#858b93;font-size:20rpx;line-height:1.35}.input{height:78rpx;margin-top:18rpx;padding:0 18rpx;border:1rpx solid #dfe2e6;border-radius:6rpx;box-sizing:border-box;font-size:27rpx}.upload{margin-top:16rpx;padding:28rpx 20rpx;border:2rpx dashed #c9cdd2;border-radius:6rpx}.upload-title{color:#30343a;font-size:27rpx;font-weight:600}.upload-copy{margin-top:10rpx;color:#858b93;font-size:22rpx}.primary{height:74rpx;margin-top:20rpx;color:#fff;background:#bd1d17;border-radius:6rpx;font-size:27rpx;line-height:74rpx}.primary::after{border:0}.records-head,.record{display:flex;align-items:center;justify-content:space-between}.records-head>text:last-child{color:#858b93;font-size:23rpx}.state{padding:50rpx 0;color:#858b93;font-size:26rpx;text-align:center}.record{gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #eceef0}.record:last-child{border:0}.record-main{min-width:0;flex:1}.record-title{overflow:hidden;color:#30343a;font-size:27rpx;font-weight:700;text-overflow:ellipsis;white-space