<!-- 法律助手小程序首页 -->
<view class="container">

  <!-- 顶部位置栏 -->
  <view class="loc-bar">
    <view class="loc-left">
      <image class="loc-icon" src="/images/location.png" mode="aspectFit" />
      <text class="loc-text">河南省郑州市</text>
    </view>
    <view class="loc-right">
      <text class="loc-more">···</text>
      <image class="loc-scan" src="/images/scan.png" mode="aspectFit" />
    </view>
  </view>

  <!-- Hero 轮播区 -->
  <swiper class="hero-swiper" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#ffffff" autoplay="{{true}}" interval="{{3000}}" circular="{{true}}">
    <swiper-item>
      <view class="hero-slide">
        <view class="book">
          <text class="book-title">中华人民共和国{"\n"}刑法</text>
        </view>
      </view>
    </swiper-item>
    <swiper-item>
      <view class="hero-slide">
        <view class="book">
          <text class="book-title">中华人民共和国{"\n"}民法典</text>
        </view>
      </view>
    </swiper-item>
    <swiper-item>
      <view class="hero-slide">
        <view class="book">
          <text class="book-title">中华人民共和国{"\n"}宪法</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 跑马灯公告 -->
  <view class="ticker-wrap">
    <image class="ticker-icon" src="/images/speaker.png" mode="aspectFit" />
    <scroll-view class="ticker-scroll" scroll-x="{{false}}" enable-flex="{{true}}">
      <text class="ticker-text">弘扬法治精神，提供法律支援。免费法律咨询、法律知识学习、文书指导</text>
    </scroll-view>
  </view>

  <!-- 主功能卡片 -->
  <view class="main-card">

    <!-- 快捷入口 -->
    <view class="quick-row">
      <view class="quick-btn" bindtap="goConsult">
        <image class="q-icon" src="/images/chat.png" mode="aspectFit" />
        <view class="q-text">
          <text class="q-title">在线咨询</text>
          <text class="q-sub">专业律师在线解答</text>
        </view>
      </view>
      <view class="quick-btn" bindtap="goSearch">
        <image class="q-icon" src="/images/search.png" mode="aspectFit" />
        <view class="q-text">
          <text class="q-title">法条检索</text>
          <text class="q-sub">发条信息速查直达</text>
        </view>
      </view>
    </view>

    <!-- 六宫格功能图标 -->
    <view class="icon-grid">
      <view class="icon-item" wx:for="{{gridItems}}" wx:key="id" bindtap="onGridTap" data-id="{{item.id}}">
        <view class="icon-box">
          <image class="icon-img" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <text class="icon-label">{{item.label}}</text>
      </view>
    </view>

  </view>

  <!-- 热点咨询 -->
  <view class="section hot-section">
    <text class="section-title">热点咨询</text>
    <view class="hot-list">
      <view class="hot-item" wx:for="{{hotItems}}" wx:key="id" bindtap="onHotTap" data-id="{{item.id}}">
        <text class="hot-text">{{item.title}}</text>
        <image class="hot-arrow" src="/images/arrow.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer">
    <text class="disc-title">免责声明</text>
    <text class="disc-text">本平台所有内容仅供学习与参考，不构成正式法律意见。</text>
  </view>

</view>
