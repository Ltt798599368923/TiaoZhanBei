/* app.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 通用样式 */
.red-btn {
  background-color: #f5222d;
  color: white;
  border-radius: 20px;
  padding: 10px 20px;
  text-align: center;
  font-size: 16px;
  margin: 10px 0;
}

.red-border {
  border: 1px solid #f5222d;
  color: #f5222d;
  border-radius: 20px;
  padding: 10px 20px;
  text-align: center;
  font-size: 16px;
  margin: 10px 0;
}

/* 聊天样式 */
.chat-container {
  flex: 1;
  padding: 10px;
  overflow-y: auto;
}

.chat-message {
  margin: 10px 0;
  display: flex;
  align-items: flex-start;
}

.chat-message.left {
  justify-content: flex-start;
}

.chat-message.right {
  justify-content: flex-end;
}

.chat-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  margin: 0 10px;
}

.chat-bubble {
  max-width: 70%;
  padding: 10px;
  border-radius: 10px;
  font-size: 14px;
}

.chat-bubble.left {
  background-color: #ffffff;
  border-top-left-radius: 0;
}

.chat-bubble.right {
  background-color: #e6f7ff;
  border-top-right-radius: 0;
}

.chat-input {
  display: flex;
  align-items: center;
  padding: 10px;
  background-color: #ffffff;
  border-top: 1px solid #e8e8e8;
}

.chat-input input {
  flex: 1;
  height: 40px;
  border: 1px solid #e8e8e8;
  border-radius: 20px;
  padding: 0 15px;
  margin-right: 10px;
}

.chat-input button {
  width: 60px;
  height: 40px;
  background-color: #f5222d;
  color: white;
  border: none;
  border-radius: 20px;
  font-size: 14px;
}

/* 底部导航栏 */
.tab-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 50px;
  background-color: #ffffff;
  border-top: 1px solid #e8e8e8;
}

.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.tab-bar-item image {
  width: 24px;
  height: 24px;
  margin-bottom: 2px;
}

.tab-bar-item text {
  font-size: 12px;
  color: #666666;
}

.tab-bar-item.active text {
  color: #f5222d;
}