/* app.wxss */
.container {
  min-height: 100vh;
  box-sizing: border-box;
}

/* 通用样式 */
.red-btn {
  background-color: #A91c22;
  color: white;
  border-radius: 20px;
  padding: 10px 20px;
  text-align: center;
  font-size: 16px;
  margin: 10px 0;
}

.red-border {
  border: 1px solid #A91c22;
  color: #f5222d;
  border-radius: 20px;
  padding: 10px 20px;
  text-align: center;
  font-size: 16px;
  margin: 10px 0;
}

/* 聊天样式 */
.chat-container {
  flex: 1;
  padding: 10px;
  overflow-y: auto;
}

.chat-message {
  margin: 10px 0;
  display: flex;
  align-items: flex-start;
}

.chat-message.left {
  justify-content: flex-start;
}

.chat-message.right {
  justify-content: flex-end;
}

.chat-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  margin: 0 10px;
}

.chat-bubble {
  max-width: 70%;
  padding: 10px;
  border-radius: 10px;
  font-size: 14px;
}

.chat-bubble.left {
  background-color: #ffffff;
  border-top-left-radius: 0;
}

.chat-bubble.right {
  background-color: #e6f7ff;
  border-top-right-radius: 0;
}

.chat-input {
  display: flex;
  align-items: center;
  padding: 10px;
  background-color: #ffffff;
  border-top: 1px solid #e8e8e8;
}

.chat-input input {
  flex: 1;
  height: 40px;
  border: 1px solid #e8e8e8;
  border-radius: 20px;
  padding: 0 15px;
  margin-right: 10px;
}

.chat-input button {
  width: 60px;
  height: 40px;
  background-color: #A91c22;
  color: white;
  border: none;
  border-radius: 20px;
  font-size: 14px;
}

/* 底部导航栏 */
.tab-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 50px;
  background-color: #ffffff;
  border-top: 1px solid #e8e8e8;
}

.tab-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.tab-bar-item image {
  width: 24px;
  height: 24px;
  margin-bottom: 2px;
}

.tab-bar-item text {
  font-size: 12px;
  color: #666666;
}

.tab-bar-item.active text {
  color: #f5222d;
}
/* 自定义导航栏：和你要的顶部渐变效果完全一致 */
.custom-nav {
  width: 100%;
  height: 88rpx; /* 导航栏高度 */
  padding-top: var(--status-bar-height); /* 适配手机状态栏高度 */
  background: linear-gradient(180deg, #A91C22 0%, #C5222A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.nav-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: bold;
}

/* 页面内容往下移，避免被导航栏挡住 */
.page-content {
  margin-top: 88rpx;
}

.empty-state {
  padding: 96rpx 32rpx;
  color: #8c8c8c;
  font-size: 28rpx;
  line-height: 1.6;
  text-align: center;
}
